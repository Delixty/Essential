    local keyBtn = Instance.new("TextButton", frame) keyBtn.Size = UDim2.new(0, 118, 0, 26) keyBtn.Position = UDim2.new(1, -130, 0.5, -13) keyBtn.BackgroundColor3 = BgDark keyBtn.Text = tostring(defaultKey) keyBtn.TextSize = 12 keyBtn.Font = Enum.Font.GothamBold Instance.new("UICorner", keyBtn).CornerRadius = UDim.new(0, 6)
    table.insert(ThemeElements.Texts, keyBtn)
    local keyStroke = Instance.new("UIStroke", keyBtn) keyStroke.Thickness = 1 table.insert(ThemeElements.DarkStrokes, keyStroke)
    UI_Elements._Search.Register(parent, frame, text)

    local listening = false
    local function setKey(keyName)
        keyName = tostring(keyName or "None")
        keyBtn.Text = keyName
        callback(keyName)
    end
    keyBtn.MouseButton1Click:Connect(function()
        if listening then return end
        listening = true
        KeybindListening = true
        keyBtn.Text = "..."
    end)
    table.insert(connections, UserInputService.InputBegan:Connect(function(input)
        if not listening then return end
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        local kc = input.KeyCode
        listening = false
        task.defer(function() KeybindListening = false end)
        if kc == Enum.KeyCode.Escape then
            setKey(Settings.MenuKeybind)
        elseif kc == Enum.KeyCode.Backspace or kc == Enum.KeyCode.Delete then
            setKey("None")
        elseif kc ~= Enum.KeyCode.Unknown then
            setKey(kc.Name)
        else
            setKey(Settings.MenuKeybind)
        end
    end))
    return setKey
end

