local function GetActiveThemeColors(themeName)
    local resolvedName = GetThemeName(themeName)
    local preset = Themes[resolvedName]
    local baseAccent = preset.Accent
    local gradEnd = preset.AccentEnd
    local strokeMain = preset.StrokeMain
    local strokeDark = preset.StrokeDark

    if resolvedName == "Essential" then
        baseAccent = Color3.fromRGB(Settings.AccentR, Settings.AccentG, Settings.AccentB)
        gradEnd = baseAccent:Lerp(Color3.new(1, 1, 1), 0.08)
        strokeMain = baseAccent
        strokeDark = baseAccent:Lerp(preset.BgDark, 0.68)
    end

    return resolvedName, preset, baseAccent, gradEnd, strokeMain, strokeDark
end

-- Рисует снежинку из трёх перекрещённых полосок (не зависит от глифов шрифта, вместо "❄")
local function CreateSnowflakeVisual(parent, sizePx, color, transparency, rotation)
    local holder = Instance.new("Frame", parent)
    holder.Name = "SnowflakeVisual"
    holder.AnchorPoint = Vector2.new(0.5, 0.5)
    holder.Size = UDim2.fromOffset(sizePx, sizePx)
    holder.BackgroundTransparency = 1
    holder.Rotation = rotation or 0
    holder.Active = false
    pcall(function() holder.Interactable = false end)
    local barThick = math.max(1, math.floor(sizePx / 7))
    for angle = 0, 120, 60 do
        local bar = Instance.new("Frame", holder)
        bar.Name = "SnowArm"
        bar.AnchorPoint = Vector2.new(0.5, 0.5)
        bar.Position = UDim2.new(0.5, 0, 0.5, 0)
        bar.Size = UDim2.new(0, sizePx, 0, barThick)
        bar.Rotation = angle
        bar.BackgroundColor3 = color
        bar.BackgroundTransparency = transparency or 0
        bar.BorderSizePixel = 0
        bar.Active = false
        pcall(function() bar.Interactable = false end)
        Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)
    end
    return holder
end

