local function ResolveSearchContext(parentObj)
    local current = parentObj
    local foundSection = nil
    local foundTab = nil

    while current and current ~= game do
        if current.Name == "ConfigPage" or current.Name == "SettingsPage" or current.Name == "GlobalSearchResults" then
            return nil, nil
        end
        if not foundSection and SectionRegistry[current] then
            foundSection = SectionRegistry[current]
        end
        if not foundTab then
            for _, t in ipairs(tabs) do
                if t.page == current then
                    foundTab = t
                    break
                end
            end
        end
        current = current.Parent
    end

    if not foundTab or foundTab.name == "Config" then
        return nil, nil
    end
    return foundTab, foundSection
end

local function NavigateToSearchItem(item)
    if not item or not item.tab or not item.frame then return end

    SearchResultsFrame.Visible = false
    NoResultsLabel.Visible = false
    if SearchInput.Text ~= "" then
        SearchInput.Text = ""
    end

    ActivateTab(item.tab)

    if item.section and item.section.setOpen then
        item.section.setOpen(true, true)
    end

    task.defer(function()
        local page = item.tab.page
        local targetFrame = (item.section and not item.isSection) and item.frame or (item.section and item.section.mainFrame or item.frame)
        if not page or not targetFrame or not targetFrame.Parent then return end

        page.CanvasPosition = Vector2.new(0, 0)
        RunService.Heartbeat:Wait()

        local relativeY = math.max(0, (targetFrame.AbsolutePosition.Y - page.AbsolutePosition.Y) - 12)
        local maxScroll = math.max(0, page.AbsoluteCanvasSize.Y - page.AbsoluteWindowSize.Y)
        TweenService:Create(page, TweenInfo.new(0.3, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {
            CanvasPosition = Vector2.new(0, math.clamp(relativeY, 0, maxScroll))
        }):Play()
    end)
end

