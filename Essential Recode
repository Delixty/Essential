            snow.Position = UDim2.new(1, -24, 0.5, -9)
            snow.ZIndex = 3
            extraIcon = snow
        end

        buttons[opt.id] = {
            btn = btn,
            stroke = bStroke,
            activeBg = activeBg,
            lbl = lbl,
            extra = extraIcon
        }
    end

    local function updateThemeButtons(selectedId, baseCol, strokeMainCol, strokeDarkCol, instant)
        currentTheme = GetThemeName(selectedId)
        local _, _, activeBase, _, sMain, sDark = GetActiveThemeColors(currentTheme)
        baseCol = baseCol or activeBase
        strokeMainCol = strokeMainCol or sMain
        strokeDarkCol = strokeDarkCol or sDark
        local tw = TweenInfo.new(instant and 0 or 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

        for id, data in pairs(buttons) do
            local isSelected = (id == currentTheme)
            local targetStrokeCol = isSelected and strokeMainCol or strokeDarkCol
            local targetStrokeThick = isSelected and 1.6 or 1.0
            local targetBgTrans = isSelected and 0.12 or 1.0
            local targetTextCol = isSelected and Color3.fromRGB(255, 255, 255) or TextMuted

            if instant then
                data.btn.BackgroundColor3 = BgDark
                data.stroke.Color = targetStrokeCol
                data.stroke.Thickness = targetStrokeThick
                data.activeBg.BackgroundTransparency = targetBgTrans
                data.lbl.TextColor3 = targetTextCol
            else
                TweenService:Create(data.btn, tw, { BackgroundColor3 = BgDark }):Play()
                TweenService:Create(data.stroke, tw, { Color = targetStrokeCol, Thickness = targetStrokeThick }):Play()
                TweenService:Create(data.activeBg, tw, { BackgroundTransparency = targetBgTrans }):Play()
                TweenService:Create(data.lbl, tw, { TextColor3 = targetTextCol }):Play()
            end

            if id == "Winter" and data.extra then
                local snowCol = isSelected and Color3.fromRGB(240, 252, 255) or Color3.fromRGB(130, 195, 245)
                local snowTrans = isSelected and 0 or 1
                for _, arm in ipairs(data.extra:GetChildren()) do
                    if arm.Name == "SnowArm" then
                        if instant then
                            arm.BackgroundColor3 = snowCol
                            arm.BackgroundTransparency = snowTrans
                        else
                            TweenService:Create(arm, tw, { BackgroundColor3 = snowCol, BackgroundTransparency = snowTrans }):Play()
                        end
                    end
                end
            end
        end
    end

    UI_Elements.RefreshThemeSelectorVisuals = updateThemeButtons

    local function selectTheme(themeId, silent)
        themeId = GetThemeName(themeId)
        currentTheme = themeId
        Settings.ThemeType = themeId
        if not silent then
            callback(themeId)
        else
            updateThemeButtons(themeId, nil, nil, nil, true)
        end
    end

    for id, data in pairs(buttons) do
        data.btn.MouseButton1Click:Connect(function()
            if currentTheme ~= id then
                selectTheme(id, false)
            end
        end)
    end

    UI_Elements._Search.Register(parent, container, "Theme Type")
    updateThemeButtons(currentTheme, nil, nil, nil, true)
    return selectTheme
end

