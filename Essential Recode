    UI_Elements._RequestJump=function()
        if M.closed or not Settings.Jumphack or KeybindListening or UserInputService:GetFocusedTextBox() then return end
        BindMovement() ObserveSpeed()
        local h=M.hum
        if Locked() or not h or not M.base or M.base<=6 or os.clock()-M.lastJump<0.35 then return end
        local justNative=h:GetState()==Enum.HumanoidStateType.Jumping and os.clock()-M.lastGround<0.12
        if (h.FloorMaterial==Enum.Material.Air and not justNative) or h:GetState()==Enum.HumanoidStateType.Freefall then return end
        if IsCharacterInSpecialAction(M.char,h,M.root,EmoteState.activeTrack,true) then return end
        if not h:GetStateEnabled(Enum.HumanoidStateType.Jumping) then
            if not M.warned then warn("[Essential Jump] Jumping is disabled by the game; no forced impulse was applied.") M.warned=true end
            return
        end
        RestoreJump()
        local key=h.UseJumpPower and "JumpPower" or "JumpHeight"
        local power=math.min(math.clamp(tonumber(Settings.JumpPower) or 50,30,150),M.jumpCap or 150)
        M.jumpPower=power
        local value=h.UseJumpPower and power or power*power/(2*math.max(workspace.Gravity,1))
        M.jump={h=h,key=key,base=h[key],applied=value}
        h[key]=value M.lastJump=os.clock() M.jumpAt=M.lastJump h.Jump=true
    end
    UI_Elements._ResetJumpCap=function() M.jumpCap=nil end
    UI_Elements._CleanupMovement=function()
