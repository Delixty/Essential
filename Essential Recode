UI_Elements._InitBackground = function()
    local backdrop=Instance.new("Frame",MainClip)
    backdrop.Name="BackgroundSurface" backdrop.Size=UDim2.fromScale(1,1) backdrop.BackgroundTransparency=1 backdrop.ZIndex=0
    local matte=Instance.new("Frame",backdrop) matte.Size=UDim2.fromScale(1,1) matte.BackgroundColor3=Color3.new(1,1,1) matte.BorderSizePixel=0 matte.ZIndex=0
    local layer=Instance.new("ImageLabel",backdrop) layer.Name="EssentialBackground"
    layer.Size=UDim2.fromScale(1,1) layer.BackgroundTransparency=1 layer.ScaleType=Enum.ScaleType.Fit layer.ZIndex=1
    layer.AnchorPoint=Vector2.new(0.5,0.5) layer.Position=UDim2.fromScale(0.5,0.5)
    layer.ImageTransparency=0.60
    local shade=Instance.new("Frame",backdrop) shade.Name="BackgroundShade" shade.Size=UDim2.fromScale(1,1)
    shade.BackgroundColor3=BgMain shade.BackgroundTransparency=0.40 shade.BorderSizePixel=0 shade.ZIndex=2
    shade:SetAttribute("_ThemeBgRole", "Shade")
    local fallback=Instance.new("UIGradient",matte) fallback.Rotation=70
    fallback.Color=ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.fromRGB(32,22,46)),ColorSequenceKeypoint.new(0.55,Color3.fromRGB(22,17,33)),ColorSequenceKeypoint.new(1,Color3.fromRGB(15,12,23))})
    UI_Elements._BackdropFallbackGrad = fallback
    MainClip.BackgroundColor3=BgMain
    local closed=false
    local imageUrl="https://media.istockphoto.com/id/2236602253/ru/видео/бесшовная-зацикленная-3d-анимация-светящихся-фиолетово-голубых-стеклянных-волн.jpg?s=640x640&k=20&c=sjlHuoYKQvgRsUKimv0h_X4rltWhusyI0mL9kO374rw="
    local function encodePath(url)
        return (url:gsub("[^%w%-%._~:/?=&]",function(c) return string.format("%%%02X",string.byte(c)) end))
    end
    local cache, pending = {}, {}
    UI_Elements._RefreshBackground = function(theme)
        local winter = theme == "Winter"
        local key = winter and "Winter" or "Essential"
        layer.ScaleType = Enum.ScaleType.Crop
        layer.ImageTransparency = winter and 0.25 or 0.60
        layer.Image = cache[key] or ""
        if closed or cache[key] or pending[key] then return end
        pending[key] = true
        task.spawn(function()
        local assetFn=getcustomasset or getsynasset
        if type(assetFn)~="function" or type(writefile)~="function" then
            return
        end
        local ok,result=pcall(function()
            local filename=winter and "Essential-Winter-Background-v1.jpg" or "Essential-Background-2236602253.jpg"
            local exists=type(isfile)=="function" and isfile(filename)
            if not exists then
                local bytes=game:HttpGet(encodePath(winter and "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRSeMW07praGY-OzeJROunNjgBZ0etyj5teNMKwsCVjBBjAtOB6YdtVcm_t&s=10" or imageUrl))
                assert(type(bytes)=="string" and #bytes>3 and #bytes<12000000 and bytes:sub(1,3)==string.char(255,216,255),"Expected JPEG data")
                if closed then return nil end
                writefile(filename,bytes)
            end
            return assetFn(filename)
        end)
        pending[key] = nil
        if closed or not layer.Parent then return end
        if ok and result then
            cache[key] = result
            if (Settings.ThemeType == "Winter") == winter then layer.Image=result end
        else
            warn("[Essential background] "..tostring(result))
        end
    end)
    end
    UI_Elements._RefreshBackground(Settings.ThemeType)
    UI_Elements._CleanupBackground=function() closed=true end
end
