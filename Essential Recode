local SkyboxState, EnforceSkybox, ResetSkybox
UI_Elements._InitSkybox = function()
local skyboxDropdown = CreateDropdownSection(VisualPage, "Custom Skybox")
SkyboxState = { ApplyingPreset = false, owned = {}, hidden = {}, effects = {}, props = {}, applying = false, stopped = false }
local E = SkyboxState
local function own(key, class, name)
    local obj = E.owned[key]
    if obj and not obj.Parent then
        local ok = pcall(function() obj.Parent = Lighting end)
        if not ok then obj = nil end
    end
    if not obj then obj = Instance.new(class) obj.Name = name obj.Parent = Lighting E.owned[key] = obj end
    return obj
end
local function drop(key)
    local obj = E.owned[key]
    E.owned[key] = nil
    if obj then pcall(function() obj:Destroy() end) end
end
local function assign(key, value)
    local current = Lighting[key]
    local rec = E.props[key]
    if not rec then rec = {base = current} E.props[key] = rec
    elseif current ~= rec.applied then rec.base = current end
    if current ~= value then Lighting[key] = value end
    rec.applied = value
end
local function release(key)
    local rec = E.props[key]
    if not rec then return end
    if Lighting[key] == rec.applied then Lighting[key] = rec.base end
    E.props[key] = nil
end
local skyProps = {"Brightness", "ExposureCompensation", "Ambient", "OutdoorAmbient", "ColorShift_Top", "ColorShift_Bottom", "ClockTime", "EnvironmentDiffuseScale", "EnvironmentSpecularScale"}
local fogProps = {"FogColor", "FogStart", "FogEnd"}
local function apply()
    if E.applying then return end
    E.applying = true
    local ok, err = pcall(function()
        local sky = Settings.SkyEnabled and not E.stopped
        local fog = Settings.CustomFog and not E.stopped
        -- Keep ownership records even when the other module is toggled off.
        for _, obj in ipairs(Lighting:GetChildren()) do
            local hide = (obj:IsA("Atmosphere") and (sky or fog) and obj ~= E.owned.atmo)
                or (obj:IsA("Sky") and sky and obj ~= E.owned.sky)
            if hide then E.hidden[obj] = true obj.Parent = nil end
            if obj:IsA("PostEffect") and obj ~= E.owned.cc and sky then
                if E.effects[obj] == nil then E.effects[obj] = obj.Enabled end
                if obj.Enabled then obj.Enabled = false end
            end
        end
        for obj in pairs(E.hidden) do
            local stillHide = (obj:IsA("Atmosphere") and (sky or fog)) or (obj:IsA("Sky") and sky)
            if not stillHide then
                if obj.Parent == nil then pcall(function() obj.Parent = Lighting end) end
                E.hidden[obj] = nil
            end
        end
        if sky then
            local sk = own("sky", "Sky", "EssentialCustomSky")
            -- Fixed built-in sky asset, not the current map's textures.
            sk.SkyboxBk = "rbxasset://textures/sky/sky512_bk.tex"
            sk.SkyboxDn = "rbxasset://textures/sky/sky512_dn.tex"
            sk.SkyboxFt = "rbxasset://textures/sky/sky512_ft.tex"
            sk.SkyboxLf = "rbxasset://textures/sky/sky512_lf.tex"
            sk.SkyboxRt = "rbxasset://textures/sky/sky512_rt.tex"
            sk.SkyboxUp = "rbxasset://textures/sky/sky512_up.tex"
            sk.StarCount = SkySettings.StarCount
            sk.SunAngularSize = SkySettings.SunAngularSize sk.MoonAngularSize = SkySettings.MoonAngularSize
            sk.CelestialBodiesShown = SkySettings.CelestialBodiesShown
            local skyCol = Color3.fromRGB(Settings.SkyR, Settings.SkyG, Settings.SkyB)
            local horCol = Color3.fromRGB(Settings.HorR, Settings.HorG, Settings.HorB)
            assign("Brightness", Settings.SkyBright / 100 * 6)
            assign("ExposureCompensation", Settings.SkyExp / 100 * 2 - 1)
            assign("ClockTime", Settings.SkyClock)
            assign("Ambient", skyCol:Lerp(horCol, 0.3):Lerp(Color3.new(0,0,0), 0.45))
            assign("OutdoorAmbient", horCol)
            assign("ColorShift_Top", skyCol) assign("ColorShift_Bottom", horCol)
            assign("EnvironmentDiffuseScale", 0.5) assign("EnvironmentSpecularScale", 0.5)
            local cc = own("cc", "ColorCorrectionEffect", "EssentialSkyCC")
            cc.Enabled = true cc.TintColor = skyCol:Lerp(Color3.new(1,1,1), 0.65)
            cc.Brightness = (Settings.SkyBright - 50) / 250 cc.Contrast = 0.05 cc.Saturation = 0.1
            if not fog then
                local at = own("atmo", "Atmosphere", "EssentialCustomAtmosphere")
                at.Density = 0.35 at.Offset = 0 at.Haze = 10 at.Glare = 0
                at.Color = skyCol at.Decay = horCol
            else drop("atmo") end
        else
            drop("sky") drop("atmo") drop("cc")
            for _, key in ipairs(skyProps) do release(key) end
            for obj, enabled in pairs(E.effects) do
                pcall(function() if obj.Enabled == false then obj.Enabled = enabled end end)
                E.effects[obj] = nil
            end
        end
        -- Fog has explicit priority over atmospheric haze, not over the sky or its lighting.
        if fog then
            assign("FogColor", Color3.fromRGB(Settings.FogR, Settings.FogG, Settings.FogB))
            assign("FogStart", Settings.FogStart)
            assign("FogEnd", math.max(Settings.FogStart + 1, Settings.FogEnd))
        elseif sky then
            assign("FogColor", Color3.fromRGB(Settings.HorR, Settings.HorG, Settings.HorB))
            assign("FogStart", 50000) assign("FogEnd", 100000)
        else
            for _, key in ipairs(fogProps) do release(key) end
        end
    end)
    E.applying = false
    if not ok and E.lastError ~= tostring(err) then E.lastError = tostring(err) warn("[Essential environment] " .. tostring(err)) end
end
EnforceSkybox = apply
ResetSkybox = apply
