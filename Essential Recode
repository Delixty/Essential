    local LocomotionTrackKeywords = { "walk", "run", "sprint" }

    local function NormalizeAngle(angle)
        return math.atan2(math.sin(angle), math.cos(angle))
    end

    local function ShortestAngleDiff(target, current)
        return math.atan2(math.sin(target - current), math.cos(target - current))
    end

    local function FindCharacterJoints(char, hrp)
        if not char or not hrp then return nil, nil, nil, false end
        local rootJ, waistJ, neckJ = nil, nil, nil
        local isR6 = false

        local lowerTorso = char:FindFirstChild("LowerTorso")
        local upperTorso = char:FindFirstChild("UpperTorso")
        local head = char:FindFirstChild("Head")
        local torsoR6 = char:FindFirstChild("Torso")

        if lowerTorso then
            rootJ = lowerTorso:FindFirstChild("Root") or lowerTorso:FindFirstChildOfClass("Motor6D")
            if upperTorso then
                waistJ = upperTorso:FindFirstChild("Waist") or upperTorso:FindFirstChildOfClass("Motor6D")
            end
            if head then
                neckJ = head:FindFirstChild("Neck") or head:FindFirstChildOfClass("Motor6D")
            end
        elseif torsoR6 then
            isR6 = true
            rootJ = hrp:FindFirstChild("RootJoint") or torsoR6:FindFirstChild("RootJoint") or hrp:FindFirstChildOfClass("Motor6D")
            neckJ = torsoR6:FindFirstChild("Neck") or (head and head:FindFirstChild("Neck"))
        else
            rootJ = hrp:FindFirstChildOfClass("Motor6D")
        end

        return rootJ, waistJ, neckJ, isR6
    end

    local function IsInLobbyOrSpectating()
        local blocked = false
        pcall(function()
            local team = LocalPlayer.Team
            if team then
                local tn = string.lower(team.Name)
                if string.find(tn, "lobby", 1, true) or string.find(tn, "menu", 1, true) or string.find(tn, "spectat", 1, true) or string.find(tn, "wait", 1, true) then
                    blocked = true
                end
            end
            if LocalPlayer:GetAttribute("InLobby") == true or LocalPlayer:GetAttribute("Spectating") == true or LocalPlayer:GetAttribute("IsSpectator") == true then
                blocked = true
            end
        end)
        return blocked
    end

    local function IsSmootherActionBlocked(char, hum, hrp)
        if not char or not hum or not hrp or not hrp.Parent then return true end
        if hum.Health <= 0 or hrp.Anchored or hum.PlatformStand or hum.Sit or hum.SeatPart ~= nil then
            return true
        end
        local st = hum:GetState()
        if st == Enum.HumanoidStateType.Dead
            or st == Enum.HumanoidStateType.Seated
            or st == Enum.HumanoidStateType.Climbing
            or st == Enum.HumanoidStateType.Swimming
            or st == Enum.HumanoidStateType.PlatformStanding
            or st == Enum.HumanoidStateType.Ragdoll
            or st == Enum.HumanoidStateType.FallingDown
            or st == Enum.HumanoidStateType.GettingUp then
            return true
        end
        for _, child in ipairs(hrp:GetChildren()) do
            if child:IsA("BodyMover") then
                if not child:IsA("BodyGyro") or child.MaxTorque.Magnitude > 0.01 then return true end
            elseif child:IsA("AlignPosition") or child:IsA("AlignOrientation") or child:IsA("LinearVelocity") or child:IsA("AngularVelocity") or child:IsA("VectorForce") then
                if child.Enabled then return true end
            end
        end
        local boolAttrs = {
            "Vaulting", "IsVaulting", "isVaulting", "Sliding", "IsSliding", "isSliding", "isSlideingPallet",
            "Interacting", "IsInteracting", "isInteracting", "Repairing", "IsRepairing", "isRepairing",
            "Healing", "IsHealing", "isHealing", "Stunned", "IsStunned", "stunned", "Carried", "IsCarried",
            "Hooked", "IsHooked", "Downed", "IsDowned", "Crawling", "Busy", "Locked", "InAction"
        }
        for _, target in ipairs({ char, hum, LocalPlayer }) do
            for i = 1, #boolAttrs do
                if target:GetAttribute(boolAttrs[i]) == true then return true end
            end
            local act = target:GetAttribute("Action") or target:GetAttribute("State") or target:GetAttribute("CurrentAction") or target:GetAttribute("Interaction")
            if type(act) == "string" then
                local al = string.lower(act)
                if al ~= "" and al ~= "none" and al ~= "idle" and al ~= "normal" and al ~= "walk" and al ~= "run" and al ~= "sprint" and al ~= "crouch" and al ~= "emote" and al ~= "jump" then
                    return true
                end
            end
        end
        return false
    end

    -- Считывает реальный вектор клавиш (W/A/S/D) относительно камеры без искажений от hum:Move()
    local function ReadTrueInputVector(hum)
        if UserInputService:GetFocusedTextBox() or KeybindListening then
            return Vector3.zero, false
        end

        local cam = workspace.CurrentCamera
        local f, r = 0, 0
        if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up) then f = f + 1 end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down) then f = f - 1 end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then r = r + 1 end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then r = r - 1 end

        if (f ~= 0 or r ~= 0) and cam then
            local camCF = cam.CFrame
            local forward = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
            local right = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z)
            if forward.Magnitude > 0.001 then forward = forward.Unit end
            if right.Magnitude > 0.001 then right = right.Unit end
            local combined = forward * f + right * r
            if combined.Magnitude > 0.001 then
                return combined.Unit, true
            end
        end

        -- Поддержка сенсорного экрана (Phone) или геймпада, когда персонаж не находится в фазе синтетического скольжения
        if not SM.isCoasting and hum then
            local md = hum.MoveDirection
            local flat = Vector3.new(md.X, 0, md.Z)
            if flat.Magnitude > 0.05 then
                return flat.Unit, true
            end
        end

        return Vector3.zero, false
    end

    local function RestoreAutoRotate()
        if SM.autoRotateOverridden and SM.hum and SM.hum.Parent and not Settings.Moonwalk then
            if SM.savedAutoRotate ~= nil then
                pcall(function() SM.hum.AutoRotate = SM.savedAutoRotate end)
            else
                pcall(function() SM.hum.AutoRotate = true end)
            end
        end
        SM.autoRotateOverridden = false
        SM.savedAutoRotate = nil
    end

    local function RestoreCharacterJoints()
        if SM.rootJoint and SM.rootJoint.Parent and SM.origRootC0 then
            pcall(function() SM.rootJoint.C0 = SM.origRootC0 end)
        end
        if SM.waistJoint and SM.waistJoint.Parent and SM.origWaistC0 then
            pcall(function() SM.waistJoint.C0 = SM.origWaistC0 end)
        end
        if SM.neckJoint and SM.neckJoint.Parent and SM.origNeckC0 then
            pcall(function() SM.neckJoint.C0 = SM.origNeckC0 end)
        end
        SM.visRoll = 0
        SM.visPitch = 0
        SM.visYawLag = 0
        SM.visSlideOffset = Vector3.zero
    end

    local function RestoreCameraOffset()
        if SM.hum and SM.hum.Parent then
            SM.writingCamOffset = true
            pcall(function()
                if (SM.hum.CameraOffset - (SM.baseCamOffset + SM.appliedCamOffset)).Magnitude < 0.08 then
                    SM.hum.CameraOffset = SM.baseCamOffset
                end
            end)
            SM.writingCamOffset = false
        end
        SM.appliedCamOffset = Vector3.zero
        SM.camSmoothOffset = Vector3.zero
    end

    local function StopCoastingMove()
        if SM.isCoasting and SM.hum and SM.hum.Parent then
            SM.isCoasting = false
            pcall(function() SM.hum:Move(Vector3.zero, false) end)
        end
        SM.isCoasting = false
    end

    local function ResetDynamicState()
        StopCoastingMove()
        SM.rawInputDir = Vector3.zero
        SM.hasRawInput = false
        SM.moveAngle = nil
        SM.moveMomentum = 0
        SM.inertialDir = Vector3.zero
        SM.smoothedHorizVel = Vector3.zero
        SM.currentYaw = nil
        SM.yawAngularVel = 0
        RestoreAutoRotate()
        RestoreCharacterJoints()
        RestoreCameraOffset()
    end

    local function UnbindCharacter()
        if SM.camOffsetConn then pcall(function() SM.camOffsetConn:Disconnect() end) SM.camOffsetConn = nil end
        if SM.diedConn then pcall(function() SM.diedConn:Disconnect() end) SM.diedConn = nil end
        ResetDynamicState()
        SM.char = nil
        SM.hum = nil
        SM.hrp = nil
        SM.rootJoint = nil
        SM.origRootC0 = nil
        SM.waistJoint = nil
        SM.origWaistC0 = nil
        SM.neckJoint = nil
        SM.origNeckC0 = nil
    end

    local function BindCharacter(char)
        if SM.char == char and SM.hum and SM.hum.Parent and SM.hrp and SM.hrp.Parent then
            if not SM.rootJoint or not SM.rootJoint.Parent then
                SM.rootJoint, SM.waistJoint, SM.neckJoint, SM.isR6 = FindCharacterJoints(char, SM.hrp)
                if SM.rootJoint then SM.origRootC0 = SM.rootJoint.C0 end
                if SM.waistJoint then SM.origWaistC0 = SM.waistJoint.C0 end
                if SM.neckJoint then SM.origNeckC0 = SM.neckJoint.C0 end
            end
            return true
        end

        UnbindCharacter()
        if not char then return false end
        local hum = char:FindFirstChildWhichIsA("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
        if not hum or not hrp then return false end

        SM.char = char
        SM.hum = hum
        SM.hrp = hrp
        SM.rootJoint, SM.waistJoint, SM.neckJoint, SM.isR6 = FindCharacterJoints(char, hrp)
        if SM.rootJoint then SM.origRootC0 = SM.rootJoint.C0 end
        if SM.waistJoint then SM.origWaistC0 = SM.waistJoint.C0 end
        if SM.neckJoint then SM.origNeckC0 = SM.neckJoint.C0 end

        SM.baseCamOffset = hum.CameraOffset
        SM.appliedCamOffset = Vector3.zero

        SM.camOffsetConn = hum:GetPropertyChangedSignal("CameraOffset"):Connect(function()
            if SM.closed or SM.writingCamOffset or SM.hum ~= hum then return end
            local current = hum.CameraOffset
            if (current - (SM.baseCamOffset + SM.appliedCamOffset)).Magnitude > 0.005 then
                SM.baseCamOffset = current - SM.appliedCamOffset
            end
        end)

        SM.diedConn = hum.Died:Connect(function()
            ResetDynamicState()
        end)

        local look = hrp.CFrame.LookVector
        SM.currentYaw = math.atan2(-look.X, -look.Z)
        SM.moveAngle = SM.currentYaw
        return true
    end

    local function ApplyJointVisuals()
        local rj = SM.rootJoint
        if rj and rj.Parent and SM.origRootC0 then
            if math.abs(SM.visRoll) < 0.0004 and math.abs(SM.visPitch) < 0.0004 and math.abs(SM.visYawLag) < 0.0004 and SM.visSlideOffset.Magnitude < 0.0008 then
                rj.C0 = SM.origRootC0
            else
                local baseRot = SM.origRootC0 - SM.origRootC0.Position
                -- Вращение в пространстве HumanoidRootPart (Part0), поэтому и на R15, и на R6 оси наклона работают идентично
                local tiltCF = CFrame.Angles(SM.visPitch, SM.visYawLag, SM.visRoll)
                rj.C0 = CFrame.new(SM.origRootC0.Position + SM.visSlideOffset) * tiltCF * baseRot
            end
        end

        local wj = SM.waistJoint
        if wj and wj.Parent and SM.origWaistC0 then
            if math.abs(SM.visRoll) < 0.0004 and math.abs(SM.visPitch) < 0.0004 then
                wj.C0 = SM.origWaistC0
            else
                local wBaseRot = SM.origWaistC0 - SM.origWaistC0.Position
                local wTilt = CFrame.Angles(SM.visPitch * 0.42, SM.visYawLag * 0.48, SM.visRoll * 0.45)
                wj.C0 = CFrame.new(SM.origWaistC0.Position) * wTilt * wBaseRot
            end
        end

        local nj = SM.neckJoint
        if nj and nj.Parent and SM.origNeckC0 then
            if math.abs(SM.visYawLag) < 0.0004 and math.abs(SM.visRoll) < 0.0004 then
                nj.C0 = SM.origNeckC0
            else
                local nBaseRot = SM.origNeckC0 - SM.origNeckC0.Position
                -- Голова выжившего слегка поворачивается внутрь виража (эффект взгляда в поворот из DBD)
                local nTilt = CFrame.new(SM.origNeckC0.Position)
                if SM.isR6 then
                    nj.C0 = nTilt * nBaseRot * CFrame.Angles(0, -SM.visRoll * 0.35, -SM.visYawLag * 0.55)
                else
                    nj.C0 = nTilt * CFrame.Angles(-SM.visPitch * 0.25, -SM.visYawLag * 0.55, -SM.visRoll * 0.3) * nBaseRot
                end
            end
        end
    end

    local function SyncLocomotionAnimations(hum, hasInput, momentum)
        local animator = hum:FindFirstChildOfClass("Animator")
        if not animator then return end
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            if track.IsPlaying and track.WeightCurrent > 0.05
                and track.Priority ~= Enum.AnimationPriority.Action
                and track.Priority ~= Enum.AnimationPriority.Action2
                and track.Priority ~= Enum.AnimationPriority.Action3
                and track.Priority ~= Enum.AnimationPriority.Action4 then
                local anim = track.Animation
                local name = string.lower((anim and anim.Name or "") .. " " .. (track.Name or ""))
                local isLoco = false
                for i = 1, #LocomotionTrackKeywords do
                    if string.find(name, LocomotionTrackKeywords[i], 1, true) then
                        isLoco = true
                        break
                    end
                end
                if isLoco and (hasInput or momentum > 0.1) then
                    local targetSpeed = math.clamp(0.65 + momentum * 0.42, 0.55, 1.25)
                    local curSpd = track.Speed
                    if curSpd > 0.05 and math.abs(curSpd - targetSpeed) > 0.02 then
                        pcall(function()
                            track:AdjustSpeed(curSpd + (targetSpeed - curSpd) * 0.25)
                        end)
                    end
                end
            end
        end
    end

    -- ШАГ 1 (Input + 5): перехват ввода и передача сглаженной дуги движения в Humanoid:Move
    local function InputMovementStep(dt)
        if SM.closed or not Settings.SmootherMovement then return end
        dt = math.clamp(tonumber(dt) or (1 / 60), 1 / 240, 0.1)

        local char = LocalPlayer.Character
        if not BindCharacter(char) then return end
        local hum, hrp = SM.hum, SM.hrp

        if IsInLobbyOrSpectating() or IsSmootherActionBlocked(char, hum, hrp) then
            ResetDynamicState()
            return
        end

        local slideNorm = math.clamp((tonumber(Settings.SmoothSlideIntensity) or 65) / 100, 0, 1)
        local rotNorm = math.clamp((tonumber(Settings.SmoothRotationSpeed) or 45) / 100, 0.05, 1)
        local inertiaNorm = math.clamp((tonumber(Settings.SmoothInertia) or 65) / 100, 0, 1)
        local recoveryNorm = math.clamp((tonumber(Settings.SmoothRecoverySpeed) or 50) / 100, 0.05, 1)

        local rawDir, hasInput = ReadTrueInputVector(hum)
        SM.rawInputDir = rawDir
        SM.hasRawInput = hasInput

        if hasInput then
            SM.isCoasting = false
            local targetAngle = math.atan2(-rawDir.X, -rawDir.Z)

            if SM.moveAngle == nil or SM.moveMomentum < 0.08 then
                SM.moveAngle = targetAngle
            else
                local diff = ShortestAngleDiff(targetAngle, SM.moveAngle)
                -- При развороте на 135°..180° фиксируем направление заноса, чтобы персонаж описывал красивую J-дугу
                if math.abs(diff) > 2.25 then
                    if math.abs(diff) > 2.75 then
                        diff = math.abs(diff) * SM.turnSign
                    else
                        SM.turnSign = (diff >= 0) and 1 or -1
                    end
                elseif math.abs(diff) > 0.15 then
                    SM.turnSign = (diff >= 0) and 1 or -1
                end

                -- Скорость поворота вектора траектории: чем выше Inertia и Slide Intensity, тем шире и плавнее дуга заноса
                local curveRate = 2.6 + (1 - inertiaNorm * 0.72) * 8.5 + rotNorm * 3.2 - slideNorm * 1.4
                curveRate = math.max(2.0, curveRate)
                local maxStep = curveRate * dt
                if math.abs(diff) <= maxStep then
                    SM.moveAngle = targetAngle
                else
                    SM.moveAngle = NormalizeAngle(SM.moveAngle + math.clamp(diff, -maxStep, maxStep))
                end

                -- При резком развороте (>110°) импульс слегка приседает в точке заноса и плавно набирается снова
                local sharpTurnFactor = math.clamp((math.abs(diff) - 1.6) / 1.5, 0, 1)
                if sharpTurnFactor > 0 and inertiaNorm > 0.1 then
                    SM.moveMomentum = math.max(0.38, SM.moveMomentum - sharpTurnFactor * inertiaNorm * 1.8 * dt)
                end
            end

            local accelRate = 3.5 + (1 - inertiaNorm * 0.65) * 9.5
            SM.moveMomentum = math.clamp(SM.moveMomentum + (1 - SM.moveMomentum) * (1 - math.exp(-accelRate * dt)), 0, 1)
            SM.inertialDir = Vector3.new(-math.sin(SM.moveAngle), 0, -math.cos(SM.moveAngle))

            if hum.FloorMaterial ~= Enum.Material.Air and (inertiaNorm > 0.02 or slideNorm > 0.02) then
                pcall(function()
                    hum:Move(SM.inertialDir, false)
                end)
            end
        else
            -- Фаза инерционного скольжения после отпускания клавиш
            local decelRate = (2.2 + recoveryNorm * 7.5) * (1.35 - inertiaNorm * 0.78)
            SM.moveMomentum = SM.moveMomentum * math.exp(-math.max(1.4, decelRate) * dt)

            if SM.moveMomentum > 0.06 and (inertiaNorm > 0.05 or slideNorm > 0.05) and hum.FloorMaterial ~= Enum.Material.Air then
                SM.isCoasting = true
                pcall(function()
                    hum:Move(SM.inertialDir, false)
                end)
            else
                SM.moveMomentum = 0
                SM.inertialDir = Vector3.zero
                StopCoastingMove()
            end
        end
    end

    -- ШАГ 2 (PreSimulation / Stepped): сглаживание физического импульса скорости в пределах допустимого WalkSpeed
    local function PhysicsInertiaStep(dt)
        if SM.closed or not Settings.SmootherMovement then return end
        local char, hum, hrp = SM.char, SM.hum, SM.hrp
        if not char or not hum or not hrp or not hrp.Parent then return end
        if IsInLobbyOrSpectating() or IsSmootherActionBlocked(char, hum, hrp) then return end
        if hum.FloorMaterial == Enum.Material.Air then
            local v = hrp.AssemblyLinearVelocity
            SM.smoothedHorizVel = Vector3.new(v.X, 0, v.Z)
            return
        end

        dt = math.clamp(tonumber(dt) or (1 / 60), 1 / 240, 0.1)
        local inertiaNorm = math.clamp((tonumber(Settings.SmoothInertia) or 65) / 100, 0, 1)
        local slideNorm = math.clamp((tonumber(Settings.SmoothSlideIntensity) or 65) / 100, 0, 1)
        local recoveryNorm = math.clamp((tonumber(Settings.SmoothRecoverySpeed) or 50) / 100, 0.05, 1)

        if inertiaNorm <= 0.02 and slideNorm <= 0.02 then return end

        local curVel = hrp.AssemblyLinearVelocity
        local curHoriz = Vector3.new(curVel.X, 0, curVel.Z)
        local maxAllowedSpeed = math.max(hum.WalkSpeed, curHoriz.Magnitude)

        local targetSpeed = SM.hasRawInput and hum.WalkSpeed or (hum.WalkSpeed * SM.moveMomentum)
        local targetHoriz = (SM.inertialDir.Magnitude > 0.01) and (SM.inertialDir.Unit * targetSpeed) or Vector3.zero

        local blendRate = SM.hasRawInput
            and (2.4 + (1 - inertiaNorm * 0.78) * 11.0 - slideNorm * 1.2)
            or (2.0 + recoveryNorm * 8.5 * (1.25 - inertiaNorm * 0.65))
        blendRate = math.max(1.8, blendRate)

        local alpha = 1 - math.exp(-blendRate * dt)
        SM.smoothedHorizVel = SM.smoothedHorizVel:Lerp(targetHoriz, alpha)

        -- Строгое ограничение текущей серверной скоростью WalkSpeed (никакого спидхака или обхода античита)
        if SM.smoothedHorizVel.Magnitude > maxAllowedSpeed and maxAllowedSpeed > 0 then
            SM.smoothedHorizVel = SM.smoothedHorizVel.Unit * maxAllowedSpeed
        end

        if SM.hasRawInput or SM.moveMomentum > 0.03 or SM.smoothedHorizVel.Magnitude > 0.25 then
            hrp.AssemblyLinearVelocity = Vector3.new(SM.smoothedHorizVel.X, curVel.Y, SM.smoothedHorizVel.Z)
        end
    end

    -- ШАГ 3 (RenderPriority.Last + 10): плавное вращение (180°/360°), выраженный наклон корпуса (DBD Slide) и камера
    local function LateVisualAndRotationStep(dt)
        if SM.closed or not Settings.SmootherMovement then return end
        dt = math.clamp(tonumber(dt) or (1 / 60), 1 / 240, 0.1)

        local char = LocalPlayer.Character
        if not BindCharacter(char) then return end
        local hum, hrp = SM.hum, SM.hrp

        if IsInLobbyOrSpectating() or IsSmootherActionBlocked(char, hum, hrp) then
            ResetDynamicState()
            return
        end

        local slideNorm = math.clamp((tonumber(Settings.SmoothSlideIntensity) or 65) / 100, 0, 1)
        local rotNorm = math.clamp((tonumber(Settings.SmoothRotationSpeed) or 45) / 100, 0.05, 1)
        local inertiaNorm = math.clamp((tonumber(Settings.SmoothInertia) or 65) / 100, 0, 1)
        local recoveryNorm = math.clamp((tonumber(Settings.SmoothRecoverySpeed) or 50) / 100, 0.05, 1)
        local camNorm = math.clamp((tonumber(Settings.SmoothCameraSmoothness) or 50) / 100, 0, 1)

        local cam = workspace.CurrentCamera
        local isFirstPerson = cam and ((cam.Focus.Position - cam.CFrame.Position).Magnitude < 1.15) or false
        -- В Violence District мышь заблокирована по центру в 3-м лице, поэтому проверяем только 1-е лицо и Moonwalk
        local canControlRotation = (not Settings.Moonwalk) and (not isFirstPerson)

        if canControlRotation then
            if not SM.autoRotateOverridden then
                SM.savedAutoRotate = hum.AutoRotate
                SM.autoRotateOverridden = true
            end
            if hum.AutoRotate ~= false then
                hum.AutoRotate = false
            end

            if SM.currentYaw == nil then
                local look = hrp.CFrame.LookVector
                SM.currentYaw = math.atan2(-look.X, -look.Z)
            end

            local desiredMoveDir = SM.hasRawInput and SM.rawInputDir or ((SM.moveMomentum > 0.08) and SM.inertialDir or Vector3.zero)
            if desiredMoveDir.Magnitude > 0.04 then
                local targetYaw = math.atan2(-desiredMoveDir.X, -desiredMoveDir.Z)
                local angleDiff = ShortestAngleDiff(targetYaw, SM.currentYaw)

                -- Фиксация направления вращения при 180° и 360° манёврах (без резких перебросов знака)
                if math.abs(angleDiff) > 2.2 then
                    if math.abs(SM.yawAngularVel) > 0.8 then
                        SM.spinSign = (SM.yawAngularVel >= 0) and 1 or -1
                    elseif math.abs(angleDiff) < 2.8 then
                        SM.spinSign = (angleDiff >= 0) and 1 or -1
                    end
                    angleDiff = math.abs(angleDiff) * SM.spinSign
                elseif math.abs(angleDiff) > 0.15 then
                    SM.spinSign = (angleDiff >= 0) and 1 or -1
                end

                local turnGain = 3.2 + rotNorm * 10.5
                local maxAngSpeed = 3.8 + rotNorm * 11.2
                local desiredAngVel = math.clamp(angleDiff * turnGain, -maxAngSpeed, maxAngSpeed)

                local angResponse = 5.5 + rotNorm * 12.0 - inertiaNorm * 3.0
                local angAlpha = 1 - math.exp(-math.max(2.2, angResponse) * dt)
                SM.yawAngularVel = SM.yawAngularVel + (desiredAngVel - SM.yawAngularVel) * angAlpha
                SM.currentYaw = NormalizeAngle(SM.currentYaw + SM.yawAngularVel * dt)
            else
                local stopDecay = math.exp(-(4.5 + recoveryNorm * 12.0) * dt)
                SM.yawAngularVel = SM.yawAngularVel * stopDecay
                if math.abs(SM.yawAngularVel) < 0.01 then
                    SM.yawAngularVel = 0
                else
                    SM.currentYaw = NormalizeAngle(SM.currentYaw + SM.yawAngularVel * dt)
                end
            end

            hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, SM.currentYaw, 0)
        else
            RestoreAutoRotate()
            local look = hrp.CFrame.LookVector
            local newYaw = math.atan2(-look.X, -look.Z)
            if SM.currentYaw ~= nil then
                local dYaw = ShortestAngleDiff(newYaw, SM.currentYaw)
                local instVel = dYaw / math.max(dt, 1 / 240)
                SM.yawAngularVel = SM.yawAngularVel + (math.clamp(instVel, -18, 18) - SM.yawAngularVel) * (1 - math.exp(-12 * dt))
            end
            SM.currentYaw = newYaw
        end

        -- Расчёт вектора заноса (разница между инерцией и текущим вводом) в локальных координатах персонажа
        local activeInput = SM.hasRawInput and SM.rawInputDir or Vector3.zero
        local currentInertial = SM.inertialDir * SM.moveMomentum
        local slipWorld = currentInertial - activeInput
        local localSlip = hrp.CFrame:VectorToObjectSpace(slipWorld)
        local localInertial = hrp.CFrame:VectorToObjectSpace(currentInertial)

        -- 1. Выраженный боковой крен в поворот (Roll до 30°)
        local angularBank = math.clamp(SM.yawAngularVel * 0.16, -1.1, 1.1) * math.clamp(SM.moveMomentum + 0.25, 0, 1)
        local slipBank = math.clamp(-localSlip.X * 0.85, -1.1, 1.1)
        local targetRoll = math.clamp(angularBank + slipBank * 0.75, -1.25, 1.25) * math.rad(30.0 * slideNorm)

        -- 2. Продольный наклон при разгоне и резком торможении/развороте на 180° (Pitch до 18°)
        local forwardLean = math.clamp(-localInertial.Z * 0.35 + localSlip.Z * 0.95, -1.2, 1.2)
        local targetPitch = forwardLean * math.rad(18.0 * slideNorm)

        -- 3. Скручивание корпуса в заносе (Yaw Lag до 24°)
        local targetYawLag = math.clamp(-SM.yawAngularVel * 0.11 + localSlip.X * 0.45, -1.15, 1.15) * math.rad(24.0 * slideNorm)

        -- 4. Горизонтальный сдвиг модели по направлению инерционного скольжения (до 1.3 stud)
        local targetSlideOffset = Vector3.new(
            math.clamp((localSlip.X * 0.95 - SM.yawAngularVel * 0.06) * slideNorm, -1.3, 1.3),
            -math.abs(targetRoll) * 0.28 * slideNorm,
            math.clamp(localSlip.Z * 0.95 * slideNorm, -1.3, 1.3)
        )

        local isRecovering = (not SM.hasRawInput) and (SM.moveMomentum < 0.15) and (math.abs(SM.yawAngularVel) < 0.25)
        local visRate = isRecovering
            and (3.2 + recoveryNorm * 12.5)
            or (4.8 + (1 - slideNorm * 0.4) * 7.0 + recoveryNorm * 3.5)
        local visAlpha = 1 - math.exp(-visRate * dt)

        SM.visRoll = SM.visRoll + (targetRoll - SM.visRoll) * visAlpha
        SM.visPitch = SM.visPitch + (targetPitch - SM.visPitch) * visAlpha
        SM.visYawLag = SM.visYawLag + (targetYawLag - SM.visYawLag) * visAlpha
        SM.visSlideOffset = SM.visSlideOffset:Lerp(targetSlideOffset, visAlpha)

        ApplyJointVisuals()
        SyncLocomotionAnimations(hum, SM.hasRawInput, SM.moveMomentum)

        -- 5. Визуальное сопровождение камеры (Camera Smoothness, отдельно от физики модели)
        if camNorm > 0.01 then
            local targetCamLag = Vector3.new(
                math.clamp((-SM.yawAngularVel * 0.095 + localSlip.X * 0.68) * camNorm, -1.15, 1.15),
                math.clamp(-math.abs(SM.visRoll) * 0.22 * camNorm, -0.28, 0.28),
                math.clamp(localSlip.Z * 0.55 * camNorm, -0.65, 0.65)
            )
            local camRate = 3.5 + (1 - camNorm * 0.55) * 8.5 + recoveryNorm * 4.0
            SM.camSmoothOffset = SM.camSmoothOffset:Lerp(targetCamLag, 1 - math.exp(-camRate * dt))
            if isRecovering and SM.camSmoothOffset.Magnitude < 0.001 then
                SM.camSmoothOffset = Vector3.zero
            end
            SM.writingCamOffset = true
            SM.appliedCamOffset = SM.camSmoothOffset
            pcall(function()
                hum.CameraOffset = SM.baseCamOffset + SM.appliedCamOffset
            end)
            SM.writingCamOffset = false
        elseif SM.appliedCamOffset.Magnitude > 0 then
            RestoreCameraOffset()
        end
    end

    local function StartSmootherMovement()
        if SM.closed or SM.bound then return end
        if LocalPlayer.Character then
            BindCharacter(LocalPlayer.Character)
        end

        pcall(function() RunService:UnbindFromRenderStep("EssentialSmootherInput") end)
        pcall(function() RunService:UnbindFromRenderStep("EssentialSmootherRender") end)

        local okIn = pcall(function()
            RunService:BindToRenderStep("EssentialSmootherInput", Enum.RenderPriority.Input.Value + 5, InputMovementStep)
        end)
        local okOut = pcall(function()
            RunService:BindToRenderStep("EssentialSmootherRender", Enum.RenderPriority.Last.Value + 10, LateVisualAndRotationStep)
        end)

        if not okIn or not okOut then
            SM.inputConn = RunService.RenderStepped:Connect(function(dt)
                InputMovementStep(dt)
                LateVisualAndRotationStep(dt)
            end)
        end

        local simSig
        pcall(function() simSig = RunService.PreSimulation end)
        SM.simConn = (simSig or RunService.Stepped):Connect(PhysicsInertiaStep)

        -- Дублируем применение наклона суставов и поворота в Heartbeat, чтобы ни один скрипт игры не сбрасывал C0 перед отрисовкой кадра
        SM.hbConn = RunService.Heartbeat:Connect(function()
            if SM.closed or not Settings.SmootherMovement then return end
            if SM.hrp and SM.hrp.Parent and SM.currentYaw and not Settings.Moonwalk then
                local cam = workspace.CurrentCamera
                local isFP = cam and ((cam.Focus.Position - cam.CFrame.Position).Magnitude < 1.15) or false
                if not isFP and not IsSmootherActionBlocked(SM.char, SM.hum, SM.hrp) then
                    SM.hrp.CFrame = CFrame.new(SM.hrp.Position) * CFrame.Angles(0, SM.currentYaw, 0)
                end
            end
            ApplyJointVisuals()
        end)

        SM.bound = true
    end

    local function StopSmootherMovement()
        if SM.bound then
            pcall(function() RunService:UnbindFromRenderStep("EssentialSmootherInput") end)
            pcall(function() RunService:UnbindFromRenderStep("EssentialSmootherRender") end)
            if SM.inputConn then pcall(function() SM.inputConn:Disconnect() end) SM.inputConn = nil end
            if SM.simConn then pcall(function() SM.simConn:Disconnect() end) SM.simConn = nil end
            if SM.hbConn then pcall(function() SM.hbConn:Disconnect() end) SM.hbConn = nil end
            SM.bound = false
        end
        UnbindCharacter()
    end

    UI_Elements._SetSmootherMovement = function(state)
        if SM.closed then return end
        Settings.SmootherMovement = (state == true)
        if Settings.SmootherMovement then
            StartSmootherMovement()
        else
            StopSmootherMovement()
        end
    end

    UI_Elements._CleanupSmootherMovement = function()
        if SM.closed then return end
        SM.closed = true
        Settings.SmootherMovement = false
        StopSmootherMovement()
        if smoothEnv._EssentialSmootherMovementCleanup == UI_Elements._CleanupSmootherMovement then
            smoothEnv._EssentialSmootherMovementCleanup = nil
        end
    end
    smoothEnv._EssentialSmootherMovementCleanup = UI_Elements._CleanupSmootherMovement

    table.insert(connections, LocalPlayer.CharacterAdded:Connect(function(newChar)
        if SM.closed then return end
        UnbindCharacter()
        task.wait(0.25)
        if not SM.closed and Settings.SmootherMovement then
            BindCharacter(newChar)
        end
    end))

    table.insert(connections, LocalPlayer.CharacterRemoving:Connect(function(oldChar)
        if SM.char == oldChar then
            UnbindCharacter()
        end
    end))
end

