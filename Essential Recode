local function GetTextureProfile(mode)
    if mode == "Performance" then
        return {
            Quality = Enum.QualityLevel.Level01,
            MeshDetail = "Level01",
            Shadows = false,
            Tech = Enum.Technology.Legacy,
            SmoothMaterials = true,
            DisableParticles = true,
            DisablePostFX = true
        }
    elseif mode == "Quality" then
        return {
            Quality = Enum.QualityLevel.Level05,
            MeshDetail = "Level03",
            Shadows = true,
            Tech = Enum.Technology.ShadowMap,
            SmoothMaterials = false,
            DisableParticles = false,
            DisablePostFX = false
        }
    else -- Balanced
        return {
            Quality = Enum.QualityLevel.Level03,
            MeshDetail = "Level02",
            Shadows = false,
            Tech = Enum.Technology.Legacy,
            SmoothMaterials = false,
            DisableParticles = false,
            DisablePostFX = true
        }
    end
end

local function BuildCharacterSet()
    local set = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then set[plr.Character] = true end
    end
    return set
end

local function IsInCharacterSet(obj, charSet)
    local cur = obj.Parent
    while cur and cur ~= workspace and cur ~= game do
        if charSet[cur] then return true end
        cur = cur.Parent
    end
    return false
end

local function RestoreSingleObjectRecord(obj, rec)
    if not obj or not obj.Parent or not rec then return end
    local orig = rec.orig
    local applied = rec.applied
    if not orig or not applied then return end

    if obj:IsA("BasePart") then
        -- Восстанавливаем только те свойства, которые не были перезаписаны самой игрой после вмешательства LowGraphics
        if orig.CastShadow ~= nil and applied.CastShadow ~= nil and obj.CastShadow == applied.CastShadow then
            obj.CastShadow = orig.CastShadow
        end
        if orig.Material ~= nil and applied.Material ~= nil and obj.Material == applied.Material then
            obj.Material = orig.Material
        end
        if orig.MaterialVariant ~= nil and applied.MaterialVariant ~= nil and obj.MaterialVariant == applied.MaterialVariant then
            obj.MaterialVariant = orig.MaterialVariant
        end
        if orig.Reflectance ~= nil and applied.Reflectance ~= nil and math.abs(obj.Reflectance - applied.Reflectance) < 0.001 then
            obj.Reflectance = orig.Reflectance
        end
        if obj:IsA("MeshPart") and orig.TextureID ~= nil and applied.TextureID ~= nil and obj.TextureID == applied.TextureID then
            pcall(function() obj.TextureID = orig.TextureID end)
        end
    elseif obj:IsA("SpecialMesh") then
        if orig.TextureId ~= nil and applied.TextureId ~= nil and obj.TextureId == applied.TextureId then
            pcall(function() obj.TextureId = orig.TextureId end)
        end
    elseif obj:IsA("Decal") or obj:IsA("Texture") then
        if orig.Transparency ~= nil and applied.Transparency ~= nil and math.abs(obj.Transparency - applied.Transparency) < 0.001 then
            obj.Transparency = orig.Transparency
        end
    elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
        if orig.Enabled ~= nil and applied.Enabled ~= nil and obj.Enabled == applied.Enabled then
            obj.Enabled = orig.Enabled
        end
    end
end

local function ProcessLowGFXObject(obj, mode, profile, charSet)
    if not obj or not obj.Parent then return end
    if LowGraphicsState.ProcessedMode[obj] == mode then return end

    if obj:IsA("BasePart") then
        if IsInCharacterSet(obj, charSet) then return end
        local rec = LowGraphicsState.ObjectRecords[obj]
        if not rec then
            rec = {
                orig = {
                    CastShadow = obj.CastShadow,
                    Material = obj.Material,
                    MaterialVariant = obj.MaterialVariant,
                    Reflectance = obj.Reflectance,
                    TextureID = obj:IsA("MeshPart") and obj.TextureID or nil
                },
                applied = {}
            }
            LowGraphicsState.ObjectRecords[obj] = rec
        else
            -- Если переключается подрежим (например, Performance -> Balanced), сначала определяем текущие базовые значения
            if rec.applied.Material ~= nil and obj.Material ~= rec.applied.Material then
                rec.orig.Material = obj.Material
            end
            if rec.applied.Reflectance ~= nil and math.abs(obj.Reflectance - rec.applied.Reflectance) > 0.001 then
                rec.orig.Reflectance = obj.Reflectance
            end
            if rec.applied.CastShadow ~= nil and obj.CastShadow ~= rec.applied.CastShadow then
                rec.orig.CastShadow = obj.CastShadow
            end
        end

        local wantShadow = profile.Shadows and rec.orig.CastShadow or false
        if obj.CastShadow ~= wantShadow then
            obj.CastShadow = wantShadow
        end
        rec.applied.CastShadow = wantShadow

        if profile.SmoothMaterials then
            if obj.Material ~= Enum.Material.SmoothPlastic then
                obj.Material = Enum.Material.SmoothPlastic
            end
            if obj.MaterialVariant ~= "" then
                obj.MaterialVariant = ""
            end
            if obj.Reflectance ~= 0 then
                obj.Reflectance = 0
            end
            rec.applied.Material = Enum.Material.SmoothPlastic
            rec.applied.MaterialVariant = ""
            rec.applied.Reflectance = 0
            if obj:IsA("MeshPart") and rec.orig.TextureID and rec.orig.TextureID ~= "" then
                pcall(function() obj.TextureID = "" end)
                rec.applied.TextureID = ""
            end
        else
            if rec.applied.Material ~= nil and obj.Material == rec.applied.Material then
                obj.Material = rec.orig.Material
            end
            if rec.applied.MaterialVariant ~= nil and obj.MaterialVariant == rec.applied.MaterialVariant then
                obj.MaterialVariant = rec.orig.MaterialVariant
            end
            if rec.applied.Reflectance ~= nil and math.abs(obj.Reflectance - rec.applied.Reflectance) < 0.001 then
                obj.Reflectance = rec.orig.Reflectance
            end
            if obj:IsA("MeshPart") and rec.applied.TextureID ~= nil and obj.TextureID == rec.applied.TextureID then
                pcall(function() obj.TextureID = rec.orig.TextureID end)
            end
            rec.applied.Material = nil
            rec.applied.MaterialVariant = nil
            rec.applied.Reflectance = nil
            rec.applied.TextureID = nil
        end
        LowGraphicsState.ProcessedMode[obj] = mode

    elseif obj:IsA("SpecialMesh") then
        if obj.Parent and IsInCharacterSet(obj.Parent, charSet) then return end
        local rec = LowGraphicsState.ObjectRecords[obj]
        if not rec then
            rec = { orig = { TextureId = obj.TextureId }, applied = {} }
            LowGraphicsState.ObjectRecords[obj] = rec
        end
        if profile.SmoothMaterials then
            if obj.TextureId ~= "" then
                pcall(function() obj.TextureId = "" end)
            end
            rec.applied.TextureId = ""
        else
            if rec.applied.TextureId ~= nil and obj.TextureId == rec.applied.TextureId then
                pcall(function() obj.TextureId = rec.orig.TextureId end)
            end
            rec.applied.TextureId = nil
        end
        LowGraphicsState.ProcessedMode[obj] = mode

    elseif obj:IsA("Decal") or obj:IsA("Texture") then
        if IsInCharacterSet(obj, charSet) then return end
        local rec = LowGraphicsState.ObjectRecords[obj]
        if not rec then
            rec = { orig = { Transparency = obj.Transparency }, applied = {} }
            LowGraphicsState.ObjectRecords[obj] = rec
        elseif rec.applied.Transparency ~= nil and math.abs(obj.Transparency - rec.applied.Transparency) > 0.001 then
            rec.orig.Transparency = obj.Transparency
        end

        if profile.SmoothMaterials then
            if obj.Transparency ~= 1 then
                obj.Transparency = 1
            end
            rec.applied.Transparency = 1
        else
            if rec.applied.Transparency ~= nil and math.abs(obj.Transparency - rec.applied.Transparency) < 0.001 then
                obj.Transparency = rec.orig.Transparency
            end
            rec.applied.Transparency = nil
        end
        LowGraphicsState.ProcessedMode[obj] = mode

    elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
        if IsInCharacterSet(obj, charSet) then return end
        local rec = LowGraphicsState.ObjectRecords[obj]
        if not rec then
            rec = { orig = { Enabled = obj.Enabled }, applied = {} }
            LowGraphicsState.ObjectRecords[obj] = rec
        elseif rec.applied.Enabled ~= nil and obj.Enabled ~= rec.applied.Enabled then
            rec.orig.Enabled = obj.Enabled
        end

        if profile.DisableParticles then
            if obj.Enabled ~= false then
                obj.Enabled = false
            end
            rec.applied.Enabled = false
        else
            if rec.applied.Enabled ~= nil and obj.Enabled == rec.applied.Enabled then
                obj.Enabled = rec.orig.Enabled
            end
            rec.applied.Enabled = nil
        end
        LowGraphicsState.ProcessedMode[obj] = mode
    end
end

local function ProcessLowGFXPostEffect(fx, disable)
    if not fx or not fx.Parent or not fx:IsA("PostEffect") or fx.Name == "EssentialSkyCC" then return end
    local rec = LowGraphicsState.PostEffectRecords[fx]
    if not rec then
        rec = { origEnabled = fx.Enabled, appliedEnabled = nil }
        LowGraphicsState.PostEffectRecords[fx] = rec
    elseif rec.appliedEnabled ~= nil and fx.Enabled ~= rec.appliedEnabled then
        rec.origEnabled = fx.Enabled
    end

    if disable then
        if fx.Enabled ~= false then
            fx.Enabled = false
        end
        rec.appliedEnabled = false
    else
        if rec.appliedEnabled ~= nil and fx.Enabled == rec.appliedEnabled then
            fx.Enabled = rec.origEnabled
        end
        rec.appliedEnabled = nil
    end
end

local function DisconnectLowGFXListeners()
    if LowGraphicsState.DescendantConn then
        pcall(function() LowGraphicsState.DescendantConn:Disconnect() end)
        LowGraphicsState.DescendantConn = nil
    end
    if LowGraphicsState.LightingChildConn then
        pcall(function() LowGraphicsState.LightingChildConn:Disconnect() end)
        LowGraphicsState.LightingChildConn = nil
    end
    if LowGraphicsState.CameraChildConn then
        pcall(function() LowGraphicsState.CameraChildConn:Disconnect() end)
        LowGraphicsState.CameraChildConn = nil
    end
end

local function RestoreLowGraphics()
    LowGraphicsState.WorkerId = LowGraphicsState.WorkerId + 1
    LowGraphicsState.Active = false
    LowGraphicsState.AppliedMode = nil
    LowGraphicsState.QueueScheduled = false
    table.clear(LowGraphicsState.Queue)
    DisconnectLowGFXListeners()

    -- 1. Восстанавливаем все изменённые объекты карты (включая появившиеся во время работы LowGraphics)
    for obj, rec in pairs(LowGraphicsState.ObjectRecords) do
        RestoreSingleObjectRecord(obj, rec)
    end
    LowGraphicsState.ObjectRecords = setmetatable({}, { __mode = "k" })
    LowGraphicsState.ProcessedMode = setmetatable({}, { __mode = "k" })

    -- 2. Восстанавливаем PostEffects в Lighting и Camera
    for fx, rec in pairs(LowGraphicsState.PostEffectRecords) do
        if fx and fx.Parent and rec.appliedEnabled ~= nil and fx.Enabled == rec.appliedEnabled then
            fx.Enabled = rec.origEnabled
        end
    end
    LowGraphicsState.PostEffectRecords = setmetatable({}, { __mode = "k" })

    -- 3. Восстанавливаем Terrain
    local terrain = workspace:FindFirstChildOfClass("Terrain")
    local tSnap = LowGraphicsState.TerrainSnapshot
    if terrain and tSnap then
        if tSnap.appliedWaveSize ~= nil and math.abs(terrain.WaterWaveSize - tSnap.appliedWaveSize) < 0.001 then
            terrain.WaterWaveSize = tSnap.origWaveSize
        end
        if tSnap.appliedWaveSpeed ~= nil and math.abs(terrain.WaterWaveSpeed - tSnap.appliedWaveSpeed) < 0.001 then
            terrain.WaterWaveSpeed = tSnap.origWaveSpeed
        end
        if tSnap.appliedReflectance ~= nil and math.abs(terrain.WaterReflectance - tSnap.appliedReflectance) < 0.001 then
            terrain.WaterReflectance = tSnap.origReflectance
        end
    end
    LowGraphicsState.TerrainSnapshot = nil

    -- 4. Восстанавливаем настройки Lighting, если они не были изменены другой системой
    local lSnap = LowGraphicsState.LightingSnapshot
    if lSnap then
        if lSnap.appliedShadows ~= nil and Lighting.GlobalShadows == lSnap.appliedShadows then
            Lighting.GlobalShadows = lSnap.origShadows
        end
        if lSnap.origTech ~= nil and lSnap.appliedTech ~= nil then
            pcall(function()
                if Lighting.Technology == lSnap.appliedTech then
                    Lighting.Technology = lSnap.origTech
                end
            end)
        end
    end
    LowGraphicsState.LightingSnapshot = nil

    -- 5. Восстанавливаем пользовательские настройки рендеринга клиента
    local rSnap = LowGraphicsState.RenderingSnapshot
    if rSnap then
        pcall(function()
            if rSnap.origQuality ~= nil then
                settings().Rendering.QualityLevel = rSnap.origQuality
            end
        end)
        pcall(function()
            if rSnap.origMeshDetail ~= nil then
                settings().Rendering.MeshPartDetailLevel = rSnap.origMeshDetail
            end
        end)
        pcall(function()
            if Enum.TextureQuality and rSnap.origTextureQuality ~= nil then
                settings().Rendering.TextureQuality = rSnap.origTextureQuality
            end
        end)
    end
    LowGraphicsState.RenderingSnapshot = nil
end

local function EnsureLowGFXListeners()
    if not LowGraphicsState.DescendantConn then
        LowGraphicsState.DescendantConn = workspace.DescendantAdded:Connect(function(obj)
            if not Settings.LowGraphics or not LowGraphicsState.Active then return end
            if not (obj:IsA("BasePart") or obj:IsA("SpecialMesh") or obj:IsA("Decal") or obj:IsA("Texture")
                or obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
                or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles")) then
                return
            end
            table.insert(LowGraphicsState.Queue, obj)
            if not LowGraphicsState.QueueScheduled then
                LowGraphicsState.QueueScheduled = true
                local scheduledWorkerId = LowGraphicsState.WorkerId
                task.delay(0.2, function()
                    LowGraphicsState.QueueScheduled = false
                    if not Settings.LowGraphics or not LowGraphicsState.Active or LowGraphicsState.WorkerId ~= scheduledWorkerId then
                        table.clear(LowGraphicsState.Queue)
                        return
                    end
                    local mode = Settings.TextureQuality
                    local profile = GetTextureProfile(mode)
                    local charSet = BuildCharacterSet()
                    local q = LowGraphicsState.Queue
                    LowGraphicsState.Queue = {}
                    local sliceStart = os.clock()
                    for i = 1, #q do
                        if not Settings.LowGraphics or not LowGraphicsState.Active or LowGraphicsState.WorkerId ~= scheduledWorkerId then break end
                        ProcessLowGFXObject(q[i], mode, profile, charSet)
                        if i % 32 == 0 and os.clock() - sliceStart > 0.003 then
                            task.wait()
                            charSet = BuildCharacterSet()
                            sliceStart = os.clock()
                        end
                    end
                end)
            end
        end)
    end

    if not LowGraphicsState.LightingChildConn then
        LowGraphicsState.LightingChildConn = Lighting.ChildAdded:Connect(function(obj)
            if not Settings.LowGraphics or not LowGraphicsState.Active then return end
            if obj:IsA("PostEffect") and obj.Name ~= "EssentialSkyCC" then
                local profile = GetTextureProfile(Settings.TextureQuality)
                ProcessLowGFXPostEffect(obj, profile.DisablePostFX)
            end
        end)
    end

    local cam = workspace.CurrentCamera
    if cam and not LowGraphicsState.CameraChildConn then
        LowGraphicsState.CameraChildConn = cam.ChildAdded:Connect(function(obj)
            if not Settings.LowGraphics or not LowGraphicsState.Active then return end
            if obj:IsA("PostEffect") then
                local profile = GetTextureProfile(Settings.TextureQuality)
                ProcessLowGFXPostEffect(obj, profile.DisablePostFX)
            end
        end)
    end
end

local function ApplyLowGraphics()
    if not Settings.LowGraphics then return end
    local mode = Settings.TextureQuality
    local profile = GetTextureProfile(mode)

    -- Сохраняем исходные глобальные настройки только при первом включении режима
    if not LowGraphicsState.RenderingSnapshot then
        local rSnap = {}
        pcall(function() rSnap.origQuality = settings().Rendering.QualityLevel end)
        pcall(function() rSnap.origMeshDetail = settings().Rendering.MeshPartDetailLevel end)
        pcall(function()
            if settings().Rendering and settings().Rendering.TextureQuality ~= nil then
                rSnap.origTextureQuality = settings().Rendering.TextureQuality
            end
        end)
        LowGraphicsState.RenderingSnapshot = rSnap
    end

    if not LowGraphicsState.LightingSnapshot then
        local curTech = nil
        pcall(function() curTech = Lighting.Technology end)
        LowGraphicsState.LightingSnapshot = {
            origShadows = Lighting.GlobalShadows,
            origTech = curTech,
            appliedShadows = nil,
            appliedTech = nil
        }
    end

    local terrain = workspace:FindFirstChildOfClass("Terrain")
    if terrain and not LowGraphicsState.TerrainSnapshot then
        LowGraphicsState.TerrainSnapshot = {
            origWaveSize = terrain.WaterWaveSize,
            origWaveSpeed = terrain.WaterWaveSpeed,
            origReflectance = terrain.WaterReflectance,
            appliedWaveSize = 0,
            appliedWaveSpeed = 0,
            appliedReflectance = 0
        }
    end

    pcall(function() settings().Rendering.QualityLevel = profile.Quality end)
    pcall(function() settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel[profile.MeshDetail] end)
    pcall(function()
        if Enum.TextureQuality then
            settings().Rendering.TextureQuality = profile.SmoothMaterials and Enum.TextureQuality.Low or Enum.TextureQuality.Automatic
        end
    end)

    if Lighting.GlobalShadows ~= profile.Shadows then
        Lighting.GlobalShadows = profile.Shadows
    end
    LowGraphicsState.LightingSnapshot.appliedShadows = profile.Shadows

    pcall(function()
        if Lighting.Technology ~= profile.Tech then
            Lighting.Technology = profile.Tech
        end
        LowGraphicsState.LightingSnapshot.appliedTech = profile.Tech
    end)

    if terrain then
        terrain.WaterWaveSize = 0
        terrain.WaterWaveSpeed = 0
        terrain.WaterReflectance = 0
    end

    for _, fx in ipairs(Lighting:GetDescendants()) do
        if fx:IsA("PostEffect") then ProcessLowGFXPostEffect(fx, profile.DisablePostFX) end
    end
    if workspace.CurrentCamera then
        for _, fx in ipairs(workspace.CurrentCamera:GetDescendants()) do
            if fx:IsA("PostEffect") then ProcessLowGFXPostEffect(fx, profile.DisablePostFX) end
        end
    end

    EnsureLowGFXListeners()

    if LowGraphicsState.Active and LowGraphicsState.AppliedMode == mode then
        return
    end

    LowGraphicsState.Active = true
    LowGraphicsState.AppliedMode = mode
    LowGraphicsState.WorkerId = LowGraphicsState.WorkerId + 1
    local myWorkerId = LowGraphicsState.WorkerId

    task.spawn(function()
        task.wait(0.1)
        local objs = workspace:GetDescendants()
        local charSet = BuildCharacterSet()
        local sliceStart = os.clock()
        for i = 1, #objs do
            if not Settings.LowGraphics or not LowGraphicsState.Active or LowGraphicsState.WorkerId ~= myWorkerId then return end
            ProcessLowGFXObject(objs[i], mode, profile, charSet)
            if i % 32 == 0 and os.clock() - sliceStart > 0.003 then
                task.wait()
                charSet = BuildCharacterSet()
                sliceStart = os.clock()
            end
        end
    end)
end

local function RefreshLowGraphics()
    if UI_Elements._BulkLoading then UI_Elements._PendingLowGFX = true return end
    if Settings.LowGraphics then ApplyLowGraphics() else RestoreLowGraphics() end
end

-- ==============================================
-- FOV CONTROLLER: 70..120, live slider, no global metamethod hook
-- ==============================================
do
    local env=_G
    pcall(function() if type(getgenv)=="function" then env=getgenv() end end)
    if type(env._EssentialFOVCleanup)=="function" then pcall(env._EssentialFOVCleanup) end
    local F={closed=false,writing=false,camera=nil,cameraConn=nil,workspaceConn=nil,renderConn=nil,
        bound=false,originals=setmetatable({},{__mode="k"})}
    local function ClampFOV(value)
        value=tonumber(value) or 70
        if value~=value or value==math.huge or value==-math.huge then value=70 end
        return math.clamp(math.floor(value+0.5),70,120)
    end
    local function WriteFOV(cam,value)
        if not cam then return end
        F.writing=true
        local ok,err=pcall(function()
            if math.abs(cam.FieldOfView-value)>0.001 then cam.FieldOfView=value end
        end)
        F.writing=false
        if not ok then warn("[Essential FOV] "..tostring(err)) end
    end
    local function RestoreFOV(cam)
        local value=cam and F.originals[cam]
        if value~=nil then WriteFOV(cam,value) end
    end
    local function ApplyFOV()
        if F.closed or not Settings.FOVEnabled or F.writing then return end
        local cam=workspace.CurrentCamera
        if not cam then return end
        if F.originals[cam]==nil then F.originals[cam]=cam.FieldOfView end
        Settings.FOV=ClampFOV(Settings.FOV)
        WriteFOV(cam,Settings.FOV)
    end
    local function BindCamera(cam)
        if F.camera==cam and F.cameraConn then return end
        if F.cameraConn then F.cameraConn:Disconnect() F.cameraConn=nil end
        local old=F.camera F.camera=cam
        if old and old~=cam and Settings.FOVEnabled then RestoreFOV(old) end
        if not cam then return end
        if F.originals[cam]==nil then F.originals[cam]=cam.FieldOfView end
        F.cameraConn=cam:GetPropertyChangedSignal("FieldOfView"):Connect(function()
            if F.closed or F.writing or F.camera~=cam then return end
            local actual=cam.FieldOfView
            if not Settings.FOVEnabled then
                F.originals[cam]=actual
            elseif math.abs(actual-ClampFOV(Settings.FOV))>0.001 then
                -- Preserve a newer game target for disable, then keep the enabled slider target visible.
                F.originals[cam]=actual
                ApplyFOV()
            end
        end)
        ApplyFOV()
    end
    UI_Elements._SetFOVValue=function(value)
        if F.closed then return end
        Settings.FOV=ClampFOV(value)
        BindCamera(workspace.CurrentCamera)
        ApplyFOV()
    end
    UI_Elements._SetFOVEnabled=function(enabled)
        if F.closed then return end
        local wasEnabled=Settings.FOVEnabled
        local cam=workspace.CurrentCamera
        BindCamera(cam)
        if enabled==true and not wasEnabled and cam then F.originals[cam]=cam.FieldOfView end
        Settings.FOVEnabled=enabled==true
        if Settings.FOVEnabled then ApplyFOV() else RestoreFOV(cam) end
    end
    UI_Elements._CleanupFOV=function()
        if F.closed then return end
        F.closed=true Settings.FOVEnabled=false
        if F.cameraConn then F.cameraConn:Disconnect() F.cameraConn=nil end
        if F.workspaceConn then F.workspaceConn:Disconnect() F.workspaceConn=nil end
        if F.renderConn then F.renderConn:Disconnect() F.renderConn=nil end
        if F.bound then pcall(function() RunService:UnbindFromRenderStep("EssentialFOVLock") end) F.bound=false end
        RestoreFOV(F.camera)
        if env._EssentialFOVCleanup==UI_Elements._CleanupFOV then env._EssentialFOVCleanup=nil end
    end
    env._EssentialFOVCleanup=UI_Elements._CleanupFOV
    BindCamera(workspace.CurrentCamera)
    F.workspaceConn=workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
        if F.closed then return end
        BindCamera(workspace.CurrentCamera)
        if Settings.LowGraphics and LowGraphicsState.Active then
            if LowGraphicsState.CameraChildConn then LowGraphicsState.CameraChildConn:Disconnect() LowGraphicsState.CameraChildConn=nil end
            EnsureLowGFXListeners()
        end
    end)
    table.insert(connections,F.workspaceConn)
    pcall(function() RunService:UnbindFromRenderStep("EssentialFOVLockEarly") end)
    pcall(function() RunService:UnbindFromRenderStep("EssentialFOVLock") end)
    local ok=pcall(function()
        RunService:BindToRenderStep("EssentialFOVLock",Enum.RenderPriority.Last.Value+1,function()
            if not F.closed then BindCamera(workspace.CurrentCamera) ApplyFOV() end
        end)
    end)
    F.bound=ok
    if not ok then
        F.renderConn=RunService.RenderStepped:Connect(function()
            if not F.closed then BindCamera(workspace.CurrentCamera) ApplyFOV() end
        end)
        table.insert(connections,F.renderConn)
    end
end

