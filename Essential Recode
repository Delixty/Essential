    if not SkyboxState.ApplyingPreset and Settings.SkyPreset ~= "Custom" then
        Settings.SkyPreset = "Custom"
        if UI_Elements.presetDropdown then UI_Elements.presetDropdown("Custom", true) end
    end
    if Settings.SkyEnabled then EnforceSkybox() end
end

