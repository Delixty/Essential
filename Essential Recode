local SkyboxState, EnforceSkybox, ResetSkybox
UI_Elements._InitSkybox = function()
local skyboxDropdown = CreateDropdownSection(VisualPage, "Custom Skybox")
SkyboxState = {
    RemovedAtmospheres = {},
    RemovedSkies = {},
    OrigSkyTextures = nil,
    CustomSky = nil,
    CustomAtmosphere = nil,
    CustomSkyCC = nil,
    ChildAddedConn = nil,
    ApplyingPreset = false
}

local function CaptureOriginalSkyTextures(skyObj)
    if SkyboxState.OrigSkyTextures or not skyObj then return end
    SkyboxState.OrigSkyTextures = {
        Bk = skyObj.SkyboxBk, Dn = skyObj.SkyboxDn, Ft = skyObj.SkyboxFt,
        Lf = skyObj.SkyboxLf, Rt = skyObj.SkyboxRt, Up = skyObj.SkyboxUp,
        Sun = skyObj.SunTextureId, Moon = skyObj.MoonTextureId
    }
end

local function EnsureCustomSky()
    local foundCustom, foundAtmo, foundCC = nil, nil, nil
    for _, obj in ipairs(Lighting:GetChildren()) do
        if obj:IsA("Sky") then
            if obj.Name == "EssentialCustomSky" then
                foundCustom = obj
            else
                CaptureOriginalSkyTextures(obj)
                if not table.find(SkyboxState.RemovedSkies, obj) then
                    table.insert(SkyboxState.RemovedSkies, obj)
                end
                pcall(function() obj.Parent = nil end)
            end
        elseif obj:IsA("Atmosphere") then
            if obj.Name == "EssentialCustomAtmosphere" then
                foundAtmo = obj
            else
                if not table.find(SkyboxState.RemovedAtmospheres, obj) then
                    table.insert(SkyboxState.RemovedAtmospheres, obj)
                end
                pcall(function() obj.Parent = nil end)
            end
        elseif obj:IsA("ColorCorrectionEffect") and obj.Name == "EssentialSkyCC" then
            foundCC = obj
        end
    end

    if not foundCustom or foundCustom.Parent ~= Lighting then
        local ns = SkyboxState.CustomSky or Instance.new("Sky")
        ns.Name = "EssentialCustomSky"
        -- Используем валидные 3D-грани исходного неба (или встроенную кубмапу Roblox), чтобы купол неба не смещался при наклоне камеры
        if SkyboxState.OrigSkyTextures then
            local t = SkyboxState.OrigSkyTextures
            ns.SkyboxBk = t.Bk ns.SkyboxDn = t.Dn ns.SkyboxFt = t.Ft
            ns.SkyboxLf = t.Lf ns.SkyboxRt = t.Rt ns.SkyboxUp = t.Up
            ns.SunTextureId = t.Sun ns.MoonTextureId = t.Moon
        end
        pcall(function() ns.Parent = Lighting end)
        SkyboxState.CustomSky = ns
        foundCustom = ns
    else
        SkyboxState.CustomSky = foundCustom
    end

    if not foundAtmo or foundAtmo.Parent ~= Lighting then
        local na = SkyboxState.CustomAtmosphere or Instance.new("Atmosphere")
        na.Name = "EssentialCustomAtmosphere"
        pcall(function() na.Parent = Lighting end)
        SkyboxState.CustomAtmosphere = na
        foundAtmo = na
    else
        SkyboxState.CustomAtmosphere = foundAtmo
    end

    if not foundCC or foundCC.Parent ~= Lighting then
        local ncc = SkyboxState.CustomSkyCC or Instance.new("ColorCorrectionEffect")
        ncc.Name = "EssentialSkyCC"
        pcall(function() ncc.Parent = Lighting end)
        SkyboxState.CustomSkyCC = ncc
        foundCC = ncc
    else
        SkyboxState.CustomSkyCC = foundCC
    end

    return foundCustom, foundAtmo, foundCC
end

EnforceSkybox = function()
    if not Settings.SkyEnabled then return end
    local sky, atmo, cc = EnsureCustomSky()
    local skyCol = Color3.fromRGB(Settings.SkyR, Settings.SkyG, Settings.SkyB)
    local horCol = Color3.fromRGB(Settings.HorR, Settings.HorG, Settings.HorB)
    local ambCol = Color3.fromRGB(
        math.clamp(math.floor(Settings.SkyR * 0.45 + Settings.HorR * 0.2), 0, 255),
        math.clamp(math.floor(Settings.SkyG * 0.45 + Settings.HorG * 0.2), 0, 255),
        math.clamp(math.floor(Settings.SkyB * 0.45 + Settings.HorB * 0.2), 0, 255)
    )
    pcall(function()
        if sky then
            if sky.StarCount ~= SkySettings.StarCount then sky.StarCount = SkySettings.StarCount end
            if sky.SunAngularSize ~= SkySettings.SunAngularSize then sky.SunAngularSize = SkySettings.SunAngularSize end
            if sky.MoonAngularSize ~= SkySettings.MoonAngularSize then sky.MoonAngularSize = SkySettings.MoonAngularSize end
            if sky.CelestialBodiesShown ~= SkySettings.CelestialBodiesShown then sky.CelestialBodiesShown = SkySettings.CelestialBodiesShown end
            pcall(function() sky.SkyboxOrientation = Vector3.zero end)
        end
        if atmo then
            -- Полное покрытие сферического купола (Haze = 10, Offset = 0, Glare = 0) предотвращает смещение цвета при взгляде вверх/вниз
            if atmo.Density ~= 0.35 then atmo.Density = 0.35 end
            if atmo.Offset ~= 0 then atmo.Offset = 0 end
            if atmo.Haze ~= 10 then atmo.Haze = 10 end
            if atmo.Glare ~= 0 then atmo.Glare = 0 end
            if atmo.Color ~= skyCol then atmo.Color = skyCol end
            if atmo.Decay ~= horCol then atmo.Decay = horCol end
        end
        if cc then
            if not cc.Enabled then cc.Enabled = true end
            local targetTint = skyCol:Lerp(Color3.fromRGB(255, 255, 255), 0.65)
            local targetBright = (Settings.SkyBright - 50) / 250
            if cc.TintColor ~= targetTint then cc.TintColor = targetTint end
            if math.abs(cc.Brightness - targetBright) > 0.001 then cc.Brightness = targetBright end
            if cc.Contrast ~= 0.05 then cc.Contrast = 0.05 end
            if cc.Saturation ~= 0.1 then cc.Saturation = 0.1 end
        end

        local targetBrightness = (Settings.SkyBright / 100) * 6
        local targetExposure = (Settings.SkyExp / 100) * 2 - 1
        if math.abs(Lighting.Brightness - targetBrightness) > 0.001 then Lighting.Brightness = targetBrightness end
        if math.abs(Lighting.ExposureCompensation - targetExposure) > 0.001 then Lighting.ExposureCompensation = targetExposure end
        if Lighting.ColorShift_Top ~= skyCol then Lighting.ColorShift_Top = skyCol end
        if Lighting.ColorShift_Bottom ~= horCol then Lighting.ColorShift_Bottom = horCol end
        if Lighting.OutdoorAmbient ~= horCol then Lighting.OutdoorAmbient = horCol end
        if Lighting.Ambient ~= ambCol then Lighting.Ambient = ambCol end
        if math.abs(Lighting.ClockTime - Settings.SkyClock) > 0.001 then Lighting.ClockTime = Settings.SkyClock end
        if not Settings.CustomFog then
            if Lighting.FogColor ~= horCol then Lighting.FogColor = horCol end
            if Lighting.FogStart ~= 50000 then Lighting.FogStart = 50000 end
            if Lighting.FogEnd ~= 100000 then Lighting.FogEnd = 100000 end
        end
    end)
end

local function EnableSkyboxListeners()
    if SkyboxState.ChildAddedConn then return end
    SkyboxState.ChildAddedConn = Lighting.ChildAdded:Connect(function(child)
        if not Settings.SkyEnabled then return end
        if (child:IsA("Sky") and child.Name ~= "EssentialCustomSky")
            or (child:IsA("Atmosphere") and child.Name ~= "EssentialCustomAtmosphere") then
            task.defer(EnforceSkybox)
        end
    end)
end

ResetSkybox = function()
    if SkyboxState.ChildAddedConn then
        pcall(function() SkyboxState.ChildAddedConn:Disconnect() end)
        SkyboxState.ChildAddedConn = nil
    end
    pcall(function()
        if SkyboxState.CustomSky then pcall(function() SkyboxState.CustomSky:Destroy() end) SkyboxState.CustomSky = nil end
        if SkyboxState.CustomAtmosphere then pcall(function() SkyboxState.CustomAtmosphere:Destroy() end) SkyboxState.CustomAtmosphere = nil end
        if SkyboxState.CustomSkyCC then pcall(function() SkyboxState.CustomSkyCC:Destroy() end) SkyboxState.CustomSkyCC = nil end
        for _, obj in ipairs(Lighting:GetChildren()) do
            if (obj:IsA("Sky") and obj.Name == "EssentialCustomSky")
                or (obj:IsA("Atmosphere") and obj.Name == "EssentialCustomAtmosphere")
                or (obj:IsA("ColorCorrectionEffect") and obj.Name == "EssentialSkyCC") then
                pcall(function() obj:Destroy() end)
            end
        end
        for _, sk in ipairs(SkyboxState.RemovedSkies) do
            pcall(function() if sk and sk.Parent == nil then sk.Parent = Lighting end end)
        end
        for _, atmo in ipairs(SkyboxState.RemovedAtmospheres) do
            pcall(function() if atmo and atmo.Parent == nil then atmo.Parent = Lighting end end)
        end
        if DefaultAtmosphere and DefaultAtmosphere.Parent == nil then
            pcall(function() DefaultAtmosphere.Parent = Lighting end)
        end
        Lighting.Brightness = DefaultLighting.Brightness
        Lighting.ExposureCompensation = DefaultLighting.ExposureCompensation
        Lighting.Ambient = DefaultLighting.Ambient
        Lighting.OutdoorAmbient = DefaultLighting.OutdoorAmbient
        Lighting.ColorShift_Top = DefaultLighting.ColorShift_Top
        Lighting.ColorShift_Bottom = DefaultLighting.ColorShift_Bottom
        Lighting.ClockTime = DefaultLighting.ClockTime
        if not Settings.CustomFog then
            Lighting.FogColor = DefaultLighting.FogColor
            Lighting.FogStart = DefaultLighting.FogStart
            Lighting.FogEnd = DefaultLighting.FogEnd
        end
    end)
end

