local LowGraphicsState = {
    Active = false,
    AppliedMode = nil,
    WorkerId = 0,
    QueueScheduled = false,
    Queue = {},
    DescendantConn = nil,
    LightingChildConn = nil,
    CameraChildConn = nil,
    RenderingSnapshot = nil,
    LightingSnapshot = nil,
    TerrainSnapshot = nil,
    -- Хранит для каждого изменённого объекта таблицу { orig = {...}, applied = {...} }
