    if mode == "Performance" then
        return {
            Quality = Enum.QualityLevel.Level01,
            MeshDetail = "Level01",
            Shadows = false,
            Tech = Enum.Technology.Legacy,
            SmoothMaterials = true,
            DisableParticles = true,
            DisablePostFX = true
        }
    elseif mode == "Quality" then
        return {
            Quality = Enum.QualityLevel.Level05,
            MeshDetail = "Level03",
            Shadows = true,
            Tech = Enum.Technology.ShadowMap,
            SmoothMaterials = false,
            DisableParticles = false,
