local function CreatePillPositionSelector(parent, defaultPos, callback)
    local container = Instance.new("Frame", parent)
    container.Size = UDim2.new(1, 0, 0, 146)
    container.BackgroundColor3 = BgElement
    Instance.new("UICorner", container).CornerRadius = UDim.new(0, 8)
    local stroke = Instance.new("UIStroke", container) stroke.Thickness = 1
    table.insert(ThemeElements.DarkStrokes, stroke)

    local titleLbl = Instance.new("TextLabel", container)
    titleLbl.Size = UDim2.new(1, -24, 0, 26)
    titleLbl.Position = UDim2.new(0, 12, 0, 6)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Text = "Pill Position"
    titleLbl.TextColor3 = TextColor
    titleLbl.TextSize = 13
    titleLbl.Font = Enum.Font.GothamSemibold
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left

    local gridFrame = Instance.new("Frame", container)
    gridFrame.Size = UDim2.new(1, -24, 0, 102)
    gridFrame.Position = UDim2.new(0, 12, 0, 34)
    gridFrame.BackgroundTransparency = 1

    local grid = Instance.new("UIGridLayout", gridFrame)
    grid.CellSize = UDim2.new(0.32, 0, 0, 47)
    grid.CellPadding = UDim2.new(0.02, 0, 0, 8)
    grid.SortOrder = Enum.SortOrder.LayoutOrder

    local options = {
        { id = "TopLeft",      label = "Top Left",      ax = 0,   ay = 0,   px = 0,   py = 0 },
        { id = "TopCenter",    label = "Top Center",    ax = 0.5, ay = 0,   px = 0.5, py = 0 },
        { id = "TopRight",     label = "Top Right",     ax = 1,   ay = 0,   px = 1,   py = 0 },
        { id = "BottomLeft",   label = "Bottom Left",   ax = 0,   ay = 1,   px = 0,   py = 1 },
        { id = "BottomCenter", label = "Bottom Center", ax = 0.5, ay = 1,   px = 0.5, py = 1 },
        { id = "BottomRight",  label = "Bottom Right",  ax = 1,   ay = 1,   px = 1,   py = 1 }
    }

    local cards = {}
    local currentSelected = defaultPos or "BottomCenter"

    local function updateVisuals(baseCol, strokeMainCol, strokeDarkCol)
        baseCol = baseCol or Color3.fromRGB(Settings.AccentR, Settings.AccentG, Settings.AccentB)
        local h, s, v = Color3.toHSV(baseCol)
        strokeMainCol = strokeMainCol or Color3.fromHSV(h, s, math.clamp(v - 0.25, 0, 1))
        strokeDarkCol = strokeDarkCol or Color3.fromHSV(h, s, math.clamp(v - 0.6, 0.1, 1))
        for id, c in pairs(cards) do
            local active = (id == currentSelected)
            c.stroke.Color = active and strokeMainCol or strokeDarkCol
            c.stroke.Thickness = active and 1.5 or 1
            c.dot.BackgroundColor3 = active and baseCol or TextMuted
            c.lbl.TextColor3 = active and TextColor or TextMuted
            c.screenStroke.Color = active and strokeMainCol or Color3.fromRGB(55, 55, 65)
        end
    end

    UI_Elements.RefreshPillSelectorTheme = updateVisuals

    local function selectPosition(posId, silent)
        currentSelected = posId
        updateVisuals()
        if not silent then callback(posId) end
    end

    for idx, opt in ipairs(options) do
        local btn = Instance.new("TextButton", gridFrame)
        btn.LayoutOrder = idx
        btn.BackgroundColor3 = BgDark
        btn.Text = ""
        btn.AutoButtonColor = false
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
        local cStroke = Instance.new("UIStroke", btn)
        cStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

        local miniScreen = Instance.new("Frame", btn)
        miniScreen.Size = UDim2.new(0, 34, 0, 22)
        miniScreen.Position = UDim2.new(0, 8, 0.5, -11)
        miniScreen.BackgroundColor3 = Color3.fromRGB(14, 14, 18)
        Instance.new("UICorner", miniScreen).CornerRadius = UDim.new(0, 3)
        local sStroke = Instance.new("UIStroke", miniScreen)
        sStroke.Thickness = 1

        local pad = Instance.new("UIPadding", miniScreen)
        pad.PaddingTop = UDim.new(0, 3)
        pad.PaddingBottom = UDim.new(0, 3)
        pad.PaddingLeft = UDim.new(0, 3)
        pad.PaddingRight = UDim.new(0, 3)

        local dot = Instance.new("Frame", miniScreen)
        dot.Size = UDim2.new(0, 10, 0, 4)
        dot.AnchorPoint = Vector2.new(opt.ax, opt.ay)
        dot.Position = UDim2.new(opt.px, 0, opt.py, 0)
        Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

        local lbl = Instance.new("TextLabel", btn)
        lbl.Size = UDim2.new(1, -50, 1, 0)
        lbl.Position = UDim2.new(0, 48, 0, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = opt.label
        lbl.TextSize = 11
        lbl.Font = Enum.Font.GothamBold
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.TextWrapped = true

        cards[opt.id] = { btn = btn, stroke = cStroke, dot = dot, lbl = lbl, screenStroke = sStroke }
        btn.MouseButton1Click:Connect(function() selectPosition(opt.id, false) end)
    end

    updateVisuals()
    return selectPosition
end

