local function UpdateGlobalSearch()
    local rawQuery = SearchInput.Text or ""
    local query = string.lower((rawQuery:gsub("^%s+", ""):gsub("%s+$", "")))

    if query == "" then
        SearchResultsFrame.Visible = false
        NoResultsLabel.Visible = false
        for _, t in ipairs(tabs) do
            t.page.Visible = (t == activeTabEntry)
        end
        return
    end

    for _, t in ipairs(tabs) do
        t.page.Visible = false
    end
    SearchResultsFrame.Visible = true

    local matchCount = 0
    for idx, item in ipairs(SearchableElements) do
        if item.resultBtn and item.resultBtn.Parent then
            local nameMatch = string.find(item.titleLower, query, 1, true) ~= nil
            local catMatch = string.find(item.categoryLower, query, 1, true) ~= nil
            local matched = nameMatch or catMatch
            item.resultBtn.Visible = matched
            if matched then
                matchCount = matchCount + 1
                item.resultBtn.LayoutOrder = (nameMatch and 0 or 1000) + idx
            end
        end
    end

    SearchScroll.Visible = (matchCount > 0)
    NoResultsLabel.Visible = (matchCount == 0)
end

