        mFrame.Name = "FavMirror" mFrame.LayoutOrder = order
        for _, rec in ipairs(records) do
            local a = rec.args
            if rec.kind == "toggle" then
                table.insert(rec.mirrors, CreateToggle(mc, a[1], rec.getter(), function(v) rec.setter(v) end))
            elseif rec.kind == "slider" then
                table.insert(rec.mirrors, CreateSlider(mc, a[1], a[2], a[3], rec.getter(), function(v) rec.setter(v) end))
            elseif rec.kind == "dropdown" then
                table.insert(rec.mirrors, CreateDropdown(mc, a[1], a[2], rec.getter(), function(v) rec.setter(v) end))
            elseif rec.kind == "label" then
                table.insert(rec.mirrors, CreateLabel(mc, rec.getter()))
            elseif rec.kind == "button" then
                CreateButton(mc, a[1], a[2], a[3])
            elseif rec.kind == "input" then
                CreateInput(mc, a[1], function(txt) rec.setter(txt) end)
            end
        end
        local header = mFrame:FindFirstChildOfClass("TextButton")
        UI_Elements._Mirroring = false
        UI_Elements._NewHeart(mFrame, key, UDim2.new(1, -88, 0, 21))
        if header then UI_Elements._OnRightClick(header, function() task.defer(function() UI_Elements._ToggleFavorite(key) end) end) end
        pcall(function() UI_Elements._Search.Sections[mc].setOpen(true, true) end)
    end)
    UI_Elements._Mirroring = false
    UI_Elements._Search.Register = oldRegister
    if not ok then warn("[Essential favorites] " .. tostring(err)) end
    return ok
end

