            dot.BorderSizePixel = 0
            dot.ZIndex = 3
            Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
            extraIcon = dot
        elseif opt.id == "Winter" then
            local wdot = Instance.new("Frame", btn)
            wdot.Size = UDim2.fromOffset(7, 7)
            wdot.Position = UDim2.new(0, 10, 0, 8)
            wdot.BackgroundColor3 = Color3.fromRGB(95, 200, 255)
            wdot.BorderSizePixel = 0
            wdot.ZIndex = 3
            Instance.new("UICorner", wdot).CornerRadius = UDim.new(1, 0)
            -- Маленькая снежинка рядом с названием Winter
