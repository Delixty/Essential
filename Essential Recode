local function UnloadScript()
    local function step(fn)
        local ok, err = pcall(fn)
        if not ok then warn("[Essential unload] " .. tostring(err)) end
    end
    UI_Elements._BulkLoading = false
    UI_Elements._PendingSky, UI_Elements._PendingLowGFX, UI_Elements._PendingWorldESP = nil, nil, nil

    for _, name in ipairs({ "_CleanupWorldESP", "_CleanupObjectESP", "_CleanupFOV", "_CleanupMovement", "_CleanupSmootherMovement", "_CleanupBackground", "_CleanupSoundPlayer", "_StopMoonwalk" }) do
        step(function() if UI_Elements[name] then UI_Elements[name]() end end)
    end
    step(function() if UI_Elements._SetNoStopEmote then UI_Elements._SetNoStopEmote(false) end end)
    step(function() mainMenuRevision = mainMenuRevision + 1 if mainMenuTween then mainMenuTween:Cancel() mainMenuTween = nil end end)

    for _, conn in ipairs(connections) do if conn then step(function() conn:Disconnect() end) end end
    table.clear(connections)
    step(function() if noclipConnection then noclipConnection:Disconnect() noclipConnection = nil end end)
    step(function() RunService:UnbindFromRenderStep("EssentialFOVLockEarly") end)
    step(function() RunService:UnbindFromRenderStep("EssentialFOVLock") end)

    step(function() Settings.Noclip = false RestoreNoclipCollisions() end)
    step(function() Settings.SkyEnabled = false Settings.CustomFog = false if UI_Elements._CleanupEnvironment then UI_Elements._CleanupEnvironment() end end)
    step(function() Settings.LowGraphics = false RestoreLowGraphics() end)
    step(function() TerminateEssentialHUD() end)
    step(function() if currentLight then currentLight:Destroy() currentLight = nil end end)
    step(function() if CrosshairCenter then CrosshairCenter:Destroy() end end)

    step(function()
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildWhichIsA("Humanoid")
            if hum then hum.AutoRotate = true end
            local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
            local def = char:GetAttribute("_EssentialDefaultTorsoCollide")
            if torso and def ~= nil then torso.CanCollide = def end
            char:SetAttribute("_EssentialDefaultTorsoCollide", nil)
        end
    end)

    for _, p in pairs(Players:GetPlayers()) do
        step(function()
            if p.Character then
                for _, n in ipairs({ "EssentialESP", "EssentialNameTag" }) do
                    local o = p.Character:FindFirstChild(n)
                    if o then o:Destroy() end
                end
            end
        end)
    end
    step(function()
        for _, list in ipairs({ trackedGenerators, trackedPallets, trackedHooks, trackedGates }) do
            for _, obj in ipairs(list) do
                if obj and obj.Parent then
                    for _, n in ipairs({ "EssentialESP", "EssentialGenTag" }) do
                        local o = obj:FindFirstChild(n)
                        if o then o:Destroy() end
                    end
                end
            end
        end
    end)
    step(function()
        for _, d in ipairs(workspace:GetDescendants()) do
            if string.sub(d.Name, 1, 9) == "Essential"
                and (d:IsA("Highlight") or d:IsA("BillboardGui") or d:IsA("BoxHandleAdornment") or d:IsA("SelectionBox") or d:IsA("SurfaceGui") or d:IsA("Folder")) then
                d:Destroy()
            end
        end
        for _, n in ipairs({ "EssentialCustomSky", "EssentialCustomAtmosphere", "EssentialSkyCC" }) do
            local o = Lighting:FindFirstChild(n)
            if o then o:Destroy() end
        end
        local snd = game:GetService("SoundService"):FindFirstChild("EssentialLocalSoundPlayer")
        if snd then snd:Destroy() end
    end)

    step(function() ScreenGui:Destroy() end)
    step(function()
        for _, root in ipairs({ CoreGui, PlayerGui }) do
            if root then
                for _, v in ipairs(root:GetChildren()) do
                    if v.Name == "EssentialUI" then v:Destroy() end
                end
            end
        end
    end)
end
