local function CreateKeybind(parent, text, defaultKey, callback)
    local frame = Instance.new("Frame", parent) frame.Size = UDim2.new(1, 0, 0, 42) frame.BackgroundColor3 = BgElement Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)
