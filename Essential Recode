local function RestoreNoclipCollisions()
    if LocalPlayer.Character then for partId, originalState in pairs(noclipOriginalCollide) do if partId and partId.Parent then partId.CanCollide = originalState end end end noclipOriginalCollide = {}
end
local function ApplyNoclip()
    if not LocalPlayer.Character then return end
    for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do if part:IsA("BasePart") then if noclipOriginalCollide[part] == nil then noclipOriginalCollide[part] = part.CanCollide end part.CanCollide = false end end
end
-- Умный noclip: коллизии отключаются только когда впереди стена (и ещё 0.6 с после неё).
-- В обычной ходьбе физика остаётся штатной — меньше расхождений с сервером и меньше откатов назад.
local NoclipState = { holdUntil = 0, active = false, params = RaycastParams.new() }
NoclipState.params.FilterType = Enum.RaycastFilterType.Exclude
local function NoclipObstacleAhead(char, hum, hrp)
    local dir = hum.MoveDirection
    if dir.Magnitude < 0.05 then return false end
    dir = Vector3.new(dir.X, 0, dir.Z)
    if dir.Magnitude < 0.05 then return false end
    dir = dir.Unit
    NoclipState.params.FilterDescendantsInstances = { char }
    local reach = 2.2 + math.clamp(hrp.AssemblyLinearVelocity.Magnitude * 0.12, 0, 4)
    for _, yOff in ipairs({ 1.2, 0, -0.8 }) do
        local hit = workspace:Raycast(hrp.Position + Vector3.new(0, yOff, 0), dir * reach, NoclipState.params)
        if hit and hit.Instance and hit.Instance.CanCollide then
            -- пол/наклон не считаем стеной
            if math.abs(hit.Normal.Y) < 0.6 then return true end
        end
    end
    return false
end
local function NoclipStep()
    if not Settings.Noclip then return end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildWhichIsA("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not char or not hum or not hrp then return end
    local now = os.clock()
    if NoclipObstacleAhead(char, hum, hrp) then NoclipState.holdUntil = now + 0.6 end
    if now < NoclipState.holdUntil then
        NoclipState.active = true
        ApplyNoclip()
    elseif NoclipState.active then
        NoclipState.active = false
        RestoreNoclipCollisions()
    end
end
