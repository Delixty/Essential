    local volumeHit=Instance.new("TextButton",volumeBar) volumeHit.BackgroundTransparency=1 volumeHit.Text=""
    volumeHit.Size=UDim2.new(1,0,0,20) volumeHit.Position=UDim2.new(0,0,0.5,-10) volumeHit.ZIndex=3
    local drag=Instance.new("TextButton",expanded) drag.Name="DragHandle" drag.Text="" drag.BackgroundTransparency=1 drag.ZIndex=4
    local smallTitle=text(small,"Sound Player",11) smallTitle.Font=Enum.Font.GothamBold rect(smallTitle,12,8,112,18)
    local smallDot=Instance.new("Frame",small) smallDot.Size=UDim2.fromOffset(5,5) smallDot.Position=UDim2.fromOffset(133,15)
    rounded(smallDot,3) table.insert(ThemeElements.Texts,smallDot)
    local smallHandle=Instance.new("TextButton",small) smallHandle.Text="" smallHandle.BackgroundTransparency=1
    smallHandle.Size=UDim2.fromScale(1,1) smallHandle.ZIndex=4

    local function getViewport()
        local v=ScreenGui.AbsoluteSize
        if v.X<=0 or v.Y<=0 then local cam=workspace.CurrentCamera v=cam and cam.ViewportSize or Vector2.new(1280,720) end
        return v
    end
    local function safePosition(size,sc)
        local vp=getViewport()
        local mx=math.max(8,vp.X-size.X*sc-8) local my=math.max(8,vp.Y-size.Y*sc-8)
        return Vector2.new(math.clamp(state.fraction.X*vp.X,8,mx),math.clamp(state.fraction.Y*vp.Y,8,my))
    end
    local function cancelTweens()
        state.animation=state.animation+1
        for _,tw in ipairs(state.tweens) do tw:Cancel() end
        state.tweens={}
    end
    local function tween(obj,props)
        local tw=TweenService:Create(obj,TweenInfo.new(0.23,Enum.EasingStyle.Quart,Enum.EasingDirection.Out),props)
        state.tweens[#state.tweens+1]=tw tw:Play() return tw
    end
    local function layout(mode)
        local p=layouts[mode]
        if mode=="Compact" then
            art.Visible=true artist.Visible=true
            rect(art,10,10,46,46) rect(title,66,10,200,20) rect(artist,66,31,200,17) rect(clock,66,49,155,15)
            rect(bars,271,29,26,24) rect(progress,10,71,296,3)
            rect(input,10,83,192,25) rect(play,208,83,45,25) rect(pause,259,83,47,25)
            rect(volumeLabel,10,116,28,16) rect(volumeBar,43,122,263,4) rect(drag,8,6,300,60)
        elseif mode=="Mini" then
            art.Visible=true artist.Visible=false
            rect(art,8,9,30,30) rect(title,46,7,148,18) rect(clock,46,26,148,14)
            rect(bars,208,20,22,18) rect(progress,8,48,238,3)
            rect(input,8,60,130,23) rect(play,144,60,48,23) rect(pause,198,60,48,23)
            rect(volumeLabel,8,92,24,14) rect(volumeBar,37,98,209,4) rect(drag,6,3,244,40)
        else
            art.Visible=false artist.Visible=true
            rect(title,10,10,214,21) rect(artist,10,31,214,16) rect(clock,10,49,190,14)
            rect(bars,232,28,24,24) rect(progress,10,69,256,3)
            rect(input,10,80,138,23) rect(play,154,80,50,23) rect(pause,210,80,56,23)
            rect(volumeLabel,10,110,24,13) rect(volumeBar,41,116,225,4) rect(drag,8,3,260,61)
        end
        if mode=="Sound Player" then title.Text="Sound Player" artist.Text=state.title
        else title.Text=state.title artist.Text=state.artist end
    end
    local function render(animate)
        if state.closed then return end
        cancelTweens()
        local revision=state.animation
        layout(state.mode)
        local p=layouts[state.mode]
        local target=state.collapsed and Vector2.new(164,38) or Vector2.new(p.w,p.h)
        local vp=getViewport()
        -- Fit the largest view, so expanding at an edge never pushes the card off-screen.
        state.scale=math.min(1,math.max(0.1,(vp.X-16)/p.w),math.max(0.1,(vp.Y-16)/p.h))
        scale.Scale=state.scale
        local position=safePosition(Vector2.new(p.w,p.h),state.scale)
        state.safe=position state.size=target
        expanded.Visible=true small.Visible=true
        local radius=state.collapsed and 19 or 16
        if animate and pill.Visible then
            tween(pill,{Size=UDim2.fromOffset(target.X,target.Y),Position=UDim2.fromOffset(position.X,position.Y)})
            tween(corner,{CornerRadius=UDim.new(0,radius)})
            tween(surfaceCorner,{CornerRadius=UDim.new(0,radius-2)})
            tween(expanded,{GroupTransparency=state.collapsed and 1 or 0,Position=UDim2.fromOffset(0,state.collapsed and 5 or 0)})
            local last=tween(small,{GroupTransparency=state.collapsed and 0 or 1,Position=UDim2.fromOffset(0,state.collapsed and 0 or -4)})
            local c
            c=last.Completed:Connect(function(status)
                if c then c:Disconnect() end
                if state.closed or revision~=state.animation or status~=Enum.PlaybackState.Completed then return end
                expanded.Visible=not state.collapsed small.Visible=state.collapsed
            end)
        else
            pill.Size=UDim2.fromOffset(target.X,target.Y) pill.Position=UDim2.fromOffset(position.X,position.Y)
            corner.CornerRadius=UDim.new(0,radius) surfaceCorner.CornerRadius=UDim.new(0,radius-2)
            expanded.GroupTransparency=state.collapsed and 1 or 0 expanded.Position=UDim2.fromOffset(0,0)
            small.GroupTransparency=state.collapsed and 0 or 1 small.Position=UDim2.fromOffset(0,0)
            expanded.Visible=not state.collapsed small.Visible=state.collapsed
        end
        -- Invisible CanvasGroups must not capture input while they fade out.
        drag.Active=not state.collapsed drag.Visible=not state.collapsed
        input.Active=not state.collapsed input.TextEditable=not state.collapsed
        play.Interactable=not state.collapsed pause.Interactable=not state.collapsed volumeHit.Interactable=not state.collapsed
        smallHandle.Active=state.collapsed smallHandle.Visible=state.collapsed
    end
    local function toggleFold()
        state.collapsed=not state.collapsed Settings.SoundPlayerCollapsed=state.collapsed
        if input:IsFocused() then input:ReleaseFocus() end
        render(true)
    end
    local function setVolume(value)
        value=math.clamp(math.floor((tonumber(value) or 50)+0.5),0,100)
        Settings.SoundPlayerVolume=value sound.Volume=value/100
        volumeFill.Size=UDim2.fromScale(value/100,1) volumeLabel.Text=tostring(math.floor(value)).."%"
        if UI_Elements.soundPlayerVolume then UI_Elements.soundPlayerVolume(value,true) end
    end
    local function updateVolume(position)
        if volumeBar.AbsoluteSize.X>0 then setVolume((position.X-volumeBar.AbsolutePosition.X)/volumeBar.AbsoluteSize.X*100) end
    end
    connect(volumeHit.InputBegan,function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
            state.volumeInput=i updateVolume(i.Position)
        end
    end)
    local function startDrag(i)
        if i.UserInputType~=Enum.UserInputType.MouseButton1 and i.UserInputType~=Enum.UserInputType.Touch then return end
        state.dragInput=i state.dragging=true state.dragMoved=false state.dragStart=Vector2.new(i.Position.X,i.Position.Y)
        state.dragPosition=Vector2.new(pill.Position.X.Offset,pill.Position.Y.Offset)
        local vp=getViewport()
        state.fraction=Vector2.new(state.dragPosition.X/vp.X,state.dragPosition.Y/vp.Y)
        cancelTweens()
        -- Continue size/fade transitions without a competing position tween while dragging.
        local p=layouts[state.mode]
        local w=state.collapsed and 164 or p.w
        local h=state.collapsed and 38 or p.h
        local r=state.collapsed and 19 or 16
        tween(pill,{Size=UDim2.fromOffset(w,h)})
        tween(corner,{CornerRadius=UDim.new(0,r)})
        tween(surfaceCorner,{CornerRadius=UDim.new(0,r-2)})
        tween(expanded,{GroupTransparency=state.collapsed and 1 or 0})
        tween(small,{GroupTransparency=state.collapsed and 0 or 1})
    end
    connect(drag.InputBegan,startDrag) connect(smallHandle.InputBegan,startDrag)
    connect(UserInputService.InputChanged,function(i)
        if state.closed then return end
        if state.volumeInput and (i==state.volumeInput or (state.volumeInput.UserInputType==Enum.UserInputType.MouseButton1 and i.UserInputType==Enum.UserInputType.MouseMovement)) then
            updateVolume(i.Position)
        end
        if state.dragging and (i==state.dragInput or (state.dragInput.UserInputType==Enum.UserInputType.MouseButton1 and i.UserInputType==Enum.UserInputType.MouseMovement)) then
            local delta=Vector2.new(i.Position.X,i.Position.Y)-state.dragStart
            if delta.Magnitude>4 then state.dragMoved=true end
            local vp=getViewport() local p=layouts[state.mode]
            local desired=state.dragPosition+delta
            local x=math.clamp(desired.X,8,math.max(8,vp.X-p.w*state.scale-8))
            local y=math.clamp(desired.Y,8,math.max(8,vp.Y-p.h*state.scale-8))
            pill.Position=UDim2.fromOffset(x,y) state.fraction=Vector2.new(x/vp.X,y/vp.Y)
        end
    end)
    connect(UserInputService.InputEnded,function(i)
        if i==state.volumeInput or i.UserInputType==Enum.UserInputType.MouseButton1 then state.volumeInput=nil end
        if state.dragging and (i==state.dragInput or i.UserInputType==Enum.UserInputType.MouseButton1) then
            local toggleClick=not state.dragMoved
            state.dragging=false state.dragInput=nil
            if toggleClick then toggleFold() else render(false) end
        end
    end)
    connect(UserInputService.WindowFocusReleased,function()
        state.dragging=false state.dragInput=nil state.volumeInput=nil
        render(false)
    end)
    connect(ScreenGui:GetPropertyChangedSignal("AbsoluteSize"),function() render(false) end)

    local function parse(value)
        value=tostring(value or "")
        return value:match("^%s*(%d+)%s*$") or value:match("^rbxassetid://(%d+)$")
    end
    local function refreshText()
        smallTitle.Text=state.title
        if state.mode=="Sound Player" then title.Text="Sound Player" artist.Text=state.title
        else title.Text=state.title artist.Text=state.artist end
    end
    local function loadId(value)
        local raw=tostring(value or input.Text or "")
        local id=parse(raw)
        if not id then
            if raw:match("%S") then state.artist="Enter a numeric audio ID" refreshText() return false end
            state.version=state.version+1 Settings.SoundPlayerId="" sound:Stop() sound.SoundId=""
            state.paused=false state.title="No track selected" state.artist="Roblox audio" art.Image="" input.Text="" refreshText()
            return false
        end
        if sound.SoundId=="rbxassetid://"..id then input.Text=id return true end
        state.version=state.version+1 local version=state.version
        Settings.SoundPlayerId=id input.Text=id sound:Stop() state.paused=false
        sound.SoundId="rbxassetid://"..id state.title="Audio "..id state.artist="Loading..." refreshText()
        art.Image="rbxthumb://type=Asset&id="..id.."&w=150&h=150"
        task.spawn(function()
            local ok,info=pcall(function() return game:GetService("MarketplaceService"):GetProductInfo(tonumber(id)) end)
            if state.closed or state.version~=version then return end
            if ok and type(info)=="table" then
                state.title=tostring(info.Name or ("Audio "..id))
                state.artist=info.Creator and tostring(info.Creator.Name) or "Roblox audio"
            else state.artist="Metadata unavailable" end
            refreshText()
        end)
        task.delay(12,function()
            if not state.closed and state.version==version and not sound.IsLoaded then
                state.artist="Audio unavailable / access restricted" refreshText()
            end
        end)
        return true
    end
    connect(input.FocusLost,function() loadId(input.Text) end)
    connect(play.MouseButton1Click,function()
        if not loadId(input.Text) then return end
        if state.paused then sound:Resume() elseif not sound.IsPlaying then sound:Play() end
        state.paused=false
    end)
    connect(pause.MouseButton1Click,function()
        if sound.IsPlaying then sound:Pause() state.paused=true end
    end)
    connect(sound.Ended,function() state.paused=false end)
    local function formatTime(value)
        value=math.max(0,math.floor(value)) return string.format("%d:%02d",math.floor(value/60),value%60)
    end
    local heartbeat
    local function update(dt)
        state.tick=state.tick+dt if state.tick<0.1 then return end state.tick=0
        clock.Text=formatTime(sound.TimePosition).." / "..formatTime(sound.TimeLength)
        local fraction=sound.TimeLength>0 and math.clamp(sound.TimePosition/sound.TimeLength,0,1) or 0
        fill.Size=UDim2.fromScale(fraction,1)
        smallDot.BackgroundTransparency=sound.IsPlaying and 0 or 0.65
        local height=bars.Size.Y.Offset
        for i,bar in ipairs(barList) do
            -- Decorative playback indicator, not a fabricated audio spectrum.
            local h=sound.IsPlaying and (5+math.abs(math.sin(os.clock()*4+i))*math.max(1,height-5)) or 5
            rect(bar,(i-1)*6,(height-h)/2,3,h)
        end
    end
    UI_Elements._SetSoundPlayer=function(enabled)
        Settings.SoundPlayerEnabled=enabled==true pill.Visible=Settings.SoundPlayerEnabled
        if pill.Visible then
            if not heartbeat then heartbeat=RunService.Heartbeat:Connect(update) end
            render(false)
        else
            sound:Stop() state.paused=false state.dragging=false state.dragInput=nil state.volumeInput=nil
            cancelTweens()
            if heartbeat then heartbeat:Disconnect() heartbeat=nil end
        end
    end
    UI_Elements.soundPlayerDesign=function(mode)
        state.mode=normalize(mode) Settings.SoundPlayerDesign=state.mode
        if UI_Elements.dropdownSoundPlayerDesign then UI_Elements.dropdownSoundPlayerDesign(state.mode,true) end
        render(true) -- presentation only; never changes SoundId, TimePosition or playback.
    end
    UI_Elements.soundPlayerCollapsed=function(value)
        state.collapsed=value==true Settings.SoundPlayerCollapsed=state.collapsed render(true)
    end
    UI_Elements.toggleSoundPlayer=CreateToggle(section,"Enable Sound Player",false,UI_Elements._SetSoundPlayer)
