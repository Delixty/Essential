                M.conn=(sig or RunService.Stepped):Connect(MovementStep)
            end
            if Settings.Speedhack and not M.postConn then M.postConn=RunService.Heartbeat:Connect(MovementStep)
            elseif not Settings.Speedhack and M.postConn then M.postConn:Disconnect() M.postConn=nil end
