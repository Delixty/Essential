pcall(function()
    local Cache = setmetatable({}, { __mode = "k" })

    local function GetRootModel(obj, checkFn)
        local cur = obj
        local found = nil
        while cur and cur ~= workspace and cur ~= game do
            if cur:IsA("Model") and checkFn(cur) then
                found = cur
            end
            cur = cur.Parent
        end
        return found
    end

    local function IsGenName(m)
        local n = string.lower(m.Name)
        if n == "generator" or n == "gen" then return true end
        if not string.find(n, "generator", 1, true) then return false end
        local bad = { "generators", "spawn", "location", "decor", "light", "sound", "gui", "prompt", "hitbox", "effect", "particle", "beam", "trigger" }
        for _, w in ipairs(bad) do
            if string.find(n, w, 1, true) then return false end
        end
        return true
    end

    local function IsRealGenerator(o)
        return o.Name == "Generator" and (o:IsA("Model") or o:IsA("BasePart"))
            and (o:GetAttribute("RepairProgress") ~= nil or o:FindFirstChild("HitBox") ~= nil)
    end

    local function GetGenRoot(obj)
        local cur, found = obj, nil
        while cur and cur ~= workspace and cur ~= game do
            if IsRealGenerator(cur) then return cur end
            if cur:IsA("Model") and IsGenName(cur) then
                local nested = 0
                for _, d in ipairs(cur:GetChildren()) do
                    if d:IsA("Model") and IsGenName(d) then nested = nested + 1 end
                end
                if nested < 2 then found = cur end
            end
            cur = cur.Parent
        end
        return found
    end

    local function IsNonProgressName(dn)
        local bad = { "max", "speed", "rate", "goal", "total", "need", "requir", "limit", "time", "cooldown", "mult", "skill", "bonus", "penalt", "target" }
        for _, w in ipairs(bad) do
            if string.find(dn, w, 1, true) then return true end
        end
        return false
    end

    local function IsPalletName(m)
        local n = string.lower(m.Name)
        if not string.find(n, "pallet", 1, true) then return false end
        if string.find(n, "decor", 1, true) or string.find(n, "prop", 1, true)
            or string.find(n, "stack", 1, true) or string.find(n, "pile", 1, true)
            or string.find(n, "fake", 1, true) or string.find(n, "static", 1, true) then
            return false
        end
        return true
    end

    local function IsHookName(m)
        local n = string.lower(m.Name)
        if not (string.find(n, "hook", 1, true) or string.find(n, "gallows", 1, true)) then return false end
        if string.find(n, "decor", 1, true) or string.find(n, "prop", 1, true) or string.find(n, "coat", 1, true)
            or string.find(n, "crane", 1, true) or string.find(n, "tow", 1, true) or string.find(n, "grapple", 1, true)
            or string.find(n, "webhook", 1, true) or string.find(n, "effect", 1, true) or string.find(n, "sound", 1, true) then
            return false
        end
        return true
    end

    -- Exact exit identities only: a substring such as "gate" also matches hangar props.
    local function ESPCompactName(value)
        return (string.lower(tostring(value)):gsub("[%s_%-]", ""))
    end
    local function IsGateName(obj)
        local n = ESPCompactName(obj.Name)
        return n:match("^exitgate%d*$") ~= nil or n:match("^exitdoor%d*$") ~= nil
            or n:match("^escapegate%d*$") ~= nil or n:match("^escapedoor%d*$") ~= nil
            or n:match("^gate%d*$") ~= nil
    end
    local function HasExitIdentity(obj)
        local n = ESPCompactName(obj.Name)
        if n:match("^exitgate%d*$") or n:match("^exitdoor%d*$")
            or n:match("^escapegate%d*$") or n:match("^escapedoor%d*$") then return true end
        -- A generic Gate is NOT an exit merely because it is large or interactive.
        for _, key in ipairs({"IsExitGate", "ExitGate", "IsEscapeGate", "EscapeGate"}) do
            if obj:GetAttribute(key) == true then return true end
        end
        for _, key in ipairs({"InteractionType", "ObjectType", "Type", "Action"}) do
            local value = obj:GetAttribute(key)
            if type(value) == "string" then
                value = ESPCompactName(value)
                if value == "exitgate" or value == "escapegate" then return true end
            end
        end
        local parent = obj.Parent
        if parent then
            local pn = ESPCompactName(parent.Name)
            if pn == "exitgates" or pn == "escapegates" then return true end
        end
        return false
    end
    local function FindNearestGate(obj)
        local cur = obj
        for _ = 1, 12 do
            if not cur or cur == workspace or cur == game then break end
            if (cur:IsA("Model") or cur:IsA("BasePart")) and IsGateName(cur) and HasExitIdentity(cur) then
                return cur
            end
            cur = cur.Parent
        end
        return nil
    end

    -- 1. GENERATORS
    local function EvaluateGenCompletion(gen, data)
        if not gen or not gen.Parent or not data then return false end
        if data.completed then return true end

        local repairProgress = gen:GetAttribute("RepairProgress")
        if type(repairProgress) == "number" then
            if repairProgress >= 99.9 then
                data.completed = true
                return true
            end
            return false
        end

        local doneAttrs = { "Completed", "Done", "Finished", "Repaired", "IsCompleted", "IsDone", "IsRepaired", "Fixed" }
        for i = 1, #doneAttrs do
            if gen:GetAttribute(doneAttrs[i]) == true then
                data.completed = true
                return true
            end
        end

        local stateAttr = gen:GetAttribute("State") or gen:GetAttribute("Status")
        if type(stateAttr) == "string" then
            local s = string.lower(stateAttr)
            if s == "completed" or s == "done" or s == "repaired" or s == "finished" or s == "fixed" then
                data.completed = true
                return true
            end
        end

        local progVal = gen:GetAttribute("Progress") or gen:GetAttribute("RepairProgress") or gen:GetAttribute("Charge") or gen:GetAttribute("Percent")
        if type(progVal) == "number" then
            if progVal > 0 and progVal < 1 then data.isNormalizedScale = true end
            local maxAttr = gen:GetAttribute("MaxProgress") or gen:GetAttribute("MaxCharge") or gen:GetAttribute("Max") or gen:GetAttribute("Goal")
            if type(maxAttr) == "number" and maxAttr > 0 then
                if progVal >= maxAttr - 0.001 then
                    data.completed = true
                    return true
                end
            elseif progVal >= 100 then
                data.completed = true
                return true
            elseif data.isNormalizedScale and progVal >= 0.999 then
                data.completed = true
                return true
            end
        end

        for i = 1, #data.boolVals do
            local bv = data.boolVals[i]
            if bv and bv.Parent and bv.Value == true then
                data.completed = true
                return true
            end
        end

        for i = 1, #data.progVals do
            local pv = data.progVals[i]
            if pv and pv.Parent then
                local v = pv.Value
                if v > 0 and v < 1 then data.isNormalizedScale = true end
                local maxObj = pv:FindFirstChild("Max") or pv:FindFirstChild("MaxValue") or gen:FindFirstChild("MaxProgress")
                local maxVal = (maxObj and (maxObj:IsA("NumberValue") or maxObj:IsA("IntValue"))) and maxObj.Value or nil
                if maxVal and maxVal > 0 then
                    if v >= maxVal - 0.001 then
                        data.completed = true
                        return true
                    end
                elseif v >= 100 then
                    data.completed = true
                    return true
                elseif data.isNormalizedScale and pv:IsA("NumberValue") and v >= 0.999 then
                    data.completed = true
                    return true
                end
            end
        end

        for i = 1, #data.strVals do
            local sv = data.strVals[i]
            if sv and sv.Parent then
                local s = string.lower(sv.Value)
                if s == "completed" or s == "done" or s == "repaired" or s == "finished" or s == "fixed" then
                    data.completed = true
                    return true
                end
            end
        end

        for i = 1, #data.textLabels do
            local tl = data.textLabels[i]
            if tl and tl.Parent then
                local txt = string.lower(tl.Text or "")
                local trimmed = string.gsub(txt, "%s+", "")
                if trimmed == "100%" or trimmed == "completed" or trimmed == "repaired" or trimmed == "done" then
                    data.completed = true
                    return true
                end
            end
        end

        return false
    end

    local function AttachGenDescendant(gen, data, d)
        if not data.part and d:IsA("BasePart") then
            data.part = gen.PrimaryPart or d
        end
        if d:IsA("NumberValue") or d:IsA("IntValue") then
            local dn = string.lower(d.Name)
            local pn = d.Parent and string.lower(d.Parent.Name) or ""
            local looksProgress = string.find(dn, "prog", 1, true) or string.find(dn, "repair", 1, true) or string.find(dn, "charge", 1, true) or string.find(dn, "perc", 1, true)
                or (dn == "value" and (string.find(pn, "prog", 1, true) or string.find(pn, "repair", 1, true)))
            if looksProgress and not IsNonProgressName(dn) then
                if not table.find(data.progVals, d) then
                    table.insert(data.progVals, d)
                    if d.Value > 0 and d.Value < 1 then data.isNormalizedScale = true end
                    table.insert(data.conns, d.Changed:Connect(function() EvaluateGenCompletion(gen, data) end))
                end
            end
        elseif d:IsA("BoolValue") then
            local dn = string.lower(d.Name)
            local negative = string.find(dn, "not", 1, true) or string.find(dn, "incomplete", 1, true) or string.find(dn, "unfinish", 1, true) or string.find(dn, "unrepair", 1, true) or string.find(dn, "broken", 1, true)
            if not negative and (string.find(dn, "complete", 1, true) or string.find(dn, "done", 1, true) or string.find(dn, "finish", 1, true) or string.find(dn, "repaired", 1, true) or string.find(dn, "fixed", 1, true)) then
                if not table.find(data.boolVals, d) then
                    table.insert(data.boolVals, d)
                    table.insert(data.conns, d.Changed:Connect(function() EvaluateGenCompletion(gen, data) end))
                end
            end
        elseif d:IsA("StringValue") then
            if not table.find(data.strVals, d) then
                table.insert(data.strVals, d)
                table.insert(data.conns, d.Changed:Connect(function() EvaluateGenCompletion(gen, data) end))
            end
        elseif d:IsA("TextLabel") then
            if not table.find(data.textLabels, d) then
                table.insert(data.textLabels, d)
                table.insert(data.conns, d:GetPropertyChangedSignal("Text"):Connect(function() EvaluateGenCompletion(gen, data) end))
            end
        end
    end

    local function RegisterGenerator(gen)
        if Cache[gen] or not gen or not gen.Parent then return end
        if Players:GetPlayerFromCharacter(gen) then return end
        local part = (gen:IsA("Model") and gen.PrimaryPart) or (gen:IsA("BasePart") and gen) or gen:FindFirstChild("HitBox") or gen:FindFirstChildWhichIsA("BasePart", true)
        if not part then return end

        local data = {
            part = part,
            progVals = {},
            boolVals = {},
            strVals = {},
            textLabels = {},
            conns = {},
            isNormalizedScale = false,
            completed = false,
            hl = gen:FindFirstChild("EssentialESP")
        }
        Cache[gen] = data

        for _, d in ipairs(gen:GetDescendants()) do
            AttachGenDescendant(gen, data, d)
        end

        table.insert(data.conns, gen.AttributeChanged:Connect(function()
            EvaluateGenCompletion(gen, data)
        end))
        table.insert(data.conns, gen.DescendantAdded:Connect(function(d)
            AttachGenDescendant(gen, data, d)
            EvaluateGenCompletion(gen, data)
        end))

        EvaluateGenCompletion(gen, data)
        if not table.find(trackedGenerators, gen) then
            table.insert(trackedGenerators, gen)
        end
    end

    -- 2. PALLETS (STANDING + DROPPED REMAIN HIGHLIGHTED; DECORATIONS EXCLUDED; BROKEN/DESTROYED REMOVED)
    local function IsInDecorativeContainer(obj)
        local cur = obj.Parent
        while cur and cur ~= workspace and cur ~= game do
            local n = string.lower(cur.Name)
            if n == "decor" or n == "decoration" or n == "decorations" or n == "props" or n == "staticprops" or n == "background" or n == "clutter" or n == "scenery" then
                return true
            end
            cur = cur.Parent
        end
        return false
    end

    local function IsInDedicatedPalletFolder(obj)
        local cur = obj.Parent
        while cur and cur ~= workspace and cur ~= game do
            local n = string.lower(cur.Name)
            if n == "pallets" or n == "interactables" or n == "gamepallets" or n == "mappallets" or n == "obstacles" then
                return true
            end
            cur = cur.Parent
        end
        return false
    end

    local function EvaluatePalletDestroyed(pallet, data)
        if not pallet or not pallet.Parent or not data then return true end
        if data.destroyed then return true end

        local lname = string.lower(pallet.Name)
        if string.find(lname, "broken", 1, true) or string.find(lname, "destroyed", 1, true) or string.find(lname, "shattered", 1, true) then
            data.destroyed = true
            return true
        end

        -- Атрибуты разрушения маньяком (атрибуты Dropped / Down НЕ делают паллету разрушенной!)
        local brokenAttrs = { "Broken", "IsBroken", "Destroyed", "IsDestroyed", "Shattered", "Removed", "Dead" }
        for i = 1, #brokenAttrs do
            if pallet:GetAttribute(brokenAttrs[i]) == true then
                data.destroyed = true
                return true
            end
        end
        if pallet:GetAttribute("Intact") == false then
            data.destroyed = true
            return true
        end

        local stAttr = pallet:GetAttribute("State") or pallet:GetAttribute("Status") or pallet:GetAttribute("PalletState")
        if type(stAttr) == "string" then
            local s = string.lower(stAttr)
            if s == "broken" or s == "destroyed" or s == "shattered" or s == "removed" or s == "dead" then
                data.destroyed = true
                return true
            end
        elseif type(stAttr) == "number" and stAttr >= 3 then
            data.destroyed = true
            return true
        end

        -- Проверка дочерних BoolValue только на слом/уничтожение
        for i = 1, #data.boolVals do
            local bv = data.boolVals[i]
            if bv and bv.Parent then
                local dn = string.lower(bv.Name)
                if (string.find(dn, "brok", 1, true) or string.find(dn, "destroy", 1, true) or string.find(dn, "shatter", 1, true) or dn == "dead") and bv.Value == true then
                    data.destroyed = true
                    return true
                end
                if dn == "intact" and bv.Value == false then
                    data.destroyed = true
                    return true
                end
            end
        end

        -- Проверка дочерних StringValue / IntValue на статус Broken / Destroyed
        for i = 1, #data.stateVals do
            local sv = data.stateVals[i]
            if sv and sv.Parent then
                local dn = string.lower(sv.Name)
                if sv:IsA("StringValue") then
                    local s = string.lower(sv.Value)
                    if s == "broken" or s == "destroyed" or s == "shattered" or s == "removed" or s == "dead" then
                        data.destroyed = true
                        return true
                    end
                elseif (sv:IsA("IntValue") or sv:IsA("NumberValue")) and (dn == "state" or dn == "status" or dn == "palletstate") then
                    if sv.Value >= 3 then
                        data.destroyed = true
                        return true
                    end
                elseif (sv:IsA("IntValue") or sv:IsA("NumberValue")) and (dn == "health" or dn == "durability") then
                    if sv.Value <= 0 then
                        data.destroyed = true
                        return true
                    end
                end
            end
        end

        -- Если все визуальные части паллеты были удалены или стали полностью прозрачными (Transparency >= 0.95) после разрушения
        if #data.visualParts > 0 then
            local anyVisible = false
            for i = 1, #data.visualParts do
                local vp = data.visualParts[i]
                if vp and vp.Parent and vp:IsDescendantOf(pallet) and vp.Transparency < 0.95 then
                    anyVisible = true
                    break
                end
            end
            if not anyVisible then
                data.destroyed = true
                return true
            end
        elseif not data.part or not data.part.Parent or data.part.Transparency >= 0.95 then
            data.destroyed = true
            return true
        end

        return false
    end

    local function AttachPalletDescendant(pallet, data, d)
        if d:IsA("BasePart") then
            local pn = string.lower(d.Name)
            if string.find(pn, "trigger", 1, true) or string.find(pn, "hitbox", 1, true)
                or string.find(pn, "interact", 1, true) or string.find(pn, "prompt", 1, true)
                or string.find(pn, "drop", 1, true) or string.find(pn, "hinge", 1, true)
                or string.find(pn, "pivot", 1, true) or string.find(pn, "collider", 1, true)
                or string.find(pn, "blocker", 1, true) or string.find(pn, "vault", 1, true)
                or string.find(pn, "slide", 1, true) or string.find(pn, "detect", 1, true) then
                data.hasInteractiveIndicator = true
            elseif d.Transparency >= 0.95 then
                -- Невидимые технические части внутри паллеты (Root / Pivot / Hitbox)
                data.hasInvisibleHelperPart = true
            else
                if not table.find(data.visualParts, d) then
                    table.insert(data.visualParts, d)
                end
                local vol = d.Size.X * d.Size.Y * d.Size.Z
                if vol > data.maxVol then
                    data.maxVol = vol
                    data.part = d
                end
            end
        elseif d:IsA("BoolValue") then
            data.hasInteractiveIndicator = true
            if not table.find(data.boolVals, d) then
                table.insert(data.boolVals, d)
                table.insert(data.conns, d.Changed:Connect(function() EvaluatePalletDestroyed(pallet, data) end))
            end
        elseif d:IsA("StringValue") or d:IsA("IntValue") or d:IsA("NumberValue") or d:IsA("ObjectValue") then
            data.hasInteractiveIndicator = true
            if not table.find(data.stateVals, d) then
                table.insert(data.stateVals, d)
                table.insert(data.conns, d.Changed:Connect(function() EvaluatePalletDestroyed(pallet, data) end))
            end
        elseif d:IsA("ProximityPrompt") or d:IsA("ClickDetector") then
            data.hasInteractiveIndicator = true
        elseif d:IsA("AnimationController") or d:IsA("Animator") or d:IsA("Animation") then
            data.hasInteractiveIndicator = true
            local animator = d:IsA("Animator") and d or (d:IsA("AnimationController") and d:FindFirstChildOfClass("Animator")) or nil
            if animator and not data.animator then
                data.animator = animator
                table.insert(data.conns, animator.AnimationPlayed:Connect(function(track)
                    local anim = track.Animation
                    local aname = string.lower((anim and anim.Name or "") .. " " .. (track.Name or ""))
                    if string.find(aname, "break", 1, true) or string.find(aname, "destroy", 1, true) or string.find(aname, "shatter", 1, true) then
                        table.insert(data.conns, track.Stopped:Connect(function()
                            data.destroyed = true
                        end))
                    end
                end))
            end
        elseif d:IsA("Motor6D") or d:IsA("HingeConstraint") or d:IsA("Attachment") then
            data.hasInteractiveIndicator = true
        elseif d:IsA("Sound") or d:IsA("Script") or d:IsA("LocalScript") or d:IsA("ModuleScript") or d:IsA("RemoteEvent") or d:IsA("BindableEvent") or d:IsA("Configuration") then
            data.hasInteractiveIndicator = true
        end
    end

    local function IsRealInteractivePallet(pallet, data)
        if IsInDecorativeContainer(pallet) then return false end
        if data.hasInteractiveIndicator then return true end
        if next(pallet:GetAttributes()) ~= nil then return true end

        -- Если паллета лежит в специализированной папке игровых паллет и имеет невидимую точку вращения/хитбокс или PrimaryPart
        if IsInDedicatedPalletFolder(pallet) and (data.hasInvisibleHelperPart or pallet.PrimaryPart ~= nil) then
            return true
        end

        return false
    end

    local function RegisterPallet(pallet)
        if Cache[pallet] or not pallet or not pallet.Parent then return end
        if not pallet:IsA("Model") then return end
        if Players:GetPlayerFromCharacter(pallet) then return end

        local p = pallet.Parent
        while p and p ~= workspace and p ~= game do
            if p:IsA("Model") and IsPalletName(p) then return end
            p = p.Parent
        end

        local data = {
            part = pallet.PrimaryPart,
            maxVol = 0,
            hasInteractiveIndicator = (next(pallet:GetAttributes()) ~= nil),
            hasInvisibleHelperPart = false,
            visualParts = {},
            boolVals = {},
            stateVals = {},
            animator = nil,
            destroyed = false,
            conns = {},
            hl = pallet:FindFirstChild("EssentialESP")
        }

        for _, d in ipairs(pallet:GetDescendants()) do
            AttachPalletDescendant(pallet, data, d)
        end

        if not data.part then
            data.part = pallet.PrimaryPart or pallet:FindFirstChildWhichIsA("BasePart", true)
        end
        if not data.part or not IsRealInteractivePallet(pallet, data) then
            for _, c in ipairs(data.conns) do pcall(function() c:Disconnect() end) end
            return
        end

        table.insert(data.conns, pallet.AttributeChanged:Connect(function()
            EvaluatePalletDestroyed(pallet, data)
        end))
        table.insert(data.conns, pallet.DescendantAdded:Connect(function(d)
            AttachPalletDescendant(pallet, data, d)
            EvaluatePalletDestroyed(pallet, data)
        end))
        table.insert(data.conns, pallet.DescendantRemoving:Connect(function()
            task.defer(EvaluatePalletDestroyed, pallet, data)
        end))

        EvaluatePalletDestroyed(pallet, data)
        Cache[pallet] = data
        if not table.find(trackedPallets, pallet) then
            table.insert(trackedPallets, pallet)
        end
    end

    -- 3. HOOKS
    local function RegisterHook(hookObj)
        if Cache[hookObj] or not hookObj or not hookObj.Parent then return end
        if Players:GetPlayerFromCharacter(hookObj) then return end
        local part = hookObj.PrimaryPart or hookObj:FindFirstChildWhichIsA("BasePart", true)
        if not part then return end

        local minY, maxY = math.huge, -math.huge
        local hasHookFeature = (next(hookObj:GetAttributes()) ~= nil)
        local boolVals = {}

        local pName = hookObj.Parent and string.lower(hookObj.Parent.Name) or ""
        if string.find(pName, "hook", 1, true) or string.find(pName, "interact", 1, true) then
            hasHookFeature = true
        end

        for _, d in ipairs(hookObj:GetDescendants()) do
            if d:IsA("BasePart") then
                local y = d.Position.Y
                local halfY = d.Size.Y * 0.5
                if y - halfY < minY then minY = y - halfY end
                if y + halfY > maxY then maxY = y + halfY end
                local pn = string.lower(d.Name)
                if string.find(pn, "hook", 1, true) or string.find(pn, "point", 1, true) or string.find(pn, "hang", 1, true) or string.find(pn, "victim", 1, true) or string.find(pn, "survivor", 1, true) or string.find(pn, "trigger", 1, true) or string.find(pn, "hitbox", 1, true) or string.find(pn, "prompt", 1, true) then
                    hasHookFeature = true
                end
            elseif d:IsA("BoolValue") then
                hasHookFeature = true
                table.insert(boolVals, d)
            elseif d:IsA("ProximityPrompt") or d:IsA("ClickDetector") or d:IsA("AnimationController") or d:IsA("Animator") or d:IsA("Seat") or d:IsA("Attachment") or d:IsA("Sound") or d:IsA("ValueBase") then
                hasHookFeature = true
            end
        end

        local totalHeight = (maxY > minY) and (maxY - minY) or part.Size.Y
        if totalHeight < 3.5 or not hasHookFeature then return end

        Cache[hookObj] = {
            part = part,
            boolVals = boolVals,
            hl = hookObj:FindFirstChild("EssentialESP")
        }
        if not table.find(trackedHooks, hookObj) then
            table.insert(trackedHooks, hookObj)
        end
    end

    local function IsHookUsable(hookObj, data)
        if not data.part or not data.part.Parent then return false end
        local lname = string.lower(hookObj.Name)
        if string.find(lname, "broken", 1, true) or string.find(lname, "sabotag", 1, true) or string.find(lname, "destroy", 1, true) then
            return false
        end
        if hookObj:GetAttribute("Broken") == true or hookObj:GetAttribute("Sabotaged") == true or hookObj:GetAttribute("Active") == false then
            return false
        end
        for i = 1, #data.boolVals do
            local bv = data.boolVals[i]
            if bv and bv.Parent then
                local dn = string.lower(bv.Name)
                if (string.find(dn, "brok", 1, true) or string.find(dn, "sabo", 1, true) or string.find(dn, "destroy", 1, true)) and bv.Value == true then
                    return false
                end
            end
        end
        return true
    end

    -- 4. EXIT GATES: conservative identity + bounded local geometry, never outermost parent.
    local function ValidateGate(gateObj)
        if not gateObj or not gateObj.Parent or not IsGateName(gateObj) or not HasExitIdentity(gateObj) then return nil end
        if Players:GetPlayerFromCharacter(gateObj) then return nil end
        local part, size
        if gateObj:IsA("Model") then
            part = gateObj.PrimaryPart or gateObj:FindFirstChildWhichIsA("BasePart", true)
            if not part then return nil end
            local ok, result = pcall(function() return gateObj:GetExtentsSize() end)
            if not ok then return nil end
            size = result
            -- Containers holding a separate named exit must not become the Adornee.
            for _, child in ipairs(gateObj:GetChildren()) do
                if child:IsA("Model") and IsGateName(child) and HasExitIdentity(child) then return nil end
            end
        elseif gateObj:IsA("BasePart") then
            part = gateObj size = gateObj.Size
        end
        if not part or not size then return nil end
        local width, depth = math.max(size.X, size.Z), math.min(size.X, size.Z)
        -- Heuristic guardrails, not a claimed map schema. Fail closed on building-sized models.
        if width < 7 or size.Y < 6 or width > 80 or size.Y > 64 or depth > 40 then return nil end
        return part
    end
    local function RegisterGate(gateObj)
        if not gateObj or Cache[gateObj] then return end
        local mainPart = ValidateGate(gateObj)
        if not mainPart then return end
        -- One owner per gate; nested pieces never get independent duplicate Highlights.
        for i = #trackedGates, 1, -1 do
            local old = trackedGates[i]
            if old and old.Parent then
                if gateObj:IsDescendantOf(old) then
                    local data = Cache[old]
                    if data and data.hl then data.hl:Destroy() end
                    Cache[old] = nil table.remove(trackedGates, i)
                elseif old:IsDescendantOf(gateObj) then
                    return
                end
            end
        end
        Cache[gateObj] = {part = mainPart, hl = gateObj:FindFirstChild("EssentialESP"), gateCheckAt = 0}
        table.insert(trackedGates, gateObj)
    end

    local function UpdateHighlight(obj, data, show, permanentlyDone, r, g, b, opacity)
        local hl = data and data.hl
        if permanentlyDone then
            if hl then
                pcall(function() hl:Destroy() end)
                data.hl = nil
            else
                local existing = obj:FindFirstChild("EssentialESP")
                if existing then pcall(function() existing:Destroy() end) end
            end
            return
        end

        if show then
            if not hl or hl.Parent ~= obj then
                hl = obj:FindFirstChild("EssentialESP")
                if not hl then
                    hl = Instance.new("Highlight")
                    hl.Name = "EssentialESP"
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.FillTransparency = 0.5
                    hl.OutlineTransparency = 0.2
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Adornee = obj
                    hl.Parent = obj
                end
                if data then data.hl = hl end
            end
            if not hl.Enabled then hl.Enabled = true end
            local targetCol = Color3.fromRGB(r, g, b)
            if hl.FillColor ~= targetCol then hl.FillColor = targetCol end
            local targetFill = 1 - (opacity or 50) / 100
            if hl.FillTransparency ~= targetFill then hl.FillTransparency = targetFill end
        else
            if hl and hl.Parent == obj then
                if hl.Enabled then hl.Enabled = false end
            end
        end
    end

    local function CheckObject(obj)
        if not obj or not obj.Parent then return end
        if not (obj:IsA("Model") or obj:IsA("BasePart")) then return end

        local genModel = GetGenRoot(obj)
        if genModel then
            RegisterGenerator(genModel)
            return
        end

        local palletModel = GetRootModel(obj, IsPalletName)
        if palletModel then
            RegisterPallet(palletModel)
            return
        end

        local hookModel = GetRootModel(obj, IsHookName)
        if hookModel then
            RegisterHook(hookModel)
            return
        end

        local gateModel = FindNearestGate(obj)
        if gateModel then RegisterGate(gateModel) end
    end

    UI_Elements._ESPStep = function(myPos, espBlocked)
        -- 1. GENERATORS
        for i = #trackedGenerators, 1, -1 do
            local gen = trackedGenerators[i]
            local data = Cache[gen]
            if gen and gen.Parent and data then
                if not data.part or not data.part.Parent then
                    data.part = (gen:IsA("Model") and gen.PrimaryPart) or (gen:IsA("BasePart") and gen) or gen:FindFirstChild("HitBox") or gen:FindFirstChildWhichIsA("BasePart", true)
                end
                if data.part then
                    local isDone = EvaluateGenCompletion(gen, data)
                    local dist = (myPos - data.part.Position).Magnitude
                    local show = Settings.GeneratorESP and not espBlocked and dist <= MAX_ESP_DISTANCE and not isDone
                    UpdateHighlight(gen, data, show, isDone, Settings.GeneratorR, Settings.GeneratorG, Settings.GeneratorB, Settings.GeneratorOpacity)
                end
            else
                if data and data.conns then
                    for _, c in ipairs(data.conns) do pcall(function() c:Disconnect() end) end
                end
                table.remove(trackedGenerators, i)
            end
        end

        -- 2. PALLETS (подсвечиваются и стоячие, и сброшенные; удаляются только при поломке маньяком)
        for i = #trackedPallets, 1, -1 do
            local pallet = trackedPallets[i]
            local data = Cache[pallet]
            if pallet and pallet.Parent and data then
                if not data.part or not data.part.Parent then
                    data.part = pallet.PrimaryPart or pallet:FindFirstChildWhichIsA("BasePart", true)
                end
                local isDestroyed = EvaluatePalletDestroyed(pallet, data)
                if data.part and not isDestroyed then
                    local dist = (myPos - data.part.Position).Magnitude
                    local show = Settings.PalletESP and not espBlocked and dist <= MAX_ESP_DISTANCE
                    UpdateHighlight(pallet, data, show, false, Settings.PalletR, Settings.PalletG, Settings.PalletB, Settings.PalletOpacity)
                else
                    UpdateHighlight(pallet, data, false, true, Settings.PalletR, Settings.PalletG, Settings.PalletB, Settings.PalletOpacity)
                end
            else
                if data and data.conns then
                    for _, c in ipairs(data.conns) do pcall(function() c:Disconnect() end) end
                end
                table.remove(trackedPallets, i)
            end
        end

        -- 3. HOOKS
        for i = #trackedHooks, 1, -1 do
            local hookObj = trackedHooks[i]
            local data = Cache[hookObj]
            if hookObj and hookObj.Parent and data and data.part and data.part.Parent then
                local usable = IsHookUsable(hookObj, data)
                local dist = (myPos - data.part.Position).Magnitude
                local show = Settings.HookESP and not espBlocked and dist <= MAX_ESP_DISTANCE and usable
                UpdateHighlight(hookObj, data, show, not usable, Settings.HookR, Settings.HookG, Settings.HookB, Settings.HookOpacity)
            else
                table.remove(trackedHooks, i)
            end
        end

        -- 4. EXIT GATES (existing unlimited range preserved).
        for i = #trackedGates, 1, -1 do
            local gate = trackedGates[i]
            local data = Cache[gate]
            local valid = gate and gate.Parent and data ~= nil
            if valid and os.clock() >= (data.gateCheckAt or 0) then
                data.part = ValidateGate(gate)
                data.gateCheckAt = os.clock() + 1
                valid = data.part ~= nil
            end
            if valid and data.part and data.part.Parent then
                UpdateHighlight(gate, data, Settings.GateESP and not espBlocked, false, Settings.GateR, Settings.GateG, Settings.GateB, Settings.GateOpacity)
            else
                if data and data.hl then pcall(function() data.hl:Destroy() end) end
                if gate then Cache[gate] = nil end
                table.remove(trackedGates, i)
            end
        end


    end

    local espStopped = false
    UI_Elements._CleanupObjectESP = function()
        espStopped = true
        for obj, data in pairs(Cache) do
            if data.hl then pcall(function() data.hl:Destroy() end) end
            if data.conns then
                for _, conn in ipairs(data.conns) do pcall(function() conn:Disconnect() end) end
            end
        end
    end

    task.spawn(function()
        local allObjs = workspace:GetDescendants()
        for i = 1, #allObjs do
            if espStopped then return end
            CheckObject(allObjs[i])
            if i % 1500 == 0 then task.wait() end
        end
    end)

    table.insert(connections, workspace.DescendantAdded:Connect(function(obj)
        if espStopped then return end
        if obj:IsA("Model") or obj:IsA("BasePart") then
            task.defer(function() if not espStopped then CheckObject(obj) end end)
        end
    end))
end)

