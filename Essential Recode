    end

    local SM = {
        closed = false,
        bound = false,
        inputConn = nil,
        simConn = nil,
        hbConn = nil,
        char = nil,
        hum = nil,
        hrp = nil,
        rootJoint = nil,
        origRootC0 = nil,
        waistJoint = nil,
        origWaistC0 = nil,
