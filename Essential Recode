-- ==============================================
-- SHARED CHARACTER STATE & VAULT / ACTION DETECTOR + AUTO MOONWALK + NO STOP EMOTE
-- ==============================================
pcall(function()
    local ActionKeywords = {
        "vault", "pallet", "window", "slide", "hop", "climb", "mantle", "jumpover",
        "repair", "gen", "fix", "heal", "mend", "unhook", "hook", "rescue", "save",
        "pickup", "drop", "carry", "stun", "locker", "hide", "enter", "exit",
        "open", "switch", "lever", "gate", "totem", "cleanse", "sabotage", "kick",
        "break", "destroy", "attack", "lunge", "grab", "mori", "execute", "down", "crawl"
    }
    local EmoteKeywords = {
        "emote", "dance", "taunt", "wave", "point", "pose", "clap", "cheer", "laugh", "shrug", "salute", "gesture"
    }
    local LocomotionKeywords = {
        "walk", "run", "sprint", "idle", "stand", "crouch", "sneak", "fall", "jump", "land", "swim", "climb", "toolnone"
    }

    local MoonwalkState = {
        bound = false,
        savedAutoRotate = nil,
        renderConn = nil,
        pauseUntil = 0
    }

    local EmoteState = {
        enabled = false,
        activeTrack = nil,
        activeAnimId = nil,
        origPriority = nil,
        lastTimePosition = 0,
        lastSpeed = 1,
        lastEmoteInputTime = 0,
        cancelWindowUntil = 0,
        usingItem = false,
        itemUseUntil = 0,
        resuming = false,
        lastResumeTick = 0,
        baselineAnimIds = {},
        charConns = {},
        toolConns = {},
        inputConns = {},
        trackStoppedConn = nil,
        stepConn = nil
    }

    local function ContainsAnyKeyword(str, list)
        if not str or str == "" then return false end
        local lower = string.lower(str)
        for i = 1, #list do
            if string.find(lower, list[i], 1, true) then
                return true
            end
        end
        return false
    end

    local function CollectBaselineLocomotionAnims(char)
        local ids = {}
        if not char then return ids end
        local animateScript = char:FindFirstChild("Animate")
        if animateScript then
            for _, d in ipairs(animateScript:GetDescendants()) do
                if d:IsA("Animation") and d.AnimationId ~= "" then
                    local parentName = d.Parent and string.lower(d.Parent.Name) or ""
                    if not ContainsAnyKeyword(parentName, EmoteKeywords) and not ContainsAnyKeyword(d.Name, EmoteKeywords) then
                        ids[d.AnimationId] = true
                    end
                end
            end
        end
        return ids
    end

    -- Проверяет наличие активных физических контроллеров (BodyMover / Constraint), которые игра создаёт при перелезании через окно или паллету
    local function HasGamePhysicsMover(char, hrp)
        if not char or not hrp then return false end
        for _, child in ipairs(hrp:GetChildren()) do
            if child:IsA("BodyMover") then
                if child:IsA("BodyGyro") then
                    if child.MaxTorque.Magnitude > 0.01 then return true end
                elseif child:IsA("BodyVelocity") or child:IsA("BodyPosition") or child:IsA("BodyForce") or child:IsA("BodyThrust") then
                    return true
                end
            elseif child:IsA("AlignPosition") or child:IsA("AlignOrientation") or child:IsA("LinearVelocity") or child:IsA("AngularVelocity") or child:IsA("VectorForce") then
                if child.Enabled then return true end
            elseif child:IsA("Weld") or child:IsA("WeldConstraint") or child:IsA("Motor6D") then
                local p0, p1 = child.Part0, child.Part1
                if (p0 and not p0:IsDescendantOf(char)) or (p1 and not p1:IsDescendantOf(char)) then
                    return true
                end
            end
        end
        return false
    end

    -- Проверяет, находится ли персонаж в состоянии перелезания (vault), ремонта генератора, прыжка, сидения, смерти или любого другого спецдействия
    local function IsCharacterInSpecialAction(char, hum, hrp, ignoreTrack, ignoreAirborne)
        if not char or not hum or not hrp or not hrp.Parent then return true end
        if hum.Health <= 0 or hrp.Anchored or hum.PlatformStand or hum.Sit or hum.SeatPart ~= nil then
            return true
        end

        local humState = hum:GetState()
        if humState == Enum.HumanoidStateType.Dead
            or humState == Enum.HumanoidStateType.Seated
            or (not ignoreAirborne and (humState == Enum.HumanoidStateType.Jumping or humState == Enum.HumanoidStateType.Freefall))
            or humState == Enum.HumanoidStateType.Climbing
            or humState == Enum.HumanoidStateType.Swimming
            or humState == Enum.HumanoidStateType.PlatformStanding
            or humState == Enum.HumanoidStateType.Ragdoll
            or humState == Enum.HumanoidStateType.FallingDown
            or humState == Enum.HumanoidStateType.GettingUp then
            return true
        end

        -- Атрибуты персонажа, гуманоида и игрока
        local checkTargets = { char, hum, LocalPlayer }
        local boolActionAttrs = {
            "Vaulting", "IsVaulting", "Sliding", "IsSliding", "Climbing",
            "Interacting", "IsInteracting", "Repairing", "IsRepairing", "Fixing",
            "Healing", "IsHealing", "Stunned", "IsStunned", "Carried", "IsCarried",
            "Hooked", "IsHooked", "Downed", "IsDowned", "Crawling", "Busy", "Locked", "InAction"
        }
        for t = 1, #checkTargets do
            local target = checkTargets[t]
            if target then
                for i = 1, #boolActionAttrs do
                    if target:GetAttribute(boolActionAttrs[i]) == true then
                        return true
                    end
                end
                local actVal = target:GetAttribute("Action") or target:GetAttribute("State") or target:GetAttribute("CurrentAction") or target:GetAttribute("Interaction")
                if type(actVal) == "string" then
                    local al = string.lower(actVal)
                    if al ~= "" and al ~= "none" and al ~= "idle" and al ~= "normal" and al ~= "walk" and al ~= "run" and al ~= "sprint" and al ~= "crouch" and al ~= "emote" and not (ignoreAirborne and al == "jump") then
                        return true
                    end
                end
            end
        end

        -- Проверка физических муверов/ограничителей на HumanoidRootPart (создаются при перелезании через паллеты и окна)
        if HasGamePhysicsMover(char, hrp) then
            return true
        end

        -- Если игра отключила коллизию HumanoidRootPart или Torso для прохождения сквозь паллету/окно (при выключенном Noclip)
        if not Settings.Noclip and not hrp.CanCollide then
            local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
            if torso and not torso.CanCollide and char:GetAttribute("_EssentialDefaultTorsoCollide") == true then
                return true
            end
        end

        -- Проверка активных анимаций перелезания, ремонта и взаимодействий
        local animator = hum:FindFirstChildOfClass("Animator")
        if animator then
            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                if track ~= ignoreTrack and track.IsPlaying and track.WeightCurrent > 0.05 then
                    local anim = track.Animation
                    local animId = anim and anim.AnimationId or ""
                    local combinedName = (anim and anim.Name or "") .. " " .. (track.Name or "")
                    if ContainsAnyKeyword(combinedName, ActionKeywords) then
                        return true
                    end
                    -- Если проигрывается не-базовая анимация с приоритетом Action2/Action3/Action4 (высокоприоритетные игровые действия: перелезание, ремонт)
                    if not EmoteState.baselineAnimIds[animId] and not ContainsAnyKeyword(combinedName, LocomotionKeywords) and not ContainsAnyKeyword(combinedName, EmoteKeywords) then
                        local pr = track.Priority
                        if pr == Enum.AnimationPriority.Action2 or pr == Enum.AnimationPriority.Action3 or pr == Enum.AnimationPriority.Action4 then
                            return true
                        end
                    end
                end
            end
        end

        return false
    end

    -- Восстановление AutoRotate для Moonwalk
    local function RestoreMoonwalkAutoRotate()
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildWhichIsA("Humanoid")
        if hum and MoonwalkState.savedAutoRotate ~= nil then
            pcall(function() hum.AutoRotate = MoonwalkState.savedAutoRotate end)
        end
        MoonwalkState.savedAutoRotate = nil
    end

    local function MoonwalkStep()
        if not Settings.Moonwalk then return end
        if os.clock() < MoonwalkState.pauseUntil then
            RestoreMoonwalkAutoRotate()
            return
        end

        local inLobby = false
        pcall(function()
            local team = LocalPlayer.Team
            if team then
                local tn = string.lower(team.Name)
                if string.find(tn, "lobby") or string.find(tn, "menu") or string.find(tn, "spectat") or string.find(tn, "wait") then inLobby = true end
            end
            if LocalPlayer:GetAttribute("InLobby") == true or LocalPlayer:GetAttribute("Spectating") == true or LocalPlayer:GetAttribute("IsSpectator") == true then inLobby = true end
        end)
        if inLobby then
            RestoreMoonwalkAutoRotate()
            return
        end

        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildWhichIsA("Humanoid")
        local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
        if not char or not hum or not hrp or not hrp.Parent then return end

        -- Если персонаж перелезает через окно/паллету, ремонтирует или находится в любом спецдействии — НЕ трогаем CFrame и НЕ блокируем констрейнты игры!
        if IsCharacterInSpecialAction(char, hum, hrp, EmoteState.activeTrack)
            or (UI_Elements._GetBaseWalkSpeed and UI_Elements._GetBaseWalkSpeed(hum) or hum.WalkSpeed) <= 6 then
            RestoreMoonwalkAutoRotate()
            return
        end

        local moveDir = hum.MoveDirection
        local flat = Vector3.new(moveDir.X, 0, moveDir.Z)
        local isMoving = flat.Magnitude > 0.05
        if isMoving then flat = flat.Unit end

        if not isMoving and not Settings.MoonwalkAlways then
            RestoreMoonwalkAutoRotate()
            return
        end

        if MoonwalkState.savedAutoRotate == nil then
            MoonwalkState.savedAutoRotate = hum.AutoRotate
        end
        if hum.AutoRotate ~= false then
            hum.AutoRotate = false
        end

        local facing = nil
        if isMoving then
            facing = -flat
        elseif workspace.CurrentCamera then
            local camLook = workspace.CurrentCamera.CFrame.LookVector
            local cFlat = Vector3.new(camLook.X, 0, camLook.Z)
            if cFlat.Magnitude > 0.01 then facing = -cFlat.Unit end
        end
        if not facing then return end

        local t = os.clock() * math.max(1, Settings.MoonwalkSpeed)
        local amp = math.rad(Settings.MoonwalkAngle)
        local shake = math.sin(t) * amp + math.sin(t * 2.37) * amp * 0.35

        local goalLook = CFrame.lookAt(Vector3.zero, facing) * CFrame.Angles(0, shake, 0)
        -- Поворачиваем исключительно матрицу ориентации в текущем кадре без task.defer и без отключения игровых AlignOrientation/BodyGyro
        hrp.CFrame = CFrame.new(hrp.Position) * goalLook.Rotation
    end

    UI_Elements._StartMoonwalk = function()
        if MoonwalkState.bound then return end
        MoonwalkState.renderConn = RunService.RenderStepped:Connect(MoonwalkStep)
        MoonwalkState.bound = true
    end

    UI_Elements._StopMoonwalk = function()
        if MoonwalkState.renderConn then
            pcall(function() MoonwalkState.renderConn:Disconnect() end)
            MoonwalkState.renderConn = nil
        end
        MoonwalkState.bound = false
        RestoreMoonwalkAutoRotate()
    end

-- ==============================================
    -- NO STOP EMOTE ENGINE (CLEAN LIFECYCLE & TOOL PRIORITY)
    -- ==============================================
    local ItemActionKeywords = {
        "tool", "item", "use", "activate", "equip", "aim", "shoot", "fire", "throw",
        "swing", "slash", "lunge", "flash", "heal", "bandage", "medkit", "syringe",
        "toolbox", "drink", "eat", "consume", "spray", "key", "map"
    }

    local function DisconnectList(list)
        for i = #list, 1, -1 do
            local c = list[i]
            if c then pcall(function() c:Disconnect() end) end
            list[i] = nil
        end
    end

    -- Проверка использования предмета в руках (Tool, его активация, атрибуты и анимации предмета)
    local function IsCharacterUsingItem(char, hum, ignoreTrack)
        if not char or not hum then return false end
        if EmoteState.usingItem or os.clock() < EmoteState.itemUseUntil then
            return true
        end

        if char:GetAttribute("UsingItem") == true or char:GetAttribute("ItemActive") == true
            or char:GetAttribute("IsUsingItem") == true or hum:GetAttribute("UsingItem") == true then
            return true
        end

        local equippedTool = char:FindFirstChildOfClass("Tool")
        if equippedTool then
            if equippedTool.Enabled == false
                or equippedTool:GetAttribute("Active") == true
                or equippedTool:GetAttribute("Using") == true
                or equippedTool:GetAttribute("Activated") == true
                or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
                or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
                return true
            end
        end

        local animator = hum:FindFirstChildOfClass("Animator")
        if animator then
            for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do
                if tr ~= ignoreTrack and tr.IsPlaying and tr.WeightCurrent > 0.05 then
                    local anim = tr.Animation
                    local combined = (anim and anim.Name or "") .. " " .. (tr.Name or "")
                    -- Игнорируем стандартную позу удержания "toolnone", если предмет еще не активирован, но уступаем любым активным анимациям предмета
                    local lower = string.lower(combined)
                    if not string.find(lower, "toolnone", 1, true) and ContainsAnyKeyword(lower, ItemActionKeywords) then
                        return true
                    end
                end
            end
        end

        return false
    end

    -- Отвязка текущей эмоции без насильственной остановки (возвращает управление игре)
    local function UnbindActiveEmote(forceStop)
        if EmoteState.trackStoppedConn then
            pcall(function() EmoteState.trackStoppedConn:Disconnect() end)
            EmoteState.trackStoppedConn = nil
        end
        local tr = EmoteState.activeTrack
        local origPr = EmoteState.origPriority
        EmoteState.activeTrack = nil
        EmoteState.activeAnimId = nil
        EmoteState.origPriority = nil
        EmoteState.lastTimePosition = 0
        EmoteState.resuming = false

        if tr then
            pcall(function()
                if origPr then tr.Priority = origPr end
                if forceStop and tr.IsPlaying then
                    tr:Stop(0.15)
                end
            end)
        end
    end

    local function IsCandidateEmoteTrack(track)
        if not track then return false end
        local anim = track.Animation
        local animId = anim and anim.AnimationId or ""
        if animId == "" or EmoteState.baselineAnimIds[animId] then return false end

        local combinedName = (anim and anim.Name or "") .. " " .. (track.Name or "")
        if ContainsAnyKeyword(combinedName, ActionKeywords)
            or ContainsAnyKeyword(combinedName, LocomotionKeywords)
            or ContainsAnyKeyword(combinedName, ItemActionKeywords) then
            return false
        end

        if ContainsAnyKeyword(combinedName, EmoteKeywords) then
            return true
        end

        if (os.clock() - EmoteState.lastEmoteInputTime) <= 4.0 then
            return true
        end
        return false
    end

    local function BindEmoteTrack(track)
        if not EmoteState.enabled or not track then return end
        if EmoteState.activeTrack == track then return end

        -- Если до этого играла другая эмоция — корректно прекращаем старую и переключаемся на новую
        if EmoteState.activeTrack and EmoteState.activeTrack ~= track then
            UnbindActiveEmote(true)
        else
            UnbindActiveEmote(false)
        end

        EmoteState.activeTrack = track
        EmoteState.activeAnimId = track.Animation and track.Animation.AnimationId or nil
        EmoteState.origPriority = track.Priority
        EmoteState.lastTimePosition = track.TimePosition
        EmoteState.lastSpeed = (track.Speed ~= 0) and track.Speed or 1
        EmoteState.cancelWindowUntil = 0

        pcall(function()
            track.Priority = Enum.AnimationPriority.Action
        end)

        EmoteState.trackStoppedConn = track.Stopped:Connect(function()
            if not EmoteState.enabled or not Settings.NoStopEmote or EmoteState.resuming then
                return
            end
            if EmoteState.activeTrack ~= track then
                return
            end

            local now = os.clock()
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildWhichIsA("Humanoid")
            local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
            if not char or not hum or not hrp then
                UnbindActiveEmote(false)
                return
            end

            -- 1. Если игрок сам отменил эмоцию (нажал F / кнопку отмены) — не перезапускаем
            if now < EmoteState.cancelWindowUntil then
                UnbindActiveEmote(false)
                return
            end

            -- 2. Если эмоция остановилась, когда персонаж стоит на месте — это штатная отмена или конец эмоции
            local isMoving = hum.MoveDirection.Magnitude >= 0.05
            if not isMoving then
                UnbindActiveEmote(false)
                return
            end

            -- 3. Если одноразовая эмоция сама дошла до конца своей длительности — даём ей завершиться
            if not track.Looped and track.Length > 0 and EmoteState.lastTimePosition >= (track.Length - 0.12) then
                UnbindActiveEmote(false)
                return
            end

            -- 4. Если началось спецдействие (ремонт, перелезание, прыжок, смерть, сидение) или использование предмета — уступаем игре
            if IsCharacterInSpecialAction(char, hum, hrp, track) or IsCharacterUsingItem(char, hum, track) then
                UnbindActiveEmote(false)
                return
            end

            -- 5. Эмоция была прервана игрой исключительно из-за обычной ходьбы — плавно продолжаем её
            if (now - EmoteState.lastResumeTick) < 0.1 then return end
            EmoteState.lastResumeTick = now
            EmoteState.resuming = true

            task.defer(function()
                EmoteState.resuming = false
                if not EmoteState.enabled or not Settings.NoStopEmote or EmoteState.activeTrack ~= track then
                    return
                end
                if os.clock() < EmoteState.cancelWindowUntil then
                    UnbindActiveEmote(false)
                    return
                end
                local c = LocalPlayer.Character
                local h = c and c:FindFirstChildWhichIsA("Humanoid")
                local r = c and (c:FindFirstChild("HumanoidRootPart") or c.PrimaryPart)
                if c and h and r and not IsCharacterInSpecialAction(c, h, r, track) and not IsCharacterUsingItem(c, h, track) then
                    pcall(function()
                        track.Priority = Enum.AnimationPriority.Action
                        track:Play(0.08, 1, EmoteState.lastSpeed)
                        if track.Length > 0 and EmoteState.lastTimePosition < (track.Length - 0.12) then
                            track.TimePosition = EmoteState.lastTimePosition
                        end
                    end)
                else
                    UnbindActiveEmote(false)
                end
            end)
        end)
    end

    local function WatchEquippedTool(tool)
        DisconnectList(EmoteState.toolConns)
        if not tool or not tool:IsA("Tool") then
            EmoteState.usingItem = false
            return
        end

        table.insert(EmoteState.toolConns, tool.Activated:Connect(function()
            EmoteState.usingItem = true
            EmoteState.itemUseUntil = os.clock() + 0.6
            if EmoteState.activeTrack and EmoteState.origPriority then
                pcall(function() EmoteState.activeTrack.Priority = EmoteState.origPriority end)
            end
        end))

        table.insert(EmoteState.toolConns, tool.Deactivated:Connect(function()
            EmoteState.usingItem = false
            EmoteState.itemUseUntil = os.clock() + 0.25
        end))

        table.insert(EmoteState.toolConns, tool.AncestryChanged:Connect(function(_, parent)
            if not LocalPlayer.Character or parent ~= LocalPlayer.Character then
                EmoteState.usingItem = false
                DisconnectList(EmoteState.toolConns)
            end
        end))
    end

    local function AttachCharacterEmoteListeners(char)
        DisconnectList(EmoteState.charConns)
        DisconnectList(EmoteState.toolConns)
        UnbindActiveEmote(false)
        if not EmoteState.enabled or not char then return end

        local hum = char:FindFirstChildWhichIsA("Humanoid") or char:WaitForChild("Humanoid", 5)
        if not hum or not EmoteState.enabled then return end
        local animator = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 5)
        if not animator or not EmoteState.enabled then return end

        EmoteState.baselineAnimIds = CollectBaselineLocomotionAnims(char)

        local existingTool = char:FindFirstChildOfClass("Tool")
        if existingTool then WatchEquippedTool(existingTool) end

        table.insert(EmoteState.charConns, char.ChildAdded:Connect(function(ch)
            if not EmoteState.enabled then return end
            if ch:IsA("Tool") then
                WatchEquippedTool(ch)
            elseif ch.Name == "Animate" then
                task.wait(0.2)
                if EmoteState.enabled then
                    EmoteState.baselineAnimIds = CollectBaselineLocomotionAnims(char)
                end
            end
        end))

        table.insert(EmoteState.charConns, char.ChildRemoved:Connect(function(ch)
            if ch:IsA("Tool") then
                EmoteState.usingItem = false
                DisconnectList(EmoteState.toolConns)
            end
        end))

        table.insert(EmoteState.charConns, animator.AnimationPlayed:Connect(function(track)
            if not EmoteState.enabled or not Settings.NoStopEmote then return end
            if track == EmoteState.activeTrack then return end

            local hrp = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
            if not hrp then return end

            local anim = track.Animation
            local combinedName = (anim and anim.Name or "") .. " " .. (track.Name or "")
            local lowerName = string.lower(combinedName)

            -- Если запустилась анимация спецдействия (ремонт, перелезание и т.д.) — отменяем удержание эмоции
            if ContainsAnyKeyword(lowerName, ActionKeywords) then
                UnbindActiveEmote(true)
                return
            end

            -- Если запустилась активная анимация предмета — уступаем приоритет предмету
            if not string.find(lowerName, "toolnone", 1, true) and ContainsAnyKeyword(lowerName, ItemActionKeywords) then
                EmoteState.itemUseUntil = os.clock() + math.clamp(track.Length > 0 and track.Length or 0.5, 0.35, 3.0)
                if EmoteState.activeTrack and EmoteState.origPriority then
                    pcall(function() EmoteState.activeTrack.Priority = EmoteState.origPriority end)
                end
                return
            end

            if IsCharacterInSpecialAction(char, hum, hrp, track) then
                return
            end

            -- Если игрок выбрал новую эмоцию (даже во время движения!) — переключаемся на неё, завершая старую
            if IsCandidateEmoteTrack(track) then
                BindEmoteTrack(track)
                return
            end

            -- Автообучение базовым анимациям ходьбы/бега, если клавиша F не нажималась
            if hum.MoveDirection.Magnitude > 0.1 and (os.clock() - EmoteState.lastEmoteInputTime) > 4.0 then
                if anim and anim.AnimationId ~= "" then
                    EmoteState.baselineAnimIds[anim.AnimationId] = true
                end
            end
        end))
    end

    local function EmoteStep()
        if not EmoteState.enabled or not Settings.NoStopEmote then return end
        local tr = EmoteState.activeTrack
        if not tr then return end

        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildWhichIsA("Humanoid")
        local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
        if not char or not hum or not hrp then
            UnbindActiveEmote(false)
            return
        end

        -- При смерти, сидении, ремонте, прыжке или перелезании немедленно отдаём приоритет игре
        if IsCharacterInSpecialAction(char, hum, hrp, tr) then
            UnbindActiveEmote(true)
            return
        end

        -- Во время использования предмета временно уступаем приоритет анимации предмета
        if IsCharacterUsingItem(char, hum, tr) then
            if tr.IsPlaying and EmoteState.origPriority and tr.Priority ~= EmoteState.origPriority then
                pcall(function() tr.Priority = EmoteState.origPriority end)
            end
            return
        end

        if tr.IsPlaying then
            EmoteState.lastTimePosition = tr.TimePosition
            if tr.Speed ~= 0 then EmoteState.lastSpeed = tr.Speed end
            if tr.Priority ~= Enum.AnimationPriority.Action then
                pcall(function() tr.Priority = Enum.AnimationPriority.Action end)
            end
        end
    end

    UI_Elements._SetNoStopEmote = function(state)
        EmoteState.enabled = (state == true)
        Settings.NoStopEmote = EmoteState.enabled

        if EmoteState.enabled then
            DisconnectList(EmoteState.inputConns)
            table.insert(EmoteState.inputConns, UserInputService.InputBegan:Connect(function(input, gameProcessed)
                if not EmoteState.enabled or KeybindListening then return end
                if not gameProcessed and input.UserInputType == Enum.UserInputType.Keyboard then
                    if input.KeyCode == Enum.KeyCode.F then
                        local now = os.clock()
                        EmoteState.lastEmoteInputTime = now
                        -- Если эмоция уже активна, нажатие F открывает колесо/отменяет текущую эмоцию: разрешаем её штатную остановку
                        if EmoteState.activeTrack and EmoteState.activeTrack.IsPlaying then
                            EmoteState.cancelWindowUntil = now + 0.65
                        end
                    end
                elseif input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    -- Если открыто колесо эмоций после нажатия F, клик мышью выбирает новую эмоцию или отменяет текущую
                    if (os.clock() - EmoteState.lastEmoteInputTime) <= 5.0 then
                        EmoteState.lastEmoteInputTime = os.clock()
                        if EmoteState.activeTrack and EmoteState.activeTrack.IsPlaying then
                            EmoteState.cancelWindowUntil = os.clock() + 0.65
                        end
                    end
                end
            end))

            table.insert(EmoteState.inputConns, UserInputService.InputEnded:Connect(function(input, gameProcessed)
                if not EmoteState.enabled then return end
                if not gameProcessed and input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == Enum.KeyCode.F then
                    EmoteState.lastEmoteInputTime = os.clock()
                end
            end))

            if LocalPlayer.Character then
                AttachCharacterEmoteListeners(LocalPlayer.Character)
                local hum = LocalPlayer.Character:FindFirstChildWhichIsA("Humanoid")
                local animator = hum and hum:FindFirstChildOfClass("Animator")
                if animator then
                    for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do
                        if tr.IsPlaying and IsCandidateEmoteTrack(tr) then
                            BindEmoteTrack(tr)
                            break
                        end
                    end
                end
            end

            if not EmoteState.stepConn then
                EmoteState.stepConn = RunService.Heartbeat:Connect(EmoteStep)
            end
        else
            -- Полное отключение всех собственных обработчиков, циклов и возврат управления штатной системе анимаций без насильственной отмены эмоции
            if EmoteState.stepConn then
                pcall(function() EmoteState.stepConn:Disconnect() end)
                EmoteState.stepConn = nil
            end
            DisconnectList(EmoteState.inputConns)
            DisconnectList(EmoteState.charConns)
            DisconnectList(EmoteState.toolConns)
            EmoteState.usingItem = false
            EmoteState.itemUseUntil = 0
            EmoteState.cancelWindowUntil = 0
            UnbindActiveEmote(false)
        end
    end

    -- Shared client movement owner. No position writes or forced velocity impulses.
    local M = {char=nil,hum=nil,root=nil,base=nil,last=nil,overridden=false,conn=nil,
        jump=nil,jumpAt=-math.huge,lastJump=-math.huge,lastGround=-math.huge,focused=true,needRelease=false,warned=false}
    local function ObserveSpeed()
        local h=M.hum
        if not h or not h.Parent then return end
        if M.last==nil or math.abs(h.WalkSpeed-M.last)>0.01 then M.base=h.WalkSpeed M.last=nil end
    end
    local function RestoreSpeed()
        local h=M.hum
        if h and h.Parent and M.overridden then
            ObserveSpeed()
            if h.Health>0 and h:GetState()~=Enum.HumanoidStateType.Dead and M.base~=nil then h.WalkSpeed=M.base end
        end
        M.last=nil M.overridden=false
    end
    local function RestoreJump()
        local j=M.jump M.jump=nil
        if not j or not j.h or not j.h.Parent then return end
        pcall(function()
            -- Do not overwrite a newer game write.
            if math.abs(j.h[j.key]-j.applied)<0.01 then j.h[j.key]=j.base end
        end)
    end
    local function BindMovement()
        local c=LocalPlayer.Character local h=c and c:FindFirstChildWhichIsA("Humanoid")
        if c~=M.char or h~=M.hum then
            RestoreSpeed() RestoreJump()
            M.char=c M.hum=h M.base=h and h.WalkSpeed or nil M.last=nil M.overridden=false M.warned=false
            M.lastJump=-math.huge M.lastGround=-math.huge
            local torso=c and (c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso"))
            if torso then c:SetAttribute("_EssentialDefaultTorsoCollide",torso.CanCollide) end
        end
        M.root=c and c:FindFirstChild("HumanoidRootPart")
    end
    local function Locked()
        local c,h,r=M.char,M.hum,M.root
        if not c or not h or not r or not h.Parent or not r.Parent then return true end
        if h.Health<=0 or r.Anchored or h.PlatformStand or h.Sit or h.SeatPart~=nil then return true end
        local st=h:GetState()
        if st==Enum.HumanoidStateType.Dead or st==Enum.HumanoidStateType.Seated
            or st==Enum.HumanoidStateType.PlatformStanding or st==Enum.HumanoidStateType.Ragdoll
            or st==Enum.HumanoidStateType.FallingDown or st==Enum.HumanoidStateType.GettingUp
            or st==Enum.HumanoidStateType.Climbing or st==Enum.HumanoidStateType.Swimming then return true end
        if HasGamePhysicsMover(c,r) then return true end
        for _,obj in ipairs({c,h,LocalPlayer}) do
            for _,key in ipairs({"Vaulting","IsVaulting","Interacting","IsInteracting","Repairing","IsRepairing",
                "Healing","IsHealing","Stunned","IsStunned","Carried","IsCarried","Hooked","IsHooked",
                "Downed","IsDowned","Busy","Locked","InAction"}) do
                if obj:GetAttribute(key)==true then return true end
            end
        end
        if LocalPlayer:GetAttribute("InLobby")==true or LocalPlayer:GetAttribute("Spectating")==true then return true end
        local team=LocalPlayer.Team
        if team then
            local n=string.lower(team.Name)
            if string.find(n,"lobby",1,true) or string.find(n,"spectat",1,true) or string.find(n,"menu",1,true) then return true end
        end
        return false
    end
    local function ShiftHeld()
        local held=UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
        if not M.focused or isMenuOpen or KeybindListening or UserInputService:GetFocusedTextBox() then M.needRelease=true return false end
        if M.needRelease then if not held then M.needRelease=false end return false end
        return held
    end
    local function MovementStep()
        BindMovement()
        local h=M.hum
        if not h or not M.root then return end
        ObserveSpeed()
        if h.FloorMaterial~=Enum.Material.Air then M.lastGround=os.clock() end
        local locked=Locked()
        if M.jump and (locked or not Settings.Jumphack
            or (os.clock()-M.jumpAt>0.15 and h.FloorMaterial~=Enum.Material.Air and h:GetState()~=Enum.HumanoidStateType.Jumping)) then RestoreJump() end
        if not Settings.Speedhack or locked or M.base==nil or M.base<=0 then RestoreSpeed() return end
        local active=Settings.SpeedMode=="Rage"
        if Settings.SpeedMode=="Legit" then active=ShiftHeld() and M.base>10 end
        if not active then RestoreSpeed() return end
        local target=math.clamp(tonumber(Settings.SpeedValue) or 22,16,150)
        if math.abs(h.WalkSpeed-target)>0.01 then h.WalkSpeed=target end
        M.last=h.WalkSpeed M.overridden=true
    end
    local function UpdateMovement()
        if Settings.Speedhack or Settings.Jumphack then
            if not M.conn then M.conn=RunService.Heartbeat:Connect(MovementStep) end
        elseif M.conn then M.conn:Disconnect() M.conn=nil end
    end
    UI_Elements._GetBaseWalkSpeed=function(h)
        if h and h==M.hum and M.overridden then return M.base end
        return h and h.WalkSpeed or 0
    end
    UI_Elements._SetSpeedhack=function(enabled)
        RestoreSpeed() Settings.Speedhack=enabled==true BindMovement() UpdateMovement()
    end
    UI_Elements._ApplySpeedPreset=function(mode)
        RestoreSpeed() Settings.SpeedMode=mode=="Rage" and "Rage" or "Legit" UpdateMovement()
    end
    UI_Elements._SetJumphack=function(enabled)
        RestoreJump() Settings.Jumphack=enabled==true BindMovement() UpdateMovement()
    end
    UI_Elements._RequestJump=function()
        if not Settings.Jumphack or KeybindListening or UserInputService:GetFocusedTextBox() then return end
        BindMovement() ObserveSpeed()
        local h=M.hum
        if Locked() or not h or not M.base or M.base<=6 or os.clock()-M.lastJump<0.35 then return end
        local justNative=h:GetState()==Enum.HumanoidStateType.Jumping and os.clock()-M.lastGround<0.12
        if (h.FloorMaterial==Enum.Material.Air and not justNative) or h:GetState()==Enum.HumanoidStateType.Freefall then return end
        if IsCharacterInSpecialAction(M.char,h,M.root,EmoteState.activeTrack,true) then return end
        if not h:GetStateEnabled(Enum.HumanoidStateType.Jumping) then
            if not M.warned then warn("[Essential Jump] Jumping is disabled by the game; no forced impulse was applied.") M.warned=true end
            return
        end
        RestoreJump()
        local key=h.UseJumpPower and "JumpPower" or "JumpHeight"
        local power=math.clamp(tonumber(Settings.JumpPower) or 50,30,150)
        local value=h.UseJumpPower and power or power*power/(2*math.max(workspace.Gravity,1))
        M.jump={h=h,key=key,base=h[key],applied=value}
        h[key]=value M.lastJump=os.clock() M.jumpAt=M.lastJump h.Jump=true
    end
    UI_Elements._CleanupMovement=function()
        RestoreSpeed() RestoreJump()
        if M.conn then M.conn:Disconnect() M.conn=nil end
    end
    table.insert(connections,UserInputService.WindowFocusReleased:Connect(function()
        M.focused=false M.needRelease=true if Settings.SpeedMode=="Legit" then RestoreSpeed() end
    end))
    table.insert(connections,UserInputService.WindowFocused:Connect(function() M.focused=true M.needRelease=true end))
    table.insert(connections,UserInputService.TextBoxFocused:Connect(function()
        M.needRelease=true if Settings.SpeedMode=="Legit" then RestoreSpeed() end
    end))
    table.insert(connections,UserInputService.InputEnded:Connect(function(i)
        if i.KeyCode~=Enum.KeyCode.LeftShift and i.KeyCode~=Enum.KeyCode.RightShift then return end
        local other=i.KeyCode==Enum.KeyCode.LeftShift and Enum.KeyCode.RightShift or Enum.KeyCode.LeftShift
        if not UserInputService:IsKeyDown(other) and Settings.SpeedMode=="Legit" then RestoreSpeed() end
    end))
    table.insert(connections,UserInputService.JumpRequest:Connect(function()
        if UserInputService.TouchEnabled and Settings.DeviceMode=="Phone" and UI_Elements._RequestJump then
            UI_Elements._RequestJump()
        end
    end))
    table.insert(connections,LocalPlayer.CharacterRemoving:Connect(function(c)
        if M.char==c then RestoreSpeed() RestoreJump() M.char=nil M.hum=nil M.root=nil M.base=nil end
    end))

    table.insert(connections, LocalPlayer.CharacterAdded:Connect(function(newChar)
        MoonwalkState.savedAutoRotate = nil
        if Settings.NoStopEmote then AttachCharacterEmoteListeners(newChar) end
        task.wait(0.5)
        if Settings.Moonwalk and UI_Elements._StartMoonwalk then UI_Elements._StartMoonwalk() end
    end))

    -- Обработка клавиш Space, E, F (Jumphack + пауза Moonwalk при начале перелезания + трекинг запуска/отмены эмоции по F)
    table.insert(connections, UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if KeybindListening then return end
        if not gameProcessed and input.UserInputType == Enum.UserInputType.Keyboard then
            local bind = GetMenuKeyCode()
            if bind and input.KeyCode == bind then
                ToggleMenu()
            end

            if input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.E then
                -- Если рядом есть паллета или окно, даём штатной механике перелезания спокойно инициализировать манёвр без вмешательства Moonwalk
                if Settings.Moonwalk then
                    MoonwalkState.pauseUntil = os.clock() + 0.28
                end
            end

            if input.KeyCode == Enum.KeyCode.Space and UI_Elements._RequestJump then
                UI_Elements._RequestJump()
            end
        end
    end))


end)

