local isMenuOpen = false

local function GetViewportSize()
    local vp = ScreenGui.AbsoluteSize
    if vp.X <= 0 or vp.Y <= 0 then
        local cam = workspace.CurrentCamera
        if cam then vp = cam.ViewportSize else vp = Vector2.new(1280, 720) end
    end
    return vp
end

local function ComputePillPosition(posMode)
    posMode = posMode or Settings.PillPosition or "BottomCenter"
    local scale = (Settings.DeviceMode == "Phone") and 0.85 or 1.0
    local vp = GetViewportSize()
    local pillW = 200 * scale
    local pillH = 45 * scale
    local margin = 16

    local minX = margin + pillW * 0.5
    local maxX = math.max(minX, vp.X - margin - pillW * 0.5)
    local minY = margin + pillH * 0.5
    local maxY = math.max(minY, vp.Y - margin - pillH * 0.5)

    local targetX = vp.X * 0.5
    local targetY = maxY

    if posMode == "TopLeft" then
        targetX, targetY = minX, minY
    elseif posMode == "TopCenter" then
        targetX, targetY = vp.X * 0.5, minY
    elseif posMode == "TopRight" then
        targetX, targetY = maxX, minY
    elseif posMode == "BottomLeft" then
        targetX, targetY = minX, maxY
    elseif posMode == "BottomRight" then
        targetX, targetY = maxX, maxY
    else
        targetX, targetY = vp.X * 0.5, maxY
    end

    targetX = math.clamp(targetX, minX, maxX)
    targetY = math.clamp(targetY, minY, maxY)
    return UDim2.fromOffset(math.floor(targetX + 0.5), math.floor(targetY + 0.5))
end

local function ComputeOpenMenuPosition()
    local scale = ((Settings.DeviceMode == "Phone") and 0.85 or 1.0) * ((Settings.UIScale or 100) / 100)
    local vp = GetViewportSize()
    local menuW = 560 * scale
    local menuH = 420 * scale
    local margin = 10
    local cx = math.clamp(vp.X * 0.5, margin + menuW * 0.5, math.max(margin + menuW * 0.5, vp.X - margin - menuW * 0.5))
    local cy = math.clamp(vp.Y * 0.5, margin + menuH * 0.5, math.max(margin + menuH * 0.5, vp.Y - margin - menuH * 0.5))
    return UDim2.fromOffset(math.floor(cx + 0.5), math.floor(cy + 0.5))
end

local function ApplyPillPosition(animated)
    local deviceScale = (Settings.DeviceMode == "Phone") and 0.85 or 1.0
    local targetScale = isMenuOpen and (deviceScale * ((Settings.UIScale or 100) / 100)) or deviceScale
    MainUIScale.Scale = targetScale
    if isMenuOpen then return end
    local goalPos = ComputePillPosition(Settings.PillPosition)
    if animated then
        TweenService:Create(MainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 200, 0, 45),
            Position = goalPos
        }):Play()
    else
        MainFrame.Size = UDim2.new(0, 200, 0, 45)
        MainFrame.Position = goalPos
    end
end

MainFrame.Position = ComputePillPosition(Settings.PillPosition)

table.insert(connections, ScreenGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
    if isMenuOpen then
        MainFrame.Position = ComputeOpenMenuPosition()
    else
        ApplyPillPosition(false)
    end
end))

local mainMenuTween = nil
local mainMenuRevision = 0
local function ToggleMenu()
    mainMenuRevision = mainMenuRevision + 1
    local revision = mainMenuRevision
    if mainMenuTween then mainMenuTween:Cancel() mainMenuTween = nil end
    isMenuOpen = not isMenuOpen
    local deviceScale = (Settings.DeviceMode == "Phone") and 0.85 or 1.0
    local targetScale = isMenuOpen and (deviceScale * ((Settings.UIScale or 100) / 100)) or deviceScale
    MainUIScale.Scale = targetScale
    if isMenuOpen then
        Title.TextXAlignment = Enum.TextXAlignment.Left Title.Position = UDim2.new(0, 15, 0, 0) Title.Size = UDim2.new(1, -50, 1, 0)
        GearBtn.Visible = false MainFrame.Visible = true Body.Visible = true HeaderBottom.Visible = true
        if Settings.AnimationsEnabled then
            mainMenuTween = TweenService:Create(MainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, 560, 0, 420),
                Position = ComputeOpenMenuPosition()
            })
            mainMenuTween:Play()
        else
            MainFrame.Size = UDim2.new(0, 560, 0, 420)
            MainFrame.Position = ComputeOpenMenuPosition()
        end
    else
        Title.TextXAlignment = Enum.TextXAlignment.Center Title.Position = UDim2.new(0, 0, 0, 0) Title.Size = UDim2.new(1, 0, 1, 0)
        GearBtn.Visible = false
        if Settings.AnimationsEnabled then
            mainMenuTween = TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, 200, 0, 45),
                Position = ComputePillPosition(Settings.PillPosition)
            })
            mainMenuTween:Play()
            task.delay(0.3, function()
                if revision == mainMenuRevision and not isMenuOpen then Body.Visible = false HeaderBottom.Visible = false end
            end)
        else
            MainFrame.Size = UDim2.new(0, 200, 0, 45)
            MainFrame.Position = ComputePillPosition(Settings.PillPosition)
            Body.Visible = false HeaderBottom.Visible = false
        end
    end
end

