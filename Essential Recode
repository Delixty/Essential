                writefile(filename,bytes)
            end
            return assetFn(filename)
        end)
        if closed or not layer.Parent then return end
        if ok and result then
            layer.Image=result
        else
            warn("[Essential background] "..tostring(result))
        end
    end)
    UI_Elements._CleanupBackground=function() closed=true end
end
