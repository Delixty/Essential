UI_Elements._InitWorldESP = function()
    local CS = game:GetService("CollectionService")
    local TRAP_COLOR = Color3.fromRGB(255, 64, 170)
    local MAX_TRAP_DISTANCE = 450
    local E = {
        closed = false,
        running = false,
        epoch = 0,
        records = {},
        links = {},
        pending = {},
        scheduled = false,
        elapsed = 0
    }
    local tags = { "Window", "VaultWindow", "ButcherTrap", "TendonsTrap", "Trap", "BearTrap" }
    local output = nil

    local function compact(v)
        return (tostring(v or ""):lower():gsub("[^%w]", ""))
    end

    local function disconnect(t)
        for _, c in ipairs(t) do
            pcall(function() c:Disconnect() end)
        end
        table.clear(t)
    end

    local function isEnabled(kind)
        return (kind == "Window" and Settings.WindowESP) or (kind == "Trap" and Settings.TrapESP)
    end

    -- Строгое исключение всех игроков, маньяка, рук от 1-го лица (Camera/ViewModel), оружия (Tool) и декораций
    local function excluded(root)
        if not root then return true end
        local cam = workspace.CurrentCamera
        if cam and root:IsDescendantOf(cam) then return true end

        local playerNames = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            playerNames[compact(plr.Name)] = true
            if plr.Character and (root == plr.Character or root:IsDescendantOf(plr.Character)) then
                return true
            end
        end

        local a = root
        while a and a ~= workspace and a ~= game do
            if a:IsA("Tool") or a:IsA("Accessory") or a:IsA("Humanoid") then return true end
            if a:IsA("Model") then
                if Players:GetPlayerFromCharacter(a) then return true end
                if a:FindFirstChildOfClass("Humanoid") or a:FindFirstChild("HumanoidRootPart") or a:FindFirstChild("Head") or a:FindFirstChild("Torso") or a:FindFirstChild("UpperTorso") then
                    return true
                end
            end
            local n = compact(a.Name)
            if playerNames[n]
                or n == "decor" or n == "decoration" or n == "decorations" or n == "decorative"
                or n == "lobby" or n == "preview" or n == "previews" or n == "templates"
                or n == "viewmodel" or n == "arms" or n == "firstperson" or n == "character"
                or n == "killer" or n == "butcher" or n == "thebutcher" or n == "survivor" then
                return true
            end
            a = a.Parent
        end
        return false
    end

    -- Проверка: является ли отдельная деталь (BasePart) кругом радиуса, хитбоксом или невидимым триггером
    local function isIgnoredTrapPart(part)
        if not part or not part:IsA("BasePart") then return true end
        -- Отсекаем любые прозрачные/полупрозрачные зоны и круги радиуса
        if part.Transparency >= 0.25 then return true end

        local sx, sy, sz = part.Size.X, part.Size.Y, part.Size.Z
        local maxDim = math.max(sx, sy, sz)
        local minDim = math.min(sx, sy, sz)
        -- Настоящий капкан компактный; всё что шире 4.5 стадов или выше 3.2 стадов — это радиус/зона/стена
        if maxDim > 4.5 or sy > 3.2 or minDim <= 0.01 then return true end

        local pn = compact(part.Name)
        if pn:find("radius", 1, true) or pn:find("range", 1, true) or pn:find("zone", 1, true)
            or pn:find("circle", 1, true) or pn:find("cylinder", 1, true) or pn:find("sphere", 1, true)
            or pn:find("area", 1, true) or pn:find("aoe", 1, true) or pn:find(" aura", 1, true)
            or pn:find("terror", 1, true) or pn:find("detect", 1, true) or pn:find("sensor", 1, true)
            or pn:find("collider", 1, true) or pn:find("invis", 1, true) or pn:find("bound", 1, true) then
            return true
        end

        -- Если это обычный Part в форме большого плоского цилиндра или шара — это индикатор зоны, а не капкан
        if part:IsA("Part") then
            if part.Shape == Enum.PartType.Ball and maxDim > 1.2 then return true end
            if part.Shape == Enum.PartType.Cylinder and math.max(sx, sz) > 2.2 then return true end
        end

        return false
    end

    -- Точная проверка имени капкана (без срабатывания на просто слово "butcher")
    local function isTrapName(rawName)
        local n = compact(rawName)
        if n == "" then return false end
        if n:find("trapdoor", 1, true) or n:find("hatch", 1, true) or n:find("mouse", 1, true)
            or n:find("rattrap", 1, true) or n:find("sound", 1, true) or n:find("effect", 1, true)
            or n:find("particle", 1, true) or n:find("anim", 1, true) or n:find("gui", 1, true)
            or n:find("script", 1, true) or n:find("event", 1, true) or n:find("remote", 1, true)
            or n:find("radius", 1, true) or n:find("range", 1, true) or n:find("zone", 1, true)
            or n:find("circle", 1, true) or n:find("weapon", 1, true) or n:find("cleaver", 1, true) then
            return false
        end
        if n == "trap" or n:match("^trap%d+$")
            or n:find("beartrap", 1, true)
            or n:find("butchertrap", 1, true)
            or n:find("steeltrap", 1, true)
            or n:find("tendonstrap", 1, true)
            or n:find("jawtrap", 1, true)
            or n:find("legtrap", 1, true)
            or n:find("huntingtrap", 1, true)
            or n:find("placedtrap", 1, true)
            or n:find("armedtrap", 1, true)
            or n:find("killertrap", 1, true)
            or n:find("clamptrap", 1, true)
            or n:find("snaretrap", 1, true) then
            return true
        end
        return false
    end

    local function hasTrapSignature(obj)
        if CS:HasTag(obj, "ButcherTrap") or CS:HasTag(obj, "TendonsTrap") or CS:HasTag(obj, "BearTrap") then
            return true
        end
        local t = compact(obj:GetAttribute("ObjectType") or obj:GetAttribute("InteractionType") or obj:GetAttribute("TrapType"))
        if t == "trap" or t == "beartrap" or t == "butchertrap" or t == "tendonstrap" then
            return true
        end
        if obj.Parent then
            local pn = compact(obj.Parent.Name)
            if pn == "traps" or pn == "butchertraps" or pn == "placedtraps" or pn == "killertraps" or pn == "beartraps" then
                return true
            end
        end
        return false
    end

    local function kindOf(obj)
        if not obj or not obj.Parent then return nil end
        if not (obj:IsA("Model") or obj:IsA("BasePart")) then return nil end
        if obj == workspace or excluded(obj) then return nil end

        local n = compact(obj.Name)
        local t = compact(obj:GetAttribute("ObjectType") or obj:GetAttribute("InteractionType") or obj:GetAttribute("TrapType") or obj:GetAttribute("Type"))

        -- 1. Окна
        if n == "window" or n:match("^window%d+$") or n == "vaultwindow" or n == "windowvault"
            or t == "vaultwindow" or CS:HasTag(obj, "Window") or CS:HasTag(obj, "VaultWindow") then
            return "Window"
        end

        -- 2. Капканы
        if obj:IsA("BasePart") then
            if isIgnoredTrapPart(obj) then return nil end
            if isTrapName(obj.Name) or hasTrapSignature(obj) then
                return "Trap"
            end
            return nil
        end

        if obj:IsA("Model") then
            if isTrapName(obj.Name) or hasTrapSignature(obj) then
                return "Trap"
            end
            for _, ch in ipairs(obj:GetChildren()) do
                local cn = compact(ch.Name)
                if cn == "leftjaw" or cn == "rightjaw" or cn == "trapmesh" or cn == "beartrap" then
                    return "Trap"
                end
            end
        end

        return nil
    end

    -- Находим компактную модель самого капкана, не поднимаясь к папкам карты или персонажам
    local function resolveRootCandidate(obj)
        local cur = obj
        local best = nil
        while cur and cur ~= workspace and cur ~= game do
            if excluded(cur) then return nil end
            local k = kindOf(cur)
            if k == "Window" then
                best = cur
            elseif k == "Trap" then
                best = cur
                -- Если нашли Model капкана, выше неё уже не поднимаемся, чтобы не захватить контейнер карты
                if cur:IsA("Model") then break end
            end
            cur = cur.Parent
        end
        return best
    end

    local function clearHighlights(rec)
        if rec.highlights then
            for _, hl in pairs(rec.highlights) do
                pcall(function() hl:Destroy() end)
            end
        end
        rec.highlights = nil
        if rec.adornBox then
            pcall(function() rec.adornBox:Destroy() end)
            rec.adornBox = nil
        end
    end

    local function destroyVisual(rec)
        clearHighlights(rec)
        if rec.surface then pcall(function() rec.surface:Destroy() end) end
        if rec.visual then pcall(function() rec.visual:Destroy() end) end
        rec.winParts = nil
        rec.surface = nil
        rec.surfaceFill = nil
        rec.surfaceStroke = nil
        rec.visual = nil
        rec.gui = nil
        rec.text = nil
    end

    local function remove(root)
        local rec = E.records[root]
        if rec then
            destroyVisual(rec)
            disconnect(rec.links)
            disconnect(rec.valueLinks)
            E.records[root] = nil
        end
    end

    local function stateNodes(root)
        local nodes = { root }
        for _, d in ipairs(root:GetChildren()) do
            if d:IsA("ValueBase") then
                table.insert(nodes, d)
            elseif d:IsA("Configuration") or (d:IsA("Folder") and (compact(d.Name) == "state" or compact(d.Name) == "config" or compact(d.Name) == "values")) then
                table.insert(nodes, d)
                for _, v in ipairs(d:GetDescendants()) do
                    if v:IsA("ValueBase") then table.insert(nodes, v) end
                end
            end
        end
        return nodes
    end

    local function entries(root)
        local out = {}
        for _, node in ipairs(stateNodes(root)) do
            for k, v in pairs(node:GetAttributes()) do
                table.insert(out, { compact(k), v })
            end
            if node:IsA("ValueBase") then
                table.insert(out, { compact(node.Name), node.Value })
            end
        end
        return out
    end

    local negativeWindow = { destroyed = true, isdestroyed = true, broken = true, blocked = true, disabled = true }
    local negativeTrap = {
        destroyed = true, isdestroyed = true, broken = true, isbroken = true,
        disabled = true, isdisabled = true, sprung = true, issprung = true,
        disarmed = true, isdisarmed = true, consumed = true, isconsumed = true,
        removed = true, isremoved = true, despawned = true
    }
    local terminalTrapStates = {
        destroyed = true, broken = true, disabled = true, removed = true,
        sprung = true, disarmed = true, consumed = true, closed = true, inactive = true
    }

    -- Собирает ТОЛЬКО реальные твёрдые детали самого капкана (отсекая круги радиуса и прозрачные хитбоксы)
    local function getValidTrapParts(root)
        local valid = {}
        if root:IsA("BasePart") then
            if not isIgnoredTrapPart(root) then
                table.insert(valid, root)
            end
            return valid
        end
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("BasePart") and not isIgnoredTrapPart(d) then
                table.insert(valid, d)
            end
        end
        return valid
    end

    local function evaluate(root, kind)
        if not root or not root:IsDescendantOf(workspace) or excluded(root) then
            return nil, "outside-world-or-excluded"
        end

        local attrs = entries(root)
        for _, entry in ipairs(attrs) do
            local k, v = entry[1], entry[2]
            if kind == "Window" then
                if negativeWindow[k] and v == true then return nil, "inactive:" .. k end
                if (k == "state" or k == "status") then
                    local st = compact(v)
                    if st == "broken" or st == "destroyed" or st == "blocked" or st == "disabled" then
                        return nil, "state:" .. st
                    end
                end
                if (k == "vaultable" or k == "canvault") and v == false then
                    return nil, "not-vaultable"
                end
            elseif kind == "Trap" then
                if negativeTrap[k] and v == true then return nil, "inactive:" .. k end
                if k == "state" or k == "status" or k == "trapstate" then
                    local st = compact(v)
                    if terminalTrapStates[st] then
                        return nil, "state:" .. st
                    end
                end
                if (k == "armed" or k == "isarmed" or k == "active" or k == "isactive" or k == "placed" or k == "deployed" or k == "enabled") and v == false then
                    return nil, "inactive:" .. k
                end
            end
        end

        if kind == "Trap" then
            local validParts = getValidTrapParts(root)
            if #validParts == 0 then
                return nil, "no-valid-trap-mesh"
            end
            -- Выбираем центральную деталь капкана для привязки текста и 3D-бокса
            local bestPart = validParts[1]
            for i = 2, #validParts do
                local p = validParts[i]
                if p:IsA("MeshPart") or p:IsA("UnionOperation") then
                    bestPart = p
                    break
                end
            end
            return bestPart, "accepted", nil
        end

        -- Логика для Window ESP
        local nodes = root:GetDescendants()
        table.insert(nodes, 1, root)
        local part, helper, visible, windowPrompt = nil, nil, nil, false

        for _, node in ipairs(nodes) do
            if node:IsA("BasePart") then
                part = part or node
                if node.Transparency < 1 then
                    visible = visible or node
                end
                local pn = compact(node.Name)
                if pn == "inviswall" then
                    helper = node
                elseif not helper and (pn == "vaulttrigger" or pn == "windowtrigger") then
                    helper = node
                end
            elseif node:IsA("ProximityPrompt") and kind == "Window" then
                local action = compact(node.ActionText)
                if action == "vault" or action == "vaultwindow" or action == "climbthrough" then
                    windowPrompt = true
                end
            end
        end

        if not helper and not windowPrompt and not CS:HasTag(root, "VaultWindow")
            and root:GetAttribute("CanVault") ~= true and root:GetAttribute("Vaultable") ~= true then
            return nil, "no-gameplay-window-signature"
        end

        part = helper or visible or part
        if not part then
            return nil, "waiting-for-geometry"
        end
        return part, "accepted", helper
    end

    local WIN_SIGNS = { -1, 1 }
    local function boundsIn(ref, list)
        local mn = Vector3.new(math.huge, math.huge, math.huge)
        local mx = Vector3.new(-math.huge, -math.huge, -math.huge)
        for _, p in ipairs(list) do
            local rel = ref:ToObjectSpace(p.CFrame)
            local h = p.Size * 0.5
            for _, sx in ipairs(WIN_SIGNS) do
                for _, sy in ipairs(WIN_SIGNS) do
                    for _, sz in ipairs(WIN_SIGNS) do
                        local v = rel * Vector3.new(sx * h.X, sy * h.Y, sz * h.Z)
                        mn = Vector3.new(math.min(mn.X, v.X), math.min(mn.Y, v.Y), math.min(mn.Z, v.Z))
                        mx = Vector3.new(math.max(mx.X, v.X), math.max(mx.Y, v.Y), math.max(mx.Z, v.Z))
                    end
                end
            end
        end
        return mn, mx
    end

    -- Auto-fit: the box is shrunk to the real frame of the window and capped per axis (long / medium / thin)
    local WINDOW_AXIS_CAPS = { 8, 7.5, 3 }
    local function computeWindowBox(root, anchor, helper)
        local ref = anchor.CFrame
        local half = anchor.Size * 0.5
        local nmn = { -half.X, -half.Y, -half.Z }
        local nmx = { half.X, half.Y, half.Z }

        local parts = {}
        if root:IsA("BasePart") then
            parts[1] = root
        else
            for _, d in ipairs(root:GetDescendants()) do
                if d:IsA("BasePart") then parts[#parts + 1] = d end
            end
        end

        local frame = {}
        for _, p in ipairs(parts) do
            if p ~= anchor and p.Transparency < 0.95 then
                local s = p.Size
                if math.max(s.X, s.Y, s.Z) <= 12 then
                    local c = ref:PointToObjectSpace(p.Position)
                    if c.X >= nmn[1] - 1 and c.X <= nmx[1] + 1
                        and c.Y >= nmn[2] - 1 and c.Y <= nmx[2] + 1
                        and c.Z >= nmn[3] - 1 and c.Z <= nmx[3] + 1 then
                        frame[#frame + 1] = p
                    end
                end
            end
        end

        if #frame > 0 then
            local fmn, fmx = boundsIn(ref, frame)
            local f1 = { fmn.X, fmn.Y, fmn.Z }
            local f2 = { fmx.X, fmx.Y, fmx.Z }
            for i = 1, 3 do
                if f2[i] - f1[i] > 0.3 then
                    local a = math.max(nmn[i], f1[i] - 0.25)
                    local b = math.min(nmx[i], f2[i] + 0.25)
                    if b - a > 0.2 then nmn[i], nmx[i] = a, b end
                end
            end
        end

        local size = { nmx[1] - nmn[1], nmx[2] - nmn[2], nmx[3] - nmn[3] }
        local center = { (nmn[1] + nmx[1]) * 0.5, (nmn[2] + nmx[2]) * 0.5, (nmn[3] + nmx[3]) * 0.5 }
        local order = { 1, 2, 3 }
        table.sort(order, function(a, b) return size[a] > size[b] end)
        for rank, axis in ipairs(order) do
            if rank == 3 then size[axis] = 0.2 else size[axis] = math.clamp(size[axis], 0.4, WINDOW_AXIS_CAPS[rank]) end
        end
        if size[1] <= 0 or size[2] <= 0 or size[3] <= 0 then return nil end
        return CFrame.new(center[1], center[2], center[3]), Vector3.new(size[1], size[2], size[3])
    end

    local function windowGeometry(root, rec)
        local anchor = rec.helper or rec.part
        if not anchor or not anchor.Parent then return nil end
        if rec.geoStale or not rec.geoRel or rec.geoAnchor ~= anchor then
            rec.geoStale = false
            rec.geoAnchor = anchor
            rec.geoRel, rec.geoSize = computeWindowBox(root, anchor, rec.helper)
        end
        if not rec.geoRel then return nil end
        return anchor.CFrame * rec.geoRel, rec.geoSize
    end

    -- Вычисляет точный BoundingBox только по реальным деталям капкана (игнорируя огромные круги радиуса)
    local function geometry(root, part, helper, kind, rec)
        if kind == "Window" then
            return windowGeometry(root, rec)
        end
        if kind == "Trap" then
            local validParts = getValidTrapParts(root)
            if #validParts == 0 then return nil end
            local minVec = Vector3.new(math.huge, math.huge, math.huge)
            local maxVec = Vector3.new(-math.huge, -math.huge, -math.huge)
            for _, p in ipairs(validParts) do
                local pos = p.Position
                local half = p.Size * 0.5
                minVec = Vector3.new(math.min(minVec.X, pos.X - half.X), math.min(minVec.Y, pos.Y - half.Y), math.min(minVec.Z, pos.Z - half.Z))
                maxVec = Vector3.new(math.max(maxVec.X, pos.X + half.X), math.max(maxVec.Y, pos.Y + half.Y), math.max(maxVec.Z, pos.Z + half.Z))
            end
            local size = maxVec - minVec
            if math.max(size.X, size.Y, size.Z) > 6.5 or math.min(size.X, size.Y, size.Z) <= 0.01 then
                return nil
            end
            local center = (minVec + maxVec) * 0.5
            return CFrame.new(center), size
        end

        local cf, size = part.CFrame, part.Size
        if root:IsA("Model") and not helper then
            local ok, a, b = pcall(function() return root:GetBoundingBox() end)
            if not ok then return nil end
            cf, size = a, b
        end
        if math.max(size.X, size.Y, size.Z) > 60 or math.min(size.X, size.Y, size.Z) <= 0 then
            return nil
        end
        return cf, size
    end

    -- Возвращает список целей для Highlight: для капканов подсвечиваются ТОЛЬКО отфильтрованные детали самого капкана!
    local function highlightTargets(root, kind)
        if kind == "Trap" then
            return getValidTrapParts(root)
        end
        if root:IsA("Model") or root:IsA("BasePart") then return { root } end
        local targets = {}
        local seen = {}
        for _, part in ipairs(root:GetDescendants()) do
            if part:IsA("BasePart") then
                local target = part
                local ancestor = part.Parent
                while ancestor and ancestor ~= root do
                    if ancestor:IsA("Model") then target = ancestor end
                    ancestor = ancestor.Parent
                end
                if not seen[target] then
                    seen[target] = true
                    table.insert(targets, target)
                end
            end
        end
        return targets
    end

    local function observe(root)
        if not root or E.records[root] or not root:IsDescendantOf(workspace) or excluded(root) then return end
        local kind = kindOf(root)
        if not kind then return end
        local rec = { kind = kind, links = {}, valueLinks = {}, dirty = true, rebuild = true, reason = "pending" }
        E.records[root] = rec
        local function dirty() rec.dirty = true end
        local function structure(obj)
            if typeof(obj) == "Instance" and (obj:IsA("Highlight") or obj:IsA("BoxHandleAdornment") or obj:IsA("SelectionBox"))
                and (obj.Name == "EssentialWindowHighlight" or obj.Name == "EssentialTrapHighlight" or obj.Name == "EssentialTrapBox3D") then
                return
            end
            rec.dirty = true
            rec.rebuild = true
        end
        table.insert(rec.links, root.AttributeChanged:Connect(dirty))
        table.insert(rec.links, root:GetPropertyChangedSignal("Name"):Connect(dirty))
        table.insert(rec.links, root.AncestryChanged:Connect(structure))
        table.insert(rec.links, root.DescendantAdded:Connect(structure))
        table.insert(rec.links, root.DescendantRemoving:Connect(structure))
        table.insert(rec.links, root.Destroying:Connect(function() remove(root) end))
    end

    local function inspect(obj)
        if not obj or not obj:IsDescendantOf(workspace) or excluded(obj) then return end
        local bestRoot = resolveRootCandidate(obj)
        if bestRoot then
            observe(bestRoot)
        end
    end

    local function queue(obj)
        if not obj then return end
        if (obj:IsA("Highlight") or obj:IsA("BoxHandleAdornment") or obj:IsA("SelectionBox"))
            and (obj.Name == "EssentialWindowHighlight" or obj.Name == "EssentialTrapHighlight" or obj.Name == "EssentialTrapBox3D") then
            return
        end
        E.pending[obj] = true
        if E.scheduled then return end
        E.scheduled = true
        local epoch = E.epoch
        task.delay(0.08, function()
            if not E.running or E.epoch ~= epoch then return end
            E.scheduled = false
            local q = E.pending
            E.pending = {}
            for item in pairs(q) do
                if item and item.Parent then inspect(item) end
            end
        end)
    end

    local function drawWindow(rec, cf, size)
        local anchor = rec.helper or rec.part
        if not anchor or not anchor.Parent or not rec.geoRel then destroyVisual(rec) return end
        if not output or not output.Parent then
            output = Instance.new("Folder")
            output.Name = "EssentialWorldESP"
            output.Parent = ScreenGui
        end
        if not rec.visual or not rec.visual.Parent then
            rec.visual = Instance.new("Folder")
            rec.visual.Name = "EssentialWindowESP"
            rec.visual.Parent = output
            rec.winParts = nil
        end

        local w = rec.winParts
        if not w or w.anchor ~= anchor then
            rec.visual:ClearAllChildren()
            w = { anchor = anchor, edges = {} }
            local fill = Instance.new("BoxHandleAdornment")
            fill.Name = "EssentialWindowBox3D"
            fill.AlwaysOnTop = true
            fill.ZIndex = 1
            fill.Adornee = anchor
            fill.Parent = rec.visual
            w.fill = fill
            for i = 1, 12 do
                local e = Instance.new("BoxHandleAdornment")
                e.Name = "EssentialWindowEdge"
                e.AlwaysOnTop = true
                e.ZIndex = 3
                e.Adornee = anchor
                e.Parent = rec.visual
                w.edges[i] = e
            end
            rec.winParts = w
        end

        local r, g, b, o = Settings.WindowR, Settings.WindowG, Settings.WindowB, Settings.WindowOpacity
        if w.rel ~= rec.geoRel or w.size ~= size or w.r ~= r or w.g ~= g or w.b ~= b or w.o ~= o then
            w.rel, w.size, w.r, w.g, w.b, w.o = rec.geoRel, size, r, g, b, o
            w.fill.Size = size
            w.fill.CFrame = rec.geoRel
            w.fill.Color3 = Color3.fromRGB(r, g, b)
            w.fill.Transparency = math.clamp(1 - o / 100, 0, 1)

            local hx, hy, hz = size.X * 0.5, size.Y * 0.5, size.Z * 0.5
            local th = 0.07
            local idx = 0
            for _, a in ipairs(WIN_SIGNS) do
                for _, c in ipairs(WIN_SIGNS) do
                    local defs = {
                        { Vector3.new(0, a * hy, c * hz), Vector3.new(size.X, th, th) },
                        { Vector3.new(a * hx, 0, c * hz), Vector3.new(th, size.Y, th) },
                        { Vector3.new(a * hx, c * hy, 0), Vector3.new(th, th, size.Z) }
                    }
                    for k = 1, 3 do
                        idx = idx + 1
                        local e = w.edges[idx]
                        if e then
                            e.Size = defs[k][2]
                            e.CFrame = rec.geoRel * CFrame.new(defs[k][1])
                            e.Color3 = Color3.fromRGB(255, 255, 255)
                            e.Transparency = 0
                        end
                    end
                end
            end
        end
    end

    local function draw(root, rec, cf, size)
        if rec.kind == "Window" then
            drawWindow(rec, cf, size)
            return
        end

        if not output or not output.Parent then
            output = Instance.new("Folder")
            output.Name = "EssentialWorldESP"
            output.Parent = ScreenGui
        end
        if not rec.visual or not rec.visual.Parent then
            rec.visual = Instance.new("Folder")
            rec.visual.Name = "Essential" .. rec.kind .. "ESP"
            rec.visual.Parent = output
        end

        local color = TRAP_COLOR
        local fillTrans = 1 - (Settings.TrapOpacity / 100)

        -- 1. HIGHLIGHT САМОГО КАПКАНА РАБОТАЕТ ВСЕГДА, ПОКА ВКЛЮЧЁН ENABLE TRAP ESP
        rec.highlights = rec.highlights or {}
        local active = {}
        local targets = rec.targets or highlightTargets(root, rec.kind)
        for _, target in ipairs(targets) do
            if target and target.Parent and (target == root or target:IsDescendantOf(root)) and not isIgnoredTrapPart(target) then
                active[target] = true
                local hl = rec.highlights[target]
                if not hl or hl.Parent ~= target then
                    if hl then pcall(function() hl:Destroy() end) end
                    hl = Instance.new("Highlight")
                    hl.Name = "EssentialTrapHighlight"
                    hl.Adornee = target
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.OutlineTransparency = 0.1
                    hl.FillColor = color
                    hl.FillTransparency = fillTrans
                    hl.Enabled = true
                    hl.Parent = target
                    rec.highlights[target] = hl
                else
                    hl.Adornee = target
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.OutlineTransparency = 0.1
                    hl.FillColor = color
                    hl.FillTransparency = fillTrans
                    hl.Enabled = true
                end
            end
        end
        for target, hl in pairs(rec.highlights) do
            if not active[target] then
                pcall(function() hl:Destroy() end)
                rec.highlights[target] = nil
            end
        end

        -- 2. ДОПОЛНИТЕЛЬНЫЙ 3D-БОКС (ТОЛЬКО ЕСЛИ ВКЛЮЧЁН SHOW TRAP BOX)
        if Settings.TrapBox and rec.part and rec.part.Parent then
            if not rec.adornBox or not rec.adornBox.Parent then
                local box = Instance.new("BoxHandleAdornment")
                box.Name = "EssentialTrapBox3D"
                box.AlwaysOnTop = true
                box.ZIndex = 4
                box.Parent = rec.visual
                rec.adornBox = box
            end
            rec.adornBox.Adornee = rec.part
            rec.adornBox.Size = Vector3.new(
                math.clamp(size.X, 0.8, 3.2),
                math.clamp(size.Y, 0.35, 1.8),
                math.clamp(size.Z, 0.8, 3.2)
            )
            rec.adornBox.CFrame = rec.part.CFrame:ToObjectSpace(cf)
            rec.adornBox.Color3 = color
            rec.adornBox.Transparency = math.clamp(fillTrans + 0.15, 0.25, 0.9)
            rec.adornBox.Visible = true
        elseif rec.adornBox then
            pcall(function() rec.adornBox:Destroy() end)
            rec.adornBox = nil
        end

        -- 3. ТЕКСТОВАЯ МЕТКА НАД КАПКАНОМ (ТОЛЬКО ЕСЛИ ВКЛЮЧЁН SHOW TRAP LABEL)
        if Settings.TrapLabel then
            if not rec.gui or not rec.gui.Parent then
                rec.gui = Instance.new("BillboardGui")
                rec.gui.Name = "ButcherTrapLabel"
                rec.gui.AlwaysOnTop = true
                rec.gui.MaxDistance = 0
                rec.gui.LightInfluence = 0
                rec.gui.Size = UDim2.fromOffset(200, 34)
                rec.gui.Parent = rec.visual

                rec.text = Instance.new("TextLabel")
                rec.text.BackgroundTransparency = 1
                rec.text.Size = UDim2.fromScale(1, 1)
                rec.text.Font = Enum.Font.GothamBold
                rec.text.TextStrokeTransparency = 0.15
                rec.text.TextStrokeColor3 = Color3.new(0, 0, 0)
                rec.text.Parent = rec.gui
            end
            rec.gui.Adornee = rec.part
            rec.gui.StudsOffsetWorldSpace = cf.Position - rec.part.Position + Vector3.new(0, size.Y * 0.5 + 1.0, 0)
            local distStr = rec.distance and (" [" .. tostring(math.floor(rec.distance + 0.5)) .. "m]") or ""
            rec.text.Text = "Butcher Trap" .. distStr
            rec.text.TextColor3 = color
            rec.text.TextSize = Settings.TrapTextSize
        elseif rec.gui then
            pcall(function() rec.gui:Destroy() end)
            rec.gui = nil
            rec.text = nil
        end
    end

    local function update(root, rec)
        if not root or not root:IsDescendantOf(workspace) or excluded(root) then
            remove(root)
            return
        end
        if rec.rebuild then
            rec.targets = highlightTargets(root, rec.kind)
            disconnect(rec.valueLinks)
            for _, node in ipairs(stateNodes(root)) do
                local function dirty() rec.dirty = true end
                if node ~= root then
                    table.insert(rec.valueLinks, node.AttributeChanged:Connect(dirty))
                end
                if node:IsA("ValueBase") then
                    table.insert(rec.valueLinks, node.Changed:Connect(dirty))
                end
            end
            rec.rebuild = false
        end
        if rec.dirty then
            rec.part = nil
            rec.helper = nil
            if kindOf(root) == rec.kind then
                rec.part, rec.reason, rec.helper = evaluate(root, rec.kind)
                rec.targets = highlightTargets(root, rec.kind)
            else
                rec.reason = "identity-changed"
            end
            rec.dirty = false
            rec.geoStale = true
        end
        if rec.part and rec.part ~= root and not rec.part:IsDescendantOf(root) then
            rec.part = nil
            rec.dirty = true
        end
    end

    local function safe(fn, root, rec)
        local ok, err = pcall(fn, root, rec)
        if not ok then
            if rec then destroyVisual(rec) end
            if E.lastError ~= tostring(err) then
                E.lastError = tostring(err)
                warn("[Essential World ESP] " .. tostring(err))
            end
        end
    end

    local function step()
        local character = LocalPlayer.Character
        local myRoot = character and character:FindFirstChild("HumanoidRootPart")
        local myPos = myRoot and myRoot.Position
        local ordered = {}

        for root, rec in pairs(E.records) do
            safe(update, root, rec)
            rec.distance = (myPos and rec.part) and (myPos - rec.part.Position).Magnitude or nil
            local maxDist = (rec.kind == "Trap") and MAX_TRAP_DISTANCE or MAX_ESP_DISTANCE
            if E.records[root] and rec.part and isEnabled(rec.kind)
                and (not rec.distance or rec.distance <= maxDist) then
                local depth = 0
                local a = root
                while a and a ~= workspace do
                    depth = depth + 1
                    a = a.Parent
                end
                table.insert(ordered, { root = root, rec = rec, depth = depth })
            else
                destroyVisual(rec)
            end
        end

        table.sort(ordered, function(a, b) return a.depth < b.depth end)
        local owners = {}
        local parts = {}
        for _, item in ipairs(ordered) do
            local root, rec = item.root, item.rec
            local duplicate = (parts[rec.part] == true)
            for _, other in ipairs(owners) do
                if other.rec.kind == rec.kind and (root:IsDescendantOf(other.root) or other.root:IsDescendantOf(root)) then
                    duplicate = true
                    break
                end
            end
            if duplicate then
                destroyVisual(rec)
            else
                local cf, size = geometry(root, rec.part, rec.helper, rec.kind, rec)
                if cf then
                    safe(function() draw(root, rec, cf, size) end, root, rec)
                    parts[rec.part] = true
                    table.insert(owners, item)
                else
                    destroyVisual(rec)
                    rec.reason = "unbounded-or-empty-geometry"
                end
            end
        end
    end

    local function stop()
        E.running = false
        E.epoch = E.epoch + 1
        disconnect(E.links)
        local roots = {}
        for root in pairs(E.records) do table.insert(roots, root) end
        for _, root in ipairs(roots) do remove(root) end
        E.pending = {}
        E.scheduled = false
        E.elapsed = 0
        if output then
            pcall(function() output:Destroy() end)
            output = nil
        end
    end

    UI_Elements._RefreshWorldESP = function()
        if E.closed then return end
        if UI_Elements._BulkLoading then UI_Elements._PendingWorldESP = true return end
        if not Settings.WindowESP and not Settings.TrapESP then
            stop()
            return
        end
        if not E.running then
            E.running = true
            E.epoch = E.epoch + 1
            table.insert(E.links, workspace.DescendantAdded:Connect(queue))
            for _, tag in ipairs(tags) do
                table.insert(E.links, CS:GetInstanceAddedSignal(tag):Connect(queue))
                table.insert(E.links, CS:GetInstanceRemovedSignal(tag):Connect(function(obj)
                    if E.records[obj] then E.records[obj].dirty = true end
                end))
            end
            table.insert(E.links, RunService.Heartbeat:Connect(function(dt)
                E.elapsed = E.elapsed + dt
                if E.elapsed >= 0.2 then
                    E.elapsed = 0
                    safe(step)
                end
            end))
            local epoch = E.epoch
            task.spawn(function()
                task.wait(0.1)
                local sliceStart = os.clock()
                for i, obj in ipairs(workspace:GetDescendants()) do
                    if E.closed or not E.running or E.epoch ~= epoch then return end
                    if obj.Parent and not excluded(obj) then
                        local rootCand = resolveRootCandidate(obj)
                        if rootCand then observe(rootCand) end
                    end
                    if i % 32 == 0 and os.clock() - sliceStart > 0.003 then task.wait() sliceStart = os.clock() end
                end
            end)
        end
        safe(step)
    end

    UI_Elements._CleanupWorldESP = function()
        if E.closed then return end
        E.closed = true
        stop()
    end

    table.insert(connections, ScreenGui.Destroying:Connect(UI_Elements._CleanupWorldESP))
    UI_Elements._RefreshWorldESP()
end
UI_Elements._InitWorldESP()
UI_Elements._InitWorldESP = nil

