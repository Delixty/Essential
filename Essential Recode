local function ColorClose(a, b)
    if not a or not b then return false end
    return math.abs(a.R - b.R) < 0.03 and math.abs(a.G - b.G) < 0.03 and math.abs(a.B - b.B) < 0.03
end

local function TagThemeRolesInTree(root)
    if not root then return end
    local e = Themes.Essential
    local w = Themes.Winter
    local nodes = root:GetDescendants()
    table.insert(nodes, 1, root)

    for _, obj in ipairs(nodes) do
        if obj.Name ~= "WinterDecorOverlay" and not obj:IsDescendantOf(UI_Elements._WinterDecor or game) then
            -- Разметка фоновых ролей
            if (obj:IsA("Frame") or obj:IsA("CanvasGroup") or obj:IsA("ScrollingFrame") or obj:IsA("TextButton") or obj:IsA("TextLabel") or obj:IsA("ImageLabel"))
                and not obj:GetAttribute("_ThemeBgRole") then
                local bg = obj.BackgroundColor3
                if obj.Name == "BackgroundShade" then
                    obj:SetAttribute("_ThemeBgRole", "Shade")
                elseif obj.Name == "MainContentClip" or obj.Name == "EssentialHUD" or obj.Name == "PlayerClip" or ColorClose(bg, e.BgMain) or ColorClose(bg, w.BgMain) or ColorClose(bg, Color3.fromRGB(19, 16, 27)) then
                    if obj.BackgroundTransparency < 0.99 or obj == UI_Elements._MainFrameRef then
                        obj:SetAttribute("_ThemeBgRole", "BgMain")
                    end
                elseif ColorClose(bg, e.BgHeader) or ColorClose(bg, w.BgHeader) then
                    obj:SetAttribute("_ThemeBgRole", "BgHeader")
                elseif ColorClose(bg, e.BgSidebar) or ColorClose(bg, w.BgSidebar) then
                    obj:SetAttribute("_ThemeBgRole", "BgSidebar")
                elseif ColorClose(bg, e.BgElement) or ColorClose(bg, w.BgElement) then
                    obj:SetAttribute("_ThemeBgRole", "BgElement")
                elseif ColorClose(bg, e.BgDark) or ColorClose(bg, w.BgDark) then
                    obj:SetAttribute("_ThemeBgRole", "BgDark")
                elseif ColorClose(bg, e.ToggleOff) or ColorClose(bg, w.ToggleOff) or ColorClose(bg, Color3.fromRGB(58, 50, 70)) then
                    obj:SetAttribute("_ThemeBgRole", "ToggleOff")
                end
            end

            -- Разметка текстовых ролей
            if (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")) and not obj:GetAttribute("_ThemeTextRole") then
                if not table.find(ThemeElements.Texts, obj) then
                    local tc = obj.TextColor3
                    if ColorClose(tc, e.TextMuted) or ColorClose(tc, w.TextMuted) then
                        obj:SetAttribute("_ThemeTextRole", "TextMuted")
                    elseif ColorClose(tc, e.TextColor) or ColorClose(tc, w.TextColor) or ColorClose(tc, Color3.fromRGB(240, 237, 247)) then
                        obj:SetAttribute("_ThemeTextRole", "TextColor")
                    end
                end
                if obj:IsA("TextBox") then
                    obj:SetAttribute("_ThemePlaceholderRole", "TextMuted")
                end
            end
        end
    end
end

local function ApplyTheme(themeName, instant, accentOnly)
    local resolvedName, preset, base, gradEnd, strokeMain, strokeDark = GetActiveThemeColors(themeName)
    Settings.ThemeType = resolvedName
    if UI_Elements._RefreshBackground and not accentOnly then UI_Elements._RefreshBackground(resolvedName) end

    -- Обновляем базовые цвета для всех новых элементов
    BgMain = preset.BgMain
    BgHeader = preset.BgHeader
    BgSidebar = preset.BgSidebar
    BgElement = preset.BgElement
    BgDark = preset.BgDark
    ToggleOffColor = preset.ToggleOff
    TextColor = preset.TextColor
    TextMuted = preset.TextMuted

    local twInfo = TweenInfo.new(instant and 0 or 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local function setOrTween(obj, props)
        if not obj or not obj.Parent then return end
        if instant then
            for k, v in pairs(props) do obj[k] = v end
        else
            TweenService:Create(obj, twInfo, props):Play()
        end
    end

    local gradSeq = ColorSequence.new({
        ColorSequenceKeypoint.new(0, base),
        ColorSequenceKeypoint.new(1, gradEnd)
    })

    local function paint(list, color, isGrad)
        for i = #list, 1, -1 do
            local obj = list[i]
            if obj and obj.Parent then
                if isGrad then
                    obj.Color = color
                elseif obj:IsA("UIStroke") then
                    setOrTween(obj, { Color = color })
                elseif obj:IsA("TextLabel") or obj:IsA("TextBox") or obj:IsA("TextButton") then
                    setOrTween(obj, { TextColor3 = color })
                elseif obj:IsA("Frame") or obj:IsA("ScrollingFrame") then
                    setOrTween(obj, { BackgroundColor3 = color })
                end
            else
                table.remove(list, i)
            end
        end
    end

    paint(ThemeElements.Gradients, gradSeq, true)
    paint(ThemeElements.Texts, base, false)
    paint(ThemeElements.MainStrokes, strokeMain, false)
    paint(ThemeElements.DarkStrokes, strokeDark, false)

    for i = #ThemeElements.Scrollbars, 1, -1 do
        local obj = ThemeElements.Scrollbars[i]
        if obj and obj.Parent then
            setOrTween(obj, { ScrollBarImageColor3 = strokeMain })
        else
            table.remove(ThemeElements.Scrollbars, i)
        end
    end

    -- Обновляем все контейнеры, карточки, поля ввода, переключатели и подписи в ScreenGui
    local roots = {
        UI_Elements._MainFrameRef,
        UI_Elements._ScreenGuiRef and UI_Elements._ScreenGuiRef:FindFirstChild("EssentialHUD"),
        UI_Elements._ScreenGuiRef and UI_Elements._ScreenGuiRef:FindFirstChild("EssentialSoundPill")
    }
    for _, root in ipairs(accentOnly and {} or roots) do
        if root and root.Parent then
            TagThemeRolesInTree(root)
            local nodes = root:GetDescendants()
            table.insert(nodes, 1, root)
            for _, obj in ipairs(nodes) do
                local bgRole = obj:GetAttribute("_ThemeBgRole")
                if bgRole == "BgMain" then
                    setOrTween(obj, { BackgroundColor3 = BgMain })
                elseif bgRole == "BgHeader" then
                    setOrTween(obj, { BackgroundColor3 = BgHeader })
                elseif bgRole == "BgSidebar" then
                    setOrTween(obj, { BackgroundColor3 = BgSidebar })
                elseif bgRole == "BgElement" then
                    setOrTween(obj, { BackgroundColor3 = BgElement })
                elseif bgRole == "BgDark" then
                    if not obj:GetAttribute("EssentialHovered") then
                        setOrTween(obj, { BackgroundColor3 = BgDark })
                    end
                elseif bgRole == "ToggleOff" then
                    local gradChild = obj:FindFirstChildOfClass("UIGradient")
                    if not gradChild or not gradChild.Enabled then
                        setOrTween(obj, { BackgroundColor3 = ToggleOffColor })
                    end
                elseif bgRole == "Shade" then
                    setOrTween(obj, { BackgroundColor3 = preset.ShadeColor, BackgroundTransparency = preset.ShadeTransparency })
                end

                local txtRole = obj:GetAttribute("_ThemeTextRole")
                if txtRole == "TextColor" then
                    setOrTween(obj, { TextColor3 = TextColor })
                elseif txtRole == "TextMuted" then
                    -- Для кнопок вкладок проверяем, не активна ли вкладка
                    local parentBtn = obj.Parent
                    local bgF = parentBtn and parentBtn:FindFirstChildOfClass("Frame")
                    local tabGrad = bgF and bgF:FindFirstChildOfClass("UIGradient")
                    if tabGrad then
                        setOrTween(obj, { TextColor3 = tabGrad.Enabled and Color3.fromRGB(255, 255, 255) or TextMuted })
                    else
