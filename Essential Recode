end

local function RefreshHUDVisibility()
    if not HUDState.container then return end
    HUDState.container.Visible = Settings.HUDEnabled
    HUDState.fps.Visible = Settings.HUDFPS
    HUDState.ping.Visible = Settings.HUDPing
    HUDState.killer.Visible = Settings.HUDKiller
end

local function StartEssentialHUDLoop()
    if HUDState.conn then pcall(function() HUDState.conn:Disconnect() end) HUDState.conn = nil end
    local lastFPSRefresh, lastPingRefresh, lastKillerRefresh, frameCount, frameTimeSum = 0, 0, 0, 0, 0
    HUDState.conn = RunService.RenderStepped:Connect(function(delta)
        if not Settings.HUDEnabled or not HUDState.container or not HUDState.container.Visible then return end
        local now = os.clock() frameCount = frameCount + 1 frameTimeSum = frameTimeSum + delta
        if now - lastFPSRefresh >= 0.5 then lastFPSRefresh = now if Settings.HUDFPS then local avgFPS = math.floor((frameCount / frameTimeSum) + 0.5) HUDState.fps.Text = "FPS: " .. tostring(avgFPS) end frameCount = 0 frameTimeSum = 0 end
        if Settings.HUDPing and now - lastPingRefresh >= 0.5 then
            lastPingRefresh = now local ms = 0
            pcall(function()
                local nPing = LocalPlayer:GetNetworkPing() if nPing and nPing > 0 then ms = nPing * 1000 else
                    local stat = game:GetService("Stats").Network.ServerStatsItem["Data Ping"] if stat then local str = stat:GetValueString() local n = tonumber(tostring(str):match("%d+")) if n then ms = n end end
                end
            end)
            HUDState.ping.Text = "Ping: " .. tostring(math.floor(ms + 0.5)) .. " ms"
        end
        if Settings.HUDKiller and now - lastKillerRefresh >= 1.0 then
            lastKillerRefresh = now local detectedKiller = "Unknown"
            for _, player in ipairs(Players:GetPlayers()) do if player ~= LocalPlayer and player.Character then if isPlayerManiac(player) then detectedKiller = player.Name break end end end
            HUDState.killer.Text = "Killer: " .. detectedKiller
        end
    end)
end

local function TerminateEssentialHUD()
    if HUDState.conn then pcall(function() HUDState.conn:Disconnect() end) HUDState.conn = nil end
    if HUDState.container then pcall(function() HUDState.container:Destroy() end) HUDState.container = nil end
end

local function SetupEssentialHUD()
    if Settings.HUDEnabled then BuildEssentialHUD() RefreshHUDVisibility() StartEssentialHUDLoop() else RefreshHUDVisibility() if HUDState.conn then pcall(function() HUDState.conn:Disconnect() end) HUDState.conn = nil end end
end

