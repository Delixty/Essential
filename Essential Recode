UI_Elements._CursorOver = function(target)
    if not target or not target.Parent or target.AbsoluteSize.X <= 0 then return false end
    local mouse = UserInputService:GetMouseLocation()
    local function inside(o)
        local p, sz = o.AbsolutePosition, o.AbsoluteSize
        return mouse.X >= p.X and mouse.X <= p.X + sz.X and mouse.Y >= p.Y and mouse.Y <= p.Y + sz.Y
    end
    if not inside(target) then return false end
    local o = target.Parent
    while o and o:IsA("GuiObject") do
        if not o.Visible then return false end
        if (o:IsA("CanvasGroup") or o:IsA("ScrollingFrame") or o.ClipsDescendants) and not inside(o) then return false end
        o = o.Parent
    end
    return true
end
