local function ActivateTab(tabEntry)
    if not tabEntry then return end
    activeTabEntry = tabEntry
    local searching = SearchResultsFrame.Visible
    for _, t in ipairs(tabs) do
        local isTarget = (t == tabEntry)
        t.page.Visible = (not searching) and isTarget
        TweenService:Create(t.bgFrame, TweenInfo.new(0.25), {BackgroundTransparency = isTarget and 0 or 1}):Play()
        TweenService:Create(t.lbl, TweenInfo.new(0.25), {TextColor3 = isTarget and Color3.fromRGB(255, 255, 255) or TextMuted}):Play()
        t.grad.Enabled = isTarget
    end
