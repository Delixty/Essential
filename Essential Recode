    table.insert(ThemeElements.MainStrokes,stroke)
    local surface=Instance.new("CanvasGroup",pill)
    surface.Name="PlayerClip" surface.Position=UDim2.fromOffset(2,2) surface.Size=UDim2.new(1,-4,1,-4)
    surface.BackgroundColor3=Color3.fromRGB(19,16,27) surface.BorderSizePixel=0
    local surfaceCorner=Instance.new("UICorner",surface) surfaceCorner.CornerRadius=UDim.new(0,14)
    local expanded=Instance.new("CanvasGroup",surface)
    expanded.Name="ExpandedView" expanded.Size=UDim2.fromScale(1,1) expanded.BackgroundTransparency=1
    local small=Instance.new("CanvasGroup",surface)
    small.Name="CollapsedView" small.Size=UDim2.fromScale(1,1) small.BackgroundTransparency=1 small.GroupTransparency=1
    local function connect(signal,fn)
        local c=signal:Connect(fn) state.connList[#state.connList+1]=c return c
    end
    local function rounded(obj,r) Instance.new("UICorner",obj).CornerRadius=UDim.new(0,r) end
    local function text(parent,value,size)
        local l=Instance.new("TextLabel",parent) l.Text=value l.TextSize=size l.Font=Enum.Font.Gotham
        l.TextColor3=Color3.fromRGB(240,237,247) l.BackgroundTransparency=1
        l.TextXAlignment=Enum.TextXAlignment.Left l.TextTruncate=Enum.TextTruncate.AtEnd
        return l
    end
    local function rect(obj,x,y,w,h)
        obj.Position=UDim2.fromOffset(x,y) obj.Size=UDim2.fromOffset(w,h)
    end
    local art=Instance.new("ImageLabel",expanded) art.BackgroundColor3=BgElement art.ScaleType=Enum.ScaleType.Crop rounded(art,8)
    local title=text(expanded,state.title,14) title.Font=Enum.Font.GothamBold
    local artist=text(expanded,state.artist,11) artist.TextColor3=TextMuted
    local clock=text(expanded,"0:00 / 0:00",10)
    local bars=Instance.new("Frame",expanded) bars.BackgroundTransparency=1
    local barList={}
    for i=1,4 do
        local bar=Instance.new("Frame",bars) bar.BorderSizePixel=0 rounded(bar,2)
        table.insert(ThemeElements.Texts,bar) barList[i]=bar
    end
    local progress=Instance.new("Frame",expanded) progress.BackgroundColor3=Color3.fromRGB(58,50,70) progress.BorderSizePixel=0 rounded(progress,2)
    local fill=Instance.new("Frame",progress) fill.BorderSizePixel=0 fill.Size=UDim2.fromScale(0,1) rounded(fill,2)
