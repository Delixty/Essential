    volumeBar.BackgroundColor3=Color3.fromRGB(58,50,70) volumeBar.BorderSizePixel=0 rounded(volumeBar,3)
    local volumeFill=Instance.new("Frame",volumeBar) volumeFill.BorderSizePixel=0 rounded(volumeFill,3)
