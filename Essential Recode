local function ApplyPreset(preset, fromToggleOrLoad)
    Settings.SkyPreset = preset
    if UI_Elements.presetDropdown then UI_Elements.presetDropdown(preset, true) end
    if preset == "Default" then
        if not fromToggleOrLoad and Settings.SkyEnabled then
            Settings.SkyEnabled = false
            if UI_Elements.toggleSky then UI_Elements.toggleSky(false, true) end
            ResetSkybox()
        elseif Settings.SkyEnabled then
            EnableSkyboxListeners()
            EnforceSkybox()
        else
            ResetSkybox()
        end
        return
    end
    local pr = PresetDefinitions[preset]
    if pr then
        SkyboxState.ApplyingPreset = true
        Settings.SkyR = pr.skyR Settings.SkyG = pr.skyG Settings.SkyB = pr.skyB
        Settings.HorR = pr.horR Settings.HorG = pr.horG Settings.HorB = pr.horB
        Settings.SkyBright = pr.bright Settings.SkyExp = pr.exp Settings.SkyClock = pr.clock
        SkySettings.StarCount = pr.starCount or 1000 SkySettings.SunAngularSize = pr.sunSize or 11 SkySettings.MoonAngularSize = pr.moonSize or 11 SkySettings.CelestialBodiesShown = pr.celestial ~= false
        SyncSkySlidersSilent()
        SkyboxState.ApplyingPreset = false
    end
    if not fromToggleOrLoad and not Settings.SkyEnabled then
        Settings.SkyEnabled = true
        if UI_Elements.toggleSky then UI_Elements.toggleSky(true, true) end
    end
    if Settings.SkyEnabled then
        EnableSkyboxListeners()
        EnforceSkybox()
    end
end

