-- PNG GLYPHS (heart): rendered once in pure Luau, cached with writefile, tinted with ImageColor3.
-- glyphFn returns true/false or a coverage number 0..1.
-- ==============================================
UI_Elements._MakePng = function(fileName, W, H, SS, glyphFn)
    local assetFn = getcustomasset or getsynasset
    if type(assetFn) ~= "function" or type(writefile) ~= "function" then return nil end
    local ok, result = pcall(function()
        if not (type(isfile) == "function" and isfile(fileName)) then
            local rows = {}
            for py = 0, H - 1 do
                local px = { "\0" }
                for pxl = 0, W - 1 do
                    local sum = 0
                    for sy = 0, SS - 1 do
                        for sx = 0, SS - 1 do
                            local g = glyphFn((pxl + (sx + 0.5) / SS) / W, (py + (sy + 0.5) / SS) / H)
                            if g == true then sum = sum + 1 elseif type(g) == "number" then sum = sum + g end
                        end
                    end
                    px[#px + 1] = string.char(255, 255, 255, math.clamp(math.floor(sum / (SS * SS) * 255 + 0.5), 0, 255))
                end
                rows[#rows + 1] = table.concat(px)
            end
            local raw = table.concat(rows)
            local crcTable = {}
            for n = 0, 255 do
                local c = n
                for _ = 1, 8 do
                    if bit32.band(c, 1) == 1 then c = bit32.bxor(0xEDB88320, bit32.rshift(c, 1)) else c = bit32.rshift(c, 1) end
                end
                crcTable[n + 1] = c
            end
            local function crc32(str)
                local crc = 0xFFFFFFFF
                for i = 1, #str do
                    crc = bit32.bxor(crcTable[bit32.band(bit32.bxor(crc, string.byte(str, i)), 0xFF) + 1], bit32.rshift(crc, 8))
                end
                return bit32.bxor(crc, 0xFFFFFFFF)
            end
            local function adler32(str)
                local s1, s2 = 1, 0
                for i = 1, #str do
                    s1 = (s1 + string.byte(str, i)) % 65521
                    s2 = (s2 + s1) % 65521
                end
                return s2 * 65536 + s1
            end
            local function chunk(kind, data)
                return string.pack(">I4", #data) .. kind .. data .. string.pack(">I4", crc32(kind .. data))
            end
            local len = #raw
            local z = "\120\1" .. "\1" .. string.pack("<I2", len) .. string.pack("<I2", bit32.bxor(len, 0xFFFF)) .. raw .. string.pack(">I4", adler32(raw))
            local png = "\137PNG\r\n\26\n" .. chunk("IHDR", string.pack(">I4I4", W, H) .. "\8\6\0\0\0") .. chunk("IDAT", z) .. chunk("IEND", "")
            writefile(fileName, png)
        end
        return assetFn(fileName)
    end)
    if ok then return result end
    return nil
end

do
    local function HeartImplicit(x, y, scale, cy)
        local px, py = (x - 0.5) * scale, (cy - y) * scale
        local a = px * px + py * py - 1
        return a * a * a - px * px * py * py * py
    end
    local function HeartGlyph(x, y) return HeartImplicit(x, y, 2.5, 0.56) <= 0 end
    local function HeartGlowGlyph(x, y)
        local f = HeartImplicit(x, y, 3.6, 0.5417)
        if f <= 0 then return 1 end
        local h = f ^ (1 / 3)
        local a = math.clamp(1 - h / 0.85, 0, 1)
        return a * a * 0.9
    end
    UI_Elements._HeartAsset = UI_Elements._MakePng("Essential-Heart-v1.png", 48, 48, 3, HeartGlyph)
    UI_Elements._HeartGlowAsset = UI_Elements._MakePng("Essential-HeartGlow-v1.png", 64, 64, 2, HeartGlowGlyph)
end

