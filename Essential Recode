    local lbl = Instance.new("TextLabel", btn) lbl.Size = UDim2.new(1, 0, 1, 0) lbl.BackgroundTransparency = 1 lbl.Text = name lbl.TextColor3 = TextMuted lbl.TextSize = 13 lbl.Font = Enum.Font.GothamBold lbl.ZIndex = 2
