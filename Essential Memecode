end)
pcall(function()
    if RunService.PreRender then
        fovPreRenderConn = RunService.PreRender:Connect(function()
            ForceFOV()
            task.defer(ForceFOV)
        end)
        table.insert(connections, fovPreRenderConn)
    end
end)
fovHeartbeatConn = RunService.Heartbeat:Connect(function() ForceFOV() end)
table.insert(connections, fovHeartbeatConn)
