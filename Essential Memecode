local RemovedAtmospheres = {}
local RemovedSkies = {}
local CustomAtmosphere = nil
local CustomSkyCC = nil
local _applyingPreset = false
local function GetTargetBrightness() return (Settings.SkyBright / 100) * 6 end
local function GetTargetExposure() return (Settings.SkyExp / 100) * 2 - 1 end
local function GetTargetSkyColor() return Color3.fromRGB(Settings.SkyR, Settings.SkyG, Settings.SkyB) end
local function GetTargetHorizonColor() return Color3.fromRGB(Settings.HorR, Settings.HorG, Settings.HorB) end
local function GetTargetAmbient()
    return Color3.fromRGB(
        math.clamp(math.floor(Settings.SkyR * 0.45 + Settings.HorR * 0.2), 0, 255),
        math.clamp(math.floor(Settings.SkyG * 0.45 + Settings.HorG * 0.2), 0, 255),
        math.clamp(math.floor(Settings.SkyB * 0.45 + Settings.HorB * 0.2), 0, 255)
    )
end
local function StoreAtmosphere(atmo)
    for _, a in ipairs(RemovedAtmospheres) do if a == atmo then return end end
    table.insert(RemovedAtmospheres, atmo)
end
local function StoreSky(sk)
    for _, a in ipairs(RemovedSkies) do if a == sk then return end end
    table.insert(RemovedSkies, sk)
end
local function EnsureCustomSky()
    local foundCustom = nil
    local foundAtmo = nil
    local foundCC = nil
    for _, obj in ipairs(Lighting:GetChildren()) do
        if obj:IsA("Sky") then
            if obj.Name == "EssentialCustomSky" then foundCustom = obj
            else StoreSky(obj) pcall(function() obj.Parent = nil end) end
        elseif obj:IsA("Atmosphere") then
            if obj.Name == "EssentialCustomAtmosphere" then foundAtmo = obj
            else StoreAtmosphere(obj) pcall(function() obj.Parent = nil end) end
        elseif obj:IsA("ColorCorrectionEffect") and obj.Name == "EssentialSkyCC" then
            foundCC = obj
        end
    end
    if not foundCustom or foundCustom.Parent ~= Lighting then
        local ns = CustomSky or Instance.new("Sky")
        ns.Name = "EssentialCustomSky"
        pcall(function() ns.Parent = Lighting end)
        CustomSky = ns foundCustom = ns
    else CustomSky = foundCustom end
    if not foundAtmo or foundAtmo.Parent ~= Lighting then
        local na = CustomAtmosphere or Instance.new("Atmosphere")
        na.Name = "EssentialCustomAtmosphere"
        pcall(function() na.Parent = Lighting end)
        CustomAtmosphere = na foundAtmo = na
    else CustomAtmosphere = foundAtmo end
    if not foundCC or foundCC.Parent ~= Lighting then
        local ncc = CustomSkyCC or Instance.new("ColorCorrectionEffect")
        ncc.Name = "EssentialSkyCC"
        pcall(function() ncc.Parent = Lighting end)
        CustomSkyCC = ncc foundCC = ncc
    else CustomSkyCC = foundCC end
    return foundCustom, foundAtmo, foundCC
end

local SOLID_SKY_TEXTURE = "rbxassetid://159981303"

local function EnforceSkybox()
    if not Settings.SkyEnabled then return end
    local sky, atmo, cc = EnsureCustomSky()
    local skyCol = GetTargetSkyColor()
    local horCol = GetTargetHorizonColor()
    pcall(function()
        if sky then
            -- Pin skybox cube faces so the sky dome stays anchored 360° regardless of camera pitch/rotation
            if sky.SkyboxBk ~= SOLID_SKY_TEXTURE then
                sky.SkyboxBk = SOLID_SKY_TEXTURE
                sky.SkyboxDn = SOLID_SKY_TEXTURE
                sky.SkyboxFt = SOLID_SKY_TEXTURE
                sky.SkyboxLf = SOLID_SKY_TEXTURE
                sky.SkyboxRt = SOLID_SKY_TEXTURE
                sky.SkyboxUp = SOLID_SKY_TEXTURE
            end
            sky.StarCount = SkySettings.StarCount
            sky.SunAngularSize = SkySettings.SunAngularSize
            sky.MoonAngularSize = SkySettings.MoonAngularSize
            sky.CelestialBodiesShown = SkySettings.CelestialBodiesShown
        end
        if atmo then
            -- Zero out fog density & haze so the skybox dome is never occluded or washed out on camera turn
            atmo.Density = 0.05
            atmo.Offset = 0
            atmo.Color = skyCol
            atmo.Decay = horCol
            atmo.Glare = 0
            atmo.Haze = 0
        end
        if cc then
            cc.Enabled = true
            cc.TintColor = skyCol:Lerp(Color3.fromRGB(255, 255, 255), 0.6)
            cc.Brightness = (Settings.SkyBright - 50) / 250
            cc.Contrast = 0.05
            cc.Saturation = 0.1
        end
        Lighting.Brightness = GetTargetBrightness()
        Lighting.ExposureCompensation = GetTargetExposure()
        Lighting.ColorShift_Top = skyCol
        Lighting.ColorShift_Bottom = horCol
        Lighting.OutdoorAmbient = horCol
        Lighting.Ambient = GetTargetAmbient()
        Lighting.ClockTime = Settings.SkyClock
        if not Settings.CustomFog then
            Lighting.FogColor = horCol
            Lighting.FogStart = 50000
            Lighting.FogEnd = 100000
        end
    end)
end
local function ApplySkybox()
    if not Settings.SkyEnabled then return end
    EnforceSkybox()
end
local function ResetSkybox()
    pcall(function()
        if CustomSky then pcall(function() CustomSky:Destroy() end) CustomSky = nil end
        if CustomAtmosphere then pcall(function() CustomAtmosphere:Destroy() end) CustomAtmosphere = nil end
        if CustomSkyCC then pcall(function() CustomSkyCC:Destroy() end) CustomSkyCC = nil end
        for _, obj in ipairs(Lighting:GetChildren()) do
            if (obj:IsA("Sky") and obj.Name == "EssentialCustomSky")
                or (obj:IsA("Atmosphere") and obj.Name == "EssentialCustomAtmosphere")
                or (obj:IsA("ColorCorrectionEffect") and obj.Name == "EssentialSkyCC") then
                pcall(function() obj:Destroy() end)
            end
        end
        for _, sk in ipairs(RemovedSkies) do pcall(function() if sk and sk.Parent == nil then sk.Parent = Lighting end end) end
        for _, atmo in ipairs(RemovedAtmospheres) do pcall(function() if atmo and atmo.Parent == nil then atmo.Parent = Lighting end end) end
        if DefaultAtmosphere and DefaultAtmosphere.Parent == nil then pcall(function() DefaultAtmosphere.Parent = Lighting end) end
        Lighting.Brightness = DefaultLighting.Brightness Lighting.ExposureCompensation = DefaultLighting.ExposureCompensation Lighting.Ambient = DefaultLighting.Ambient Lighting.OutdoorAmbient = DefaultLighting.OutdoorAmbient Lighting.ColorShift_Top = DefaultLighting.ColorShift_Top Lighting.ColorShift_Bottom = DefaultLighting.ColorShift_Bottom Lighting.ClockTime = DefaultLighting.ClockTime
        if not Settings.CustomFog then Lighting.FogColor = DefaultLighting.FogColor end
    end)
end
