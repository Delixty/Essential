local function GetTextureProfile(mode)
    if mode == "Performance" then
        return { Quality = Enum.QualityLevel.Level01, MeshDetail = "Level01", LOD = 8, Shadows = false, Tech = Enum.Technology.Legacy, Blur = true }
    elseif mode == "Quality" then
        return { Quality = Enum.QualityLevel.Level05, MeshDetail = "Level03", LOD = 0, Shadows = true, Tech = Enum.Technology.ShadowMap, Blur = false }
    else -- Balanced
        return { Quality = Enum.QualityLevel.Level03, MeshDetail = "Level02", LOD = 2, Shadows = false, Tech = Enum.Technology.Legacy, Blur = false }
    end
end

local function IsCharacterPart(part)
    local cur = part.Parent
    while cur and cur ~= workspace and cur ~= game do
        if cur:FindFirstChildOfClass("Humanoid") then return true end
        cur = cur.Parent
    end
    return false
end

local function SaveAndBlurObject(obj)
    if not obj or not obj.Parent then return end
    if obj:IsA("BasePart") then
        if IsCharacterPart(obj) then return end
        if LowGraphicsState.OriginalMaterial[obj] == nil then
            pcall(function() LowGraphicsState.OriginalMaterial[obj] = obj.Material end)
        end
        if LowGraphicsState.OriginalMaterialVariant[obj] == nil then
            pcall(function() LowGraphicsState.OriginalMaterialVariant[obj] = obj.MaterialVariant end)
        end
        if LowGraphicsState.OriginalReflectance[obj] == nil then
            pcall(function() LowGraphicsState.OriginalReflectance[obj] = obj.Reflectance end)
        end
        pcall(function() obj.Material = Enum.Material.SmoothPlastic end)
        pcall(function() obj.MaterialVariant = "" end)
        pcall(function() obj.Reflectance = 0 end)
        if obj:IsA("MeshPart") then
            if LowGraphicsState.OriginalMeshTextureID[obj] == nil then
                pcall(function() LowGraphicsState.OriginalMeshTextureID[obj] = obj.TextureID end)
            end
            if LowGraphicsState.OriginalMeshLOD[obj] == nil then
                pcall(function() LowGraphicsState.OriginalMeshLOD[obj] = obj.TextureLODBias end)
            end
            if LowGraphicsState.OriginalMeshFidelity[obj] == nil then
                pcall(function() LowGraphicsState.OriginalMeshFidelity[obj] = obj.RenderFidelity end)
            end
            pcall(function() obj.TextureID = "" end)
            pcall(function() obj.TextureLODBias = 8 end)
            pcall(function() obj.RenderFidelity = Enum.RenderFidelity.Performance end)
        end
    elseif obj:IsA("SpecialMesh") then
        if obj.Parent and IsCharacterPart(obj.Parent) then return end
        if LowGraphicsState.OriginalSpecialMeshTex[obj] == nil then
            pcall(function() LowGraphicsState.OriginalSpecialMeshTex[obj] = obj.TextureId end)
        end
        pcall(function() obj.TextureId = "" end)
    elseif obj:IsA("SurfaceAppearance") then
        if obj.Parent and obj.Parent ~= HiddenPBRFolder then
            if IsCharacterPart(obj.Parent) then return end
            if LowGraphicsState.HiddenSurfaceApps[obj] == nil then
                LowGraphicsState.HiddenSurfaceApps[obj] = obj.Parent
            end
            pcall(function() obj.Parent = HiddenPBRFolder end)
        end
    elseif obj:IsA("Decal") or obj:IsA("Texture") then
        if obj.Parent and IsCharacterPart(obj.Parent) then return end
        if LowGraphicsState.OriginalDecalTrans[obj] == nil then
            pcall(function() LowGraphicsState.OriginalDecalTrans[obj] = obj.Transparency end)
        end
        pcall(function() obj.Transparency = 1 end)
    end
end

local function ApplyTerrainBlur()
    local terrain = workspace:FindFirstChildOfClass("Terrain")
    if not terrain then return end
    if not LowGraphicsState.Terrain then
        local saved = {}
        pcall(function() saved.Decoration = terrain.Decoration end)
        pcall(function() saved.WaterWaveSize = terrain.WaterWaveSize end)
        pcall(function() saved.WaterWaveSpeed = terrain.WaterWaveSpeed end)
        pcall(function() saved.WaterReflectance = terrain.WaterReflectance end)
        pcall(function() saved.WaterTransparency = terrain.WaterTransparency end)
        LowGraphicsState.Terrain = saved
    end
    pcall(function()
        terrain.Decoration = false
        terrain.WaterWaveSize = 0
        terrain.WaterWaveSpeed = 0
        terrain.WaterReflectance = 0
        terrain.WaterTransparency = 1
    end)
end

local function RestoreTerrainBlur()
    local terrain = workspace:FindFirstChildOfClass("Terrain")
    local saved = LowGraphicsState.Terrain
    if terrain and saved then
        pcall(function()
            if saved.Decoration ~= nil then terrain.Decoration = saved.Decoration end
            if saved.WaterWaveSize ~= nil then terrain.WaterWaveSize = saved.WaterWaveSize end
            if saved.WaterWaveSpeed ~= nil then terrain.WaterWaveSpeed = saved.WaterWaveSpeed end
            if saved.WaterReflectance ~= nil then terrain.WaterReflectance = saved.WaterReflectance end
            if saved.WaterTransparency ~= nil then terrain.WaterTransparency = saved.WaterTransparency end
        end)
    end
    LowGraphicsState.Terrain = nil
end

local _blurWorkerRunning = false

local function ApplyPerformanceBlur()
    LowGraphicsState.BlurApplied = true
    ApplyTerrainBlur()
    if _blurWorkerRunning then return end
    _blurWorkerRunning = true
    task.spawn(function()
        local objs = workspace:GetDescendants()
        for i = 1, #objs do
            if not Settings.LowGraphics or Settings.TextureQuality ~= "Performance" then break end
            SaveAndBlurObject(objs[i])
            -- Yield every 120 items so the main render thread never drops frames during blur
            if i % 120 == 0 then task.wait() end
        end
        _blurWorkerRunning = false
    end)
end

local function RestorePerformanceBlur()
    LowGraphicsState.BlurApplied = false
    _blurWorkerRunning = false

    for part, mat in pairs(LowGraphicsState.OriginalMaterial) do
        if part and part.Parent then pcall(function() part.Material = mat end) end
    end
    for part, mv in pairs(LowGraphicsState.OriginalMaterialVariant) do
        if part and part.Parent then pcall(function() part.MaterialVariant = mv end) end
    end
    for part, ref in pairs(LowGraphicsState.OriginalReflectance) do
        if part and part.Parent then pcall(function() part.Reflectance = ref end) end
    end
    for mesh, texId in pairs(LowGraphicsState.OriginalMeshTextureID) do
        if mesh and mesh.Parent then pcall(function() mesh.TextureID = texId end) end
    end
    for mesh, lod in pairs(LowGraphicsState.OriginalMeshLOD) do
        if mesh and mesh.Parent then pcall(function() mesh.TextureLODBias = lod end) end
    end
    for mesh, fid in pairs(LowGraphicsState.OriginalMeshFidelity) do
        if mesh and mesh.Parent then pcall(function() mesh.RenderFidelity = fid end) end
    end
    for sm, texId in pairs(LowGraphicsState.OriginalSpecialMeshTex) do
        if sm and sm.Parent then pcall(function() sm.TextureId = texId end) end
    end
    for sa, origParent in pairs(LowGraphicsState.HiddenSurfaceApps) do
        if sa and origParent and origParent.Parent then
            pcall(function() sa.Parent = origParent end)
        end
    end
    for dec, trans in pairs(LowGraphicsState.OriginalDecalTrans) do
        if dec and dec.Parent then pcall(function() dec.Transparency = trans end) end
    end

    LowGraphicsState.OriginalMaterial = {}
    LowGraphicsState.OriginalMaterialVariant = {}
    LowGraphicsState.OriginalReflectance = {}
    LowGraphicsState.OriginalMeshTextureID = {}
    LowGraphicsState.OriginalMeshLOD = {}
    LowGraphicsState.OriginalMeshFidelity = {}
    LowGraphicsState.OriginalSpecialMeshTex = {}
    LowGraphicsState.HiddenSurfaceApps = {}
    LowGraphicsState.OriginalDecalTrans = {}

    RestoreTerrainBlur()
end

local function ApplyLowTextureToObject(obj)
    if not Settings.LowGraphics then return end
    if not obj or not obj.Parent then return end
    local profile = GetTextureProfile(Settings.TextureQuality)

    if profile.Blur then
        SaveAndBlurObject(obj)
    elseif obj:IsA("MeshPart") then
        if LowGraphicsState.OriginalMeshLOD[obj] == nil then
            pcall(function() LowGraphicsState.OriginalMeshLOD[obj] = obj.TextureLODBias end)
        end
        if LowGraphicsState.OriginalMeshFidelity[obj] == nil then
            pcall(function() LowGraphicsState.OriginalMeshFidelity[obj] = obj.RenderFidelity end)
        end
        pcall(function() obj.TextureLODBias = profile.LOD end)
        pcall(function() obj.RenderFidelity = Enum.RenderFidelity.Performance end)
    end
end

local function DisablePostEffects(parent)
    if not parent then return end
    for _, obj in ipairs(parent:GetDescendants()) do
        if obj:IsA("PostEffect") and obj.Name ~= "EssentialSkyCC" then
            if LowGraphicsState.PostEffects[obj] == nil then LowGraphicsState.PostEffects[obj] = obj.Enabled end
            pcall(function() obj.Enabled = false end)
        end
    end
end

local function ApplyLowGraphics()
    if not Settings.LowGraphics then return end
    local profile = GetTextureProfile(Settings.TextureQuality)

    pcall(function() settings().Rendering.QualityLevel = profile.Quality end)
    pcall(function() settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel[profile.MeshDetail] end)
    pcall(function()
        if Enum.TextureQuality then
            settings().Rendering.TextureQuality = profile.Blur and Enum.TextureQuality.Low or Enum.TextureQuality.Automatic
        end
    end)

    pcall(function() Lighting.GlobalShadows = profile.Shadows end)
    pcall(function() Lighting.Technology = profile.Tech end)

    DisablePostEffects(Lighting)
    DisablePostEffects(workspace.CurrentCamera)

    if profile.Blur then
        ApplyPerformanceBlur()
    else
        RestorePerformanceBlur()
        task.spawn(function()
            local objs = workspace:GetDescendants()
            for i = 1, #objs do
                if not Settings.LowGraphics or Settings.TextureQuality == "Performance" then break end
                local o = objs[i]
                if o:IsA("MeshPart") then
                    if LowGraphicsState.OriginalMeshLOD[o] == nil then
                        pcall(function() LowGraphicsState.OriginalMeshLOD[o] = o.TextureLODBias end)
                    end
                    if LowGraphicsState.OriginalMeshFidelity[o] == nil then
                        pcall(function() LowGraphicsState.OriginalMeshFidelity[o] = o.RenderFidelity end)
                    end
                    pcall(function() o.TextureLODBias = profile.LOD end)
                    pcall(function() o.RenderFidelity = Enum.RenderFidelity.Performance end)
                end
                if i % 1500 == 0 then task.wait() end
            end
        end)
    end

    LowGraphicsState.Applied = true
end

local function RestoreLowGraphics()
    RestorePerformanceBlur()

    pcall(function() settings().Rendering.QualityLevel = LowGraphicsState.SavedQuality or Enum.QualityLevel.Automatic end)
    pcall(function()
        if LowGraphicsState.SavedMeshDetail then
            settings().Rendering.MeshPartDetailLevel = LowGraphicsState.SavedMeshDetail
        else
            settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level04
        end
    end)
    pcall(function()
        if Enum.TextureQuality then
            settings().Rendering.TextureQuality = LowGraphicsState.SavedTextureQuality or Enum.TextureQuality.Automatic
        end
    end)

    pcall(function() Lighting.GlobalShadows = LowGraphicsState.SavedGlobalShadows end)
    if LowGraphicsState.SavedTechnology then pcall(function() Lighting.Technology = LowGraphicsState.SavedTechnology end) end

    for obj, state in pairs(LowGraphicsState.PostEffects) do
        if obj and obj.Parent then pcall(function() obj.Enabled = state end) end
    end
    LowGraphicsState.PostEffects = {}
    LowGraphicsState.Applied = false
end

local function RefreshLowGraphics()
    if Settings.LowGraphics then ApplyLowGraphics() else RestoreLowGraphics() end
end

-- Throttle DescendantAdded during matches so rapid part spawning doesn't stutter the game
local _pendingLowGFXQueue = {}
local _pendingLowGFXScheduled = false

table.insert(connections, workspace.DescendantAdded:Connect(function(obj)
    if not Settings.LowGraphics then return end
    table.insert(_pendingLowGFXQueue, obj)
    if not _pendingLowGFXScheduled then
        _pendingLowGFXScheduled = true
        task.delay(0.2, function()
            _pendingLowGFXScheduled = false
            if not Settings.LowGraphics then _pendingLowGFXQueue = {} return end
            local count = #_pendingLowGFXQueue
            for i = 1, math.min(count, 80) do
                local o = _pendingLowGFXQueue[i]
                if o and o.Parent then ApplyLowTextureToObject(o) end
            end
            _pendingLowGFXQueue = {}
        end)
    end
end))

