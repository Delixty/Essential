-- AUTO MOONWALK v3 (Works in-match: steers AlignOrientation & BodyGyro + WASD fallback)
-- ==============================================
local moonwalkBound = false
local moonwalkSavedAutoRotate = nil
local moonwalkHeartbeatConn = nil
local moonwalkSteppedConn = nil
local moonwalkPreRenderConn = nil
local DisabledOrientConstraints = {}

local function GetMoonwalkParts()
    local char = LocalPlayer.Character
    if not char then return nil, nil, nil end
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart or char:FindFirstChildWhichIsA("BasePart")
    return char, hum, hrp
end

local function RestoreMoonwalkConstraints()
    for inst, saved in pairs(DisabledOrientConstraints) do
        if inst and inst.Parent then
            pcall(function()
                if inst:IsA("AlignOrientation") then
                    inst.Enabled = saved.Enabled
                elseif inst:IsA("BodyGyro") then
                    inst.MaxTorque = saved.MaxTorque
                end
            end)
        end
    end
    DisabledOrientConstraints = {}
end

local function SuppressCharacterOrientConstraints(char, goalCF)
    if not char then return end
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("AlignOrientation") then
            if DisabledOrientConstraints[d] == nil then
                pcall(function() DisabledOrientConstraints[d] = { Enabled = d.Enabled } end)
            end
            pcall(function() d.CFrame = goalCF d.Enabled = false end)
        elseif d:IsA("BodyGyro") then
            if DisabledOrientConstraints[d] == nil then
                pcall(function() DisabledOrientConstraints[d] = { MaxTorque = d.MaxTorque } end)
            end
            pcall(function() d.CFrame = goalCF d.MaxTorque = Vector3.new(0, 0, 0) end)
        end
    end
end

local function RestoreAutoRotate()
    local _, hum = GetMoonwalkParts()
    if hum then
        pcall(function() hum.AutoRotate = (moonwalkSavedAutoRotate == nil) and true or moonwalkSavedAutoRotate end)
    end
    moonwalkSavedAutoRotate = nil
    RestoreMoonwalkConstraints()
end

local function ComputeDesiredMoveFlat(hum, hrp)
    local moveDir = Vector3.new(0, 0, 0)
    pcall(function() moveDir = hum.MoveDirection end)
    local flat = Vector3.new(moveDir.X, 0, moveDir.Z)
    if flat.Magnitude > 0.05 then
        return flat.Unit, true
    end
    -- Fallback for games with custom movement where Humanoid.MoveDirection stays 0
    if not UserInputService:GetFocusedTextBox() and workspace.CurrentCamera then
        local camCF = workspace.CurrentCamera.CFrame
        local look = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
        local right = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z)
        if look.Magnitude > 0.01 then look = look.Unit end
        if right.Magnitude > 0.01 then right = right.Unit end
        local dir = Vector3.new(0, 0, 0)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up) then dir = dir + look end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down) then dir = dir - look end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then dir = dir + right end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then dir = dir - right end
        if dir.Magnitude > 0.05 then
            return dir.Unit, true
        end
    end
    -- Velocity fallback
    local vel = Vector3.new(0, 0, 0)
    pcall(function() vel = hrp.AssemblyLinearVelocity end)
    local vFlat = Vector3.new(vel.X, 0, vel.Z)
    if vFlat.Magnitude > 1.5 then
        return vFlat.Unit, true
    end
    return nil, false
end

local function IsPlayerInLobbyOrSpectator()
    local inLobby = false
    pcall(function()
        local team = LocalPlayer.Team
        if team then
            local tn = string.lower(team.Name)
            if string.find(tn, "lobby") or string.find(tn, "menu") or string.find(tn, "spectat") or string.find(tn, "wait") then
                inLobby = true
            end
        end
        if LocalPlayer:GetAttribute("InLobby") == true or LocalPlayer:GetAttribute("Spectating") == true or LocalPlayer:GetAttribute("IsSpectator") == true then
            inLobby = true
        end
    end)
    return inLobby
end

local function IsPlayerVaultingOrInteracting(char, hum)
    -- Check common DBD/survival vault, window, pallet, locker, unhook attributes and animations
    local blocked = false
    pcall(function()
        if char:GetAttribute("Vaulting") == true or char:GetAttribute("IsVaulting") == true
            or char:GetAttribute("Interacting") == true or char:GetAttribute("Action") ~= nil
            or char:GetAttribute("Stunned") == true or char:GetAttribute("Carried") == true
            or char:GetAttribute("Hooked") == true or char:GetAttribute("Downed") == true
            or char:GetAttribute("Crawling") == true then
            blocked = true
            return
        end
        if hum:GetAttribute("Vaulting") == true or hum:GetAttribute("Interacting") == true then
            blocked = true
            return
        end
        -- Check active animation tracks for vault / window / pallet / climb / interact
        local animator = hum:FindFirstChildOfClass("Animator")
        if animator then
            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                local anim = track.Animation
                local aname = string.lower((anim and anim.Name or "") .. " " .. (track.Name or ""))
                if string.find(aname, "vault") or string.find(aname, "pallet") or string.find(aname, "window")
                    or string.find(aname, "climb") or string.find(aname, "jumpover") or string.find(aname, "hop")
                    or string.find(aname, "interact") or string.find(aname, "repair") or string.find(aname, "heal")
                    or string.find(aname, "pickup") or string.find(aname, "drop") or string.find(aname, "hook") then
                    blocked = true
                    return
                end
            end
        end
    end)
    return blocked
end

local function MoonwalkStep()
    if not Settings.Moonwalk then return end

    -- 1. Must NOT work in lobby or as spectator
    if IsPlayerInLobbyOrSpectator() then
        RestoreAutoRotate()
        return
    end

    local char, hum, hrp = GetMoonwalkParts()
    if not char or not hum or not hrp or not hrp.Parent then return end

    -- 2. Must NOT work when dead
    local alive = true
    pcall(function() alive = hum.Health > 0 and hum:GetState() ~= Enum.HumanoidStateType.Dead end)
    if not alive then
        RestoreAutoRotate()
        return
    end

    local anchored = false
    pcall(function() anchored = hrp.Anchored end)
    if anchored then
        RestoreAutoRotate()
        return
    end

    -- 3. Must NOT work when seated
    local seated = false
    pcall(function()
        local st = hum:GetState()
        seated = (st == Enum.HumanoidStateType.Seated) or (hum.SeatPart ~= nil)
    end)
    if seated then
        RestoreAutoRotate()
        return
    end

    -- 4. Must NOT cancel vaults, pallet jumps, window hops, or interactions
    local humState = Enum.HumanoidStateType.Running
    pcall(function() humState = hum:GetState() end)
    if humState == Enum.HumanoidStateType.Jumping
        or humState == Enum.HumanoidStateType.Freefall
        or humState == Enum.HumanoidStateType.Climbing
        or humState == Enum.HumanoidStateType.Swimming
        or humState == Enum.HumanoidStateType.PlatformStanding
        or humState == Enum.HumanoidStateType.Ragdoll then
        -- During jump / vault / climb keep character native orientation so game action succeeds
        local saved = moonwalkSavedAutoRotate
        pcall(function()
            if hum.AutoRotate ~= saved then hum.AutoRotate = saved end
        end)
        RestoreMoonwalkConstraints()
        return
    end

    if IsPlayerVaultingOrInteracting(char, hum) then
        local saved = moonwalkSavedAutoRotate
        pcall(function()
            if hum.AutoRotate ~= saved then hum.AutoRotate = saved end
        end)
        RestoreMoonwalkConstraints()
        return
    end

    if moonwalkSavedAutoRotate == nil then
        pcall(function() moonwalkSavedAutoRotate = hum.AutoRotate end)
        if moonwalkSavedAutoRotate == nil then moonwalkSavedAutoRotate = true end
    end

    local moveFlat, isMoving = ComputeDesiredMoveFlat(hum, hrp)

    if not isMoving and not Settings.MoonwalkAlways then
        local saved = moonwalkSavedAutoRotate
        pcall(function()
            if hum.AutoRotate ~= saved then hum.AutoRotate = saved end
        end)
        RestoreMoonwalkConstraints()
        return
    end

    pcall(function()
        if hum.AutoRotate ~= false then hum.AutoRotate = false end
    end)

    local facing = nil
    if isMoving and moveFlat then
        facing = -moveFlat -- 180 deg backward to movement direction
    elseif workspace.CurrentCamera then
        local camLook = workspace.CurrentCamera.CFrame.LookVector
        local cFlat = Vector3.new(camLook.X, 0, camLook.Z)
        if cFlat.Magnitude > 0.01 then facing = -cFlat.Unit end
    end
    if not facing then return end

    -- A/D balancing shake (simulates rapid A/D strafe balancing while moonwalking)
    local t = os.clock() * math.max(1, Settings.MoonwalkSpeed)
    local amp = math.rad(Settings.MoonwalkAngle)
    local shake = math.sin(t) * amp + math.sin(t * 2.37) * amp * 0.35

    -- ONLY rotate yaw: NEVER overwrite position (prevents cancelling pallet/window jump physics)
    local currentCF = hrp.CFrame
    local goalLook = nil
    pcall(function()
        goalLook = CFrame.lookAt(Vector3.new(0, 0, 0), facing) * CFrame.Angles(0, shake, 0)
    end)
    if goalLook then
        local goalRotOnly = CFrame.new(currentCF.Position) * goalLook.Rotation
        SuppressCharacterOrientConstraints(char, goalRotOnly)
        pcall(function() hrp.CFrame = goalRotOnly end)
    end
end

local function StartMoonwalk()
    if moonwalkBound then return end
    pcall(function()
        RunService:BindToRenderStep("EssentialMoonwalk", 2147483641, function()
            MoonwalkStep()
            task.defer(MoonwalkStep)
        end)
    end)
    if moonwalkHeartbeatConn then pcall(function() moonwalkHeartbeatConn:Disconnect() end) end
    moonwalkHeartbeatConn = RunService.Heartbeat:Connect(MoonwalkStep)
    if moonwalkSteppedConn then pcall(function() moonwalkSteppedConn:Disconnect() end) end
    moonwalkSteppedConn = RunService.Stepped:Connect(MoonwalkStep)
    pcall(function()
        if RunService.PreRender then
            if moonwalkPreRenderConn then pcall(function() moonwalkPreRenderConn:Disconnect() end) end
            moonwalkPreRenderConn = RunService.PreRender:Connect(MoonwalkStep)
        end
    end)
    moonwalkBound = true
end

local function StopMoonwalk()
    pcall(function() RunService:UnbindFromRenderStep("EssentialMoonwalk") end)
    if moonwalkHeartbeatConn then pcall(function() moonwalkHeartbeatConn:Disconnect() end) moonwalkHeartbeatConn = nil end
    if moonwalkSteppedConn then pcall(function() moonwalkSteppedConn:Disconnect() end) moonwalkSteppedConn = nil end
    if moonwalkPreRenderConn then pcall(function() moonwalkPreRenderConn:Disconnect() end) moonwalkPreRenderConn = nil end
    moonwalkBound = false
    RestoreAutoRotate()
end

