local function ApplyTheme()
    local base = Color3.fromRGB(Settings.AccentR, Settings.AccentG, Settings.AccentB)
    local h, s, v = Color3.toHSV(base)
    local gradEnd = Color3.fromHSV(h, s, math.clamp(v - 0.2, 0, 1))
    local strokeMain = Color3.fromHSV(h, s, math.clamp(v - 0.25, 0, 1))
    local strokeDark = Color3.fromHSV(h, s, math.clamp(v - 0.6, 0.1, 1))
    local gradSeq = ColorSequence.new({
        ColorSequenceKeypoint.new(0, base),
        ColorSequenceKeypoint.new(1, gradEnd)
    })
    local function paint(list, color, isGrad)
        for i = #list, 1, -1 do
            local obj = list[i]
            if obj and obj.Parent then
                if isGrad then obj.Color = color
                elseif obj:IsA("UIStroke") then obj.Color = color
                elseif obj:IsA("TextLabel") or obj:IsA("TextBox") or obj:IsA("TextButton") then obj.TextColor3 = color
                elseif obj:IsA("Frame") or obj:IsA("ScrollingFrame") then obj.BackgroundColor3 = color end
            else table.remove(list, i) end
        end
    end
    paint(ThemeElements.Gradients, gradSeq, true)
    paint(ThemeElements.Texts, base, false)
    paint(ThemeElements.MainStrokes, strokeMain, false)
    paint(ThemeElements.DarkStrokes, strokeDark, false)
    for i = #ThemeElements.Scrollbars, 1, -1 do
        local obj = ThemeElements.Scrollbars[i]
        if obj and obj.Parent then obj.ScrollBarImageColor3 = strokeMain else table.remove(ThemeElements.Scrollbars, i) end
    end
end

