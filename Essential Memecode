-- FOV LOCK SYSTEM v3 (Metatable __newindex hook + PreRender + task.defer + MaxPriority)
-- ==============================================
local DefaultFOV = 70
pcall(function() if workspace.CurrentCamera then DefaultFOV = workspace.CurrentCamera.FieldOfView end end)
if DefaultFOV <= 1 or DefaultFOV >= 120 then DefaultFOV = 70 end
local _fovApplying = false
local cameraFovConnection = nil
local fovHeartbeatConn = nil
local fovSteppedConn = nil
local fovPreRenderConn = nil

local function ForceFOV()
    if not Settings.FOVEnabled then return end
    local cam = workspace.CurrentCamera
    if not cam then return end
    if math.abs(cam.FieldOfView - Settings.FOV) > 0.005 then
        _fovApplying = true
        pcall(function() cam.FieldOfView = Settings.FOV end)
        _fovApplying = false
    end
end

local function HookCameraFOV(cam)
    if cameraFovConnection then pcall(function() cameraFovConnection:Disconnect() end) cameraFovConnection = nil end
    if not cam then return end
    cameraFovConnection = cam:GetPropertyChangedSignal("FieldOfView"):Connect(function()
        if _fovApplying or not Settings.FOVEnabled then return end
        if math.abs(cam.FieldOfView - Settings.FOV) > 0.005 then
            _fovApplying = true
            pcall(function() cam.FieldOfView = Settings.FOV end)
            _fovApplying = false
        end
    end)
end

-- Optional metatable __newindex interceptor (blocks flashlight/item TweenService writes at the source)
pcall(function()
    if hookmetamethod then
        local oldNewIndex
        oldNewIndex = hookmetamethod(game, "__newindex", function(self, key, val)
            if Settings.FOVEnabled and not _fovApplying and key == "FieldOfView" and self == workspace.CurrentCamera then
                return oldNewIndex(self, key, Settings.FOV)
            end
            return oldNewIndex(self, key, val)
        end)
    elseif getrawmetatable and setreadonly then
        local mt = getrawmetatable(game)
        if mt and mt.__newindex then
            local oldNewIndex = mt.__newindex
            setreadonly(mt, false)
            mt.__newindex = function(self, key, val)
                if Settings.FOVEnabled and not _fovApplying and key == "FieldOfView" and self == workspace.CurrentCamera then
                    return oldNewIndex(self, key, Settings.FOV)
                end
                return oldNewIndex(self, key, val)
            end
            setreadonly(mt, true)
        end
    end
end)

HookCameraFOV(workspace.CurrentCamera)
table.insert(connections, workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    HookCameraFOV(workspace.CurrentCamera)
    ForceFOV()
end))

