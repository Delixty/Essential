local function UnloadScript()
    for _, conn in ipairs(connections) do if conn then pcall(function() conn:Disconnect() end) end end
    if noclipConnection then noclipConnection:Disconnect() noclipConnection = nil end
    if cameraFovConnection then pcall(function() cameraFovConnection:Disconnect() end) cameraFovConnection = nil end
    pcall(function() RunService:UnbindFromRenderStep("EssentialFOVLock") end)
    pcall(function() RunService:UnbindFromRenderStep("EssentialMoonwalk") end)
    if moonwalkHeartbeatConn then pcall(function() moonwalkHeartbeatConn:Disconnect() end) moonwalkHeartbeatConn = nil end
    moonwalkBound = false
    pcall(RestoreAutoRotate)
    RestoreNoclipCollisions() ResetSkybox() TerminateEssentialHUD() RestoreLowGraphics()
    Lighting.FogStart = DefaultLighting.FogStart Lighting.FogEnd = DefaultLighting.FogEnd
    if not Settings.SkyEnabled then Lighting.FogColor = DefaultLighting.FogColor end
    for _, p in pairs(Players:GetPlayers()) do
        if p.Character then
            if p.Character:FindFirstChild("EssentialESP") then p.Character.EssentialESP:Destroy() end
            if p.Character:FindFirstChild("EssentialNameTag") then p.Character.EssentialNameTag:Destroy() end
        end
    end
    for _, gen in ipairs(trackedGenerators) do
        if gen and gen.Parent then
            if gen:FindFirstChild("EssentialESP") then gen.EssentialESP:Destroy() end
            if gen:FindFirstChild("EssentialGenTag") then gen.EssentialGenTag:Destroy() end
        end
    end
    for _, pallet in ipairs(trackedPallets) do if pallet and pallet.Parent and pallet:FindFirstChild("EssentialESP") then pallet.EssentialESP:Destroy() end end
    for _, hookObj in ipairs(trackedHooks) do if hookObj and hookObj.Parent and hookObj:FindFirstChild("EssentialESP") then hookObj.EssentialESP:Destroy() end end
    for _, gate in ipairs(trackedGates) do if gate and gate.Parent and gate:FindFirstChild("EssentialESP") then gate.EssentialESP:Destroy() end end
    if currentLight then currentLight:Destroy() end
    if workspace.CurrentCamera then workspace.CurrentCamera.FieldOfView = DefaultFOV end
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.WalkSpeed = 16
        LocalPlayer.Character.Humanoid.AutoRotate = true
    end
    if CrosshairCenter then CrosshairCenter:Destroy() end
    ScreenGui:Destroy()
end
