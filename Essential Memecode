    if ShouldBeSearchable(parent) then table.insert(SearchableElements, {frame = frame, text = string.lower(text)}) end

    local listening = false
    local function setKey(keyName)
        keyName = tostring(keyName or "None")
        keyBtn.Text = keyName
        callback(keyName)
    end
    keyBtn.MouseButton1Click:Connect(function()
        if listening then return end
        listening = true
        KeybindListening = true
        keyBtn.Text = "Press any key..."
    end)
    table.insert(connections, UserInputService.InputBegan:Connect(function(input, gp)
        if not listening then return end
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        local kc = input.KeyCode
        listening = false
        task.defer(function() KeybindListening = false end)
        if kc == Enum.KeyCode.Escape then
            setKey(Settings.MenuKeybind)
        elseif kc == Enum.KeyCode.Backspace or kc == Enum.KeyCode.Delete then
            setKey("None")
        elseif kc ~= Enum.KeyCode.Unknown then
            setKey(kc.Name)
        else
            setKey(Settings.MenuKeybind)
        end
    end))
    return setKey
end

